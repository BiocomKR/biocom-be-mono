# AWS 계정 정보
AWS_ACCOUNT_ID=183631338083              # AWS 계정 ID
AWS_REGION=ap-northeast-2                 # AWS 리전 (서울)

# 클러스터 정보
CLUSTER_NAME=biocom-cluster               # EKS 클러스터 이름
CLUSTER_VERSION=1.31                      # Kubernetes 버전

# ECR 리포지토리
ECR_REPOSITORY=backend-v2                 # Docker 이미지 저장소 이름

# 애플리케이션 정보
APP_NAME=backend-api                      # 애플리케이션 이름
APP_VERSION=1.0.0                         # 애플리케이션 버전
IMAGE_TAG=latest                          # Docker 이미지 태그 (배포시 타임스탬프로 변경됨)
HELM_RELEASE_NAME=temp-backend            # Helm 릴리즈 이름

# 네트워킹 (현재 미사용 - eksctl이 자동 생성)
VPC_CIDR=10.0.0.0/16                     # VPC CIDR 블록
PUBLIC_SUBNET_1_CIDR=10.0.1.0/24         # 퍼블릭 서브넷 1 (AZ-a)
PUBLIC_SUBNET_2_CIDR=10.0.2.0/24         # 퍼블릭 서브넷 2 (AZ-c)
PRIVATE_SUBNET_1_CIDR=10.0.3.0/24        # 프라이빗 서브넷 1 (AZ-a)
PRIVATE_SUBNET_2_CIDR=10.0.4.0/24        # 프라이빗 서브넷 2 (AZ-c)

# 노드 그룹 설정
NODE_GROUP_NAME=backend-nodes             # EKS 노드 그룹 이름
NODE_INSTANCE_TYPE=t3.medium              # EC2 인스턴스 타입 (2 vCPU, 4 GiB RAM)
NODE_MIN_SIZE=2                           # 최소 노드 수
NODE_MAX_SIZE=10                          # 최대 노드 수 (오토스케일링 한계)
NODE_DESIRED_SIZE=2                       # 초기 노드 수

