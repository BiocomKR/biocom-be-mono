# Docker에서 제외할 파일 및 디렉토리

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 환경 파일
.env
.env.local
.env.development
.env.test
.env.production
.env.docker*

# 로그 파일
logs
*.log
/var/log

# 업로드 파일
uploads/
/var/app/uploads

# 백업 파일
backups/
*.sql
*.gz

# 개발 도구
.vscode/
.idea/
*.swp
*.swo

# OS 생성 파일
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Docker 관련
Dockerfile*
docker-compose*.yml
.dockerignore

# 테스트 관련
coverage/
.nyc_output
test-results/

# 빌드 산출물 (개발용 Dockerfile에서는 포함)
dist/
build/

# 기타
README.md
docs/
*.md