# 🔐 GKE 배포용 민감정보
# 이 파일은 절대 Git에 커밋하지 마세요!
# .gitignore에 등록되어 있습니다.
# 이 파일을 .env.secrets로 복사 후 실제 값을 입력하세요.

# 데이터베이스 (biocom-api와 동일한 값 사용)
DB_PASSWORD='your-db-password'

# JWT (biocom-api와 동일한 값 사용)
JWT_SECRET='your-jwt-secret'
JWT_REFRESH_TOKEN_SECRET='your-jwt-refresh-secret'

# 세션
SESSION_SECRET='your-session-secret'

# 암호화
ENCRYPTION_KEY='your-encryption-key'

# OpenAI
OPENAI_API_KEY='sk-xxx'

# Google API
GOOGLE_API_KEY='your-google-api-key'

# Toss Payments
TOSS_PAYMENTS_SECRET_KEY='test_sk_xxx'

# Slack Webhook (에러 알림용)
SLACK_WEBHOOK_URL='https://hooks.slack.com/services/xxx'
