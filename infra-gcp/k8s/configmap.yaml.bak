# ⚙️ ConfigMap - 애플리케이션 설정 관리
# AWS EKS의 ConfigMap과 동일한 기능

apiVersion: v1
kind: ConfigMap
metadata:
  name: biocom-api-config
  namespace: biocom-api
  labels:
    app: biocom-api
    environment: prod
data:
  # 데이터베이스 설정 (민감하지 않은 정보)
  DB_HOST: "34.47.124.132"
  DB_PORT: "5432"
  DB_NAME: "biocom"
  DB_USERNAME: "biocom"
  DATABASE_URL: "postgresql://biocom:bico0825%21%40%23@34.47.124.132:5432/biocom?connection_limit=5&pool_timeout=30&connect_timeout=10"
  
  # 애플리케이션 설정
  NODE_ENV: "development"
  PORT: "10804"
  
  # API 설정
  API_PREFIX: "/api"
  SWAGGER_PATH: "/docs"
  
  # 로깅 설정
  LOG_LEVEL: "info"
  LOG_FORMAT: "json"
  
  # ImWeb API 설정
  IMWEB_API_BASE_URL: "https://api.imweb.me"
  IMWEB_REDIRECT_URI: "https://api-dev.biocom.ai.kr/auth/redirect"
  
  # CORS 설정
  # CORS 설정 - 개발 환경에서는 모든 origin 허용
  # 운영 환경에서는 특정 도메인만 허용하도록 변경 필요
  CORS_ORIGIN: "*"

  # JWT 설정
  JWT_ACCESS_TOKEN_EXPIRES_IN: "3h"  # Access Token 만료 시간: 3시간
  JWT_REFRESH_TOKEN_EXPIRES_IN: "180d"  # Refresh Token 만료 시간: 180일 (약 6개월)

  # 토스페이먼츠 결제 설정
  TOSS_PAYMENTS_CLIENT_KEY: "test_ck_0RnYX2w532qNWYYLpqXP8NeyqApQ"

  # Google Cloud Storage 설정
  GOOGLE_CLOUD_PROJECT_ID: "api-dev-biocom"
  GCS_BUCKET_NAME: "api-dev-biocom-uploads"
  GOOGLE_APPLICATION_CREDENTIALS: "/app/secrets/key.json"

  # Firebase 설정
  FIREBASE_SERVICE_ACCOUNT_PATH: "/app/firebase/firebase-key.json"

  # Slack 알림 설정
  SLACK_NOTIFICATION_ENABLED: "true"
  
  # 파일 업로드 설정 (Google Cloud Storage 사용)
  MAX_FILE_SIZE: "10485760"  # 10MB
  ALLOWED_FILE_TYPES: "image/jpeg,image/png,image/gif,application/pdf"
  
  # Rate Limiting 설정
  RATE_LIMIT_TTL: "60"  # 60초
  RATE_LIMIT_LIMIT: "100"  # 60초에 100개 요청 허용
  
  # 기타 설정
  TIMEZONE: "Asia/Seoul"
  
  # AI 모델 설정
  OPENAI_MODEL: "gpt-4o"
  AI_ANALYSIS_TIMEOUT: "30000"
  GEMINI_MODEL: "gemini-2.5-flash-image-preview"
  FACE_SLIMMING_TIMEOUT: "60000"

  # 플레이오토 물류 API 설정
  PLAYAUTO_BASE_URL: "https://openapi.playauto.io/api"
  PLAYAUTO_SHOP_CD: "UVP2"
  PLAYAUTO_SHOP_ID: "biocom@biocom.kr"

  # NHN KCP 휴대폰 본인인증 설정
  KCP_SITE_CODE: "ALDXX"
  KCP_WEB_SITE_ID: "J25091911744"
  KCP_CERT_INFO: "/config/kcp-cert/KCP_AUTH_ALDXX_CERT.pem"
  KCP_PRIVATE_KEY_PATH: "/config/kcp-cert/KCP_AUTH_ALDXX_PRIKEY.pem"
  KCP_CALLBACK_NUMBER: "0220390295"

  # AI Agent 서버 설정
  AI_AGENT_BASE_URL: "https://ai-agent-dev.biocom.ai.kr"
  
---
# 📝 로깅 설정용 ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: biocom-api-logging
  namespace: biocom-api
  labels:
    app: biocom-api
    component: logging
data:
  # 구조화된 로깅 설정
  logging.json: |
    {
      "level": "info",
      "format": "json",
      "timestamp": true,
      "colorize": false,
      "metadata": true,
      "fields": {
        "service": "biocom-api",
        "environment": "dev",
        "version": "1.0.0"
      }
    }