# 🔐 Secret 예시 파일 - biocom-bo-api
# 실제 사용 시 secret.yaml로 복사 후 값을 채워주세요
# ⚠️ secret.yaml은 절대 git에 커밋하지 마세요!

apiVersion: v1
kind: Secret
metadata:
  name: biocom-bo-api-secrets
  namespace: biocom-bo-api
  labels:
    app: biocom-bo-api
type: Opaque
stringData:
  # JWT 시크릿 키
  JWT_SECRET: "your-jwt-secret-key-here"
  JWT_REFRESH_SECRET: "your-jwt-refresh-secret-key-here"

  # 데이터베이스 비밀번호
  DB_PASSWORD: "your-db-password-here"

  # OpenAI API 키
  OPENAI_API_KEY: "your-openai-api-key-here"

  # Slack Webhook URL (에러 알림)
  SLACK_WEBHOOK_URL: "your-slack-webhook-url-here"

  # Slack Webhook URL (백오피스 피드백 알림)
  SLACK_FEEDBACK_WEBHOOK_URL: "your-slack-feedback-webhook-url-here"

---
# GCS 서비스 계정 키
apiVersion: v1
kind: Secret
metadata:
  name: google-service-account-key
  namespace: biocom-bo-api
type: Opaque
data:
  # base64 인코딩된 서비스 계정 키 JSON
  key.json: |
    # cat key.json | base64 로 생성된 값

---
# Firebase 서비스 계정 키
apiVersion: v1
kind: Secret
metadata:
  name: firebase-service-account-key
  namespace: biocom-bo-api
type: Opaque
data:
  # base64 인코딩된 Firebase 서비스 계정 키 JSON
  firebase-key.json: |
    # cat firebase-key.json | base64 로 생성된 값

---
# Artifact Registry 인증 (Docker Pull용)
apiVersion: v1
kind: Secret
metadata:
  name: gcr-json-key
  namespace: biocom-bo-api
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: |
    # 생성 명령어:
    # kubectl create secret docker-registry gcr-json-key \
    #   --docker-server=asia-northeast3-docker.pkg.dev \
    #   --docker-username=_json_key \
    #   --docker-password="$(cat service-account-key.json)" \
    #   -n biocom-bo-api --dry-run=client -o yaml
