generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 사용자 테이블
/// 애플리케이션의 모든 사용자 정보를 저장
model User {
  id                           Int                            @id @default(autoincrement())
  email                        String?
  password                     String?
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime?                      @updatedAt @map("updated_at")
  points                       Int                            @default(0)
  mobile                       String
  name                         String
  isActive                     Boolean                        @default(true) @map("is_active")
  deletedAt                    DateTime?                      @map("deleted_at")
  aiPersonaId                  Int?                           @map("ai_persona_id")
  status                       String                         @default("NEWCOMER") @map("status") @db.VarChar(20)
  role                         String?                        @default("USER") @db.VarChar(20)
  billingKey                   String?                        @map("billing_key") @db.VarChar(200)
  customerKey                  String?                        @map("customer_key") @db.VarChar(200)
  birthDate                    String?                        @map("birth_date") @db.VarChar(8)
  telecom                      String?                        @db.VarChar(3)
  sex                          String?                        @db.VarChar(2)
  localCode                    String?                        @map("local_code") @db.VarChar(2)
  health_type_animal_id        Int?
  cart                         Cart?
  challengeTickets             ChallengeTicket[]
  orders                       Order[]
  pointHistories               PointHistory[]
  productFeedback              ProductFeedback[]
  pushNotificationLogs         PushNotificationLog[]
  pushTokens                   PushToken[]
  quizAttempts                 QuizAttempt[]
  recentlyViewed               RecentlyViewed[]
  refreshTokens                RefreshToken[]
  refundWarranties             RefundWarranty[]
  surveyAnswers                SurveyAnswer[]
  balanceGameHistories         UserBalanceGameHistory[]
  challengeSurveyResults       UserChallengeSurveyResult[]
  userChallenges               UserChallenge[]
  userCoupons                  UserCoupon[]
  userFiles                    UserFile[]
  userMissions                 UserMission[]
  userRecords                  UserRecord[]
  userSupplementRoutine        UserSupplementRoutine[]        @relation("UserSupplementRoutineUser")
  userSupplementRoutineHistory UserSupplementRoutineHistory[] @relation("UserSupplementRoutineHistoryUser")
  aiPersona                    AiPersona?                     @relation(fields: [aiPersonaId], references: [id], map: "users_character_id_fkey")
  healthTypeAnimal             HealthTypeAnimal?              @relation(fields: [health_type_animal_id], references: [id])
  wishlist                     Wishlist[]

  @@map("users")
}

/// Refresh Token 테이블
/// 사용자 인증 토큰 갱신을 위한 장기 토큰 저장
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// 파일 업로드 테이블
/// 파일 마스터 테이블
/// 모든 파일 정보를 중앙에서 관리
model File {
  id           Int           @id @default(autoincrement())
  originalName String        @map("original_name") @db.VarChar(255)
  storedName   String        @unique(map: "uq_files_stored_name") @map("stored_name") @db.VarChar(255)
  filePath     String        @map("file_path")
  fileSize     Int           @map("file_size")
  mimeType     String        @map("mime_type") @db.VarChar(100)
  storageType  String        @default("local") @map("storage_type") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")
  contentFiles ContentFile[]
  userFiles    UserFile[]

  @@index([createdAt], map: "idx_files_created_at")
  @@index([isActive], map: "idx_files_is_active")
  @@index([mimeType], map: "idx_files_mime_type")
  @@map("files")
}

/// 사용자 파일 관계 테이블
model UserFile {
  id             Int           @id(map: "file_uploads_pkey") @default(autoincrement())
  userId         Int           @map("user_id")
  uploadedAt     DateTime      @default(now()) @map("uploaded_at")
  fileType       String        @map("file_type")
  uploadCategory String        @map("upload_category")
  fileId         Int           @map("file_id")
  user           User          @relation(fields: [userId], references: [id], map: "file_uploads_user_id_fkey")
  file           File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userMissions   UserMission[]

  @@index([fileId], map: "idx_user_files_file_id")
  @@map("user_files")
}

model Content {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(255)
  content         String
  type            String?          @db.VarChar(50)
  weekNumber      Int?             @map("week_number")
  dayNumber       Int?             @map("day_number")
  sortOrder       Int              @default(0) @map("sort_order")
  points          Int              @default(300)
  viewCount       Int              @default(0) @map("view_count")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  challengeId     Int?             @map("challenge_id")
  challenge       Product?         @relation("ChallengeContents", fields: [challengeId], references: [id])
  contentFiles    ContentFile[]
  lectureProducts LectureProduct[]
  lectureQuizzes  LectureQuiz[]
  quizAttempts    QuizAttempt[]

  @@index([type, isActive])
  @@index([weekNumber, dayNumber])
  @@index([sortOrder])
  @@index([challengeId], map: "idx_contents_challenge_id")
  @@map("contents")
}

/// 컨텐츠 첨부파일 관계 테이블
model ContentFile {
  id        Int      @id @default(autoincrement())
  contentId Int      @map("content_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @map("created_at")
  fileId    Int      @map("file_id")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([fileId], map: "idx_content_files_file_id")
  @@map("content_files")
}

/// 아임웹 사이트 정보 테이블
/// 아임웹 API 연동을 위한 인증 정보 저장
model ImwebInfo {
  /// 고유 식별자
  id           Int       @id @default(autoincrement())
  /// 아임웹 사이트 이름 (관리용)
  name         String    @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 ID
  clientId     String    @map("client_id") @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 Secret
  clientSecret String    @map("client_secret") @db.VarChar(255)
  /// 아임웹 사이트 코드 (고유값, API 호출 시 사용)
  siteCode     String    @unique @map("site_code") @db.VarChar(255)
  /// OAuth 인가 코드 수신용 콜백 URI
  redirectUri  String    @map("redirect_uri") @db.VarChar(500)
  /// API 사용 권한 범위 (예: member-info:read site-info:write)
  scope        String    @db.VarChar(500)
  /// 아임웹 API 액세스 토큰 (2시간 유효)
  accessToken  String?   @map("access_token")
  /// 아임웹 API 리프레시 토큰 (90일 유효)
  refreshToken String?   @map("refresh_token")
  /// 생성 일시
  createdAt    DateTime  @map("created_at")
  /// 수정 일시 (최초 생성 시 null)
  updatedAt    DateTime? @map("updated_at")

  @@map("imweb_info")
}

/// 설문 마스터 테이블
/// 설문 세트를 관리 (예: "기본 건강 설문", "다이어트 설문" 등)
model Survey {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  description      String?
  /// 설문 타입 ('before': 사전설문, 'after': 사후설문)
  type             String            @default("before") @db.VarChar(20)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @map("created_at")
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  challengeSurveys ChallengeSurvey[]
  surveyQuestions  SurveyQuestion[]

  @@index([type, isActive])
  @@map("surveys")
}

/// 설문지 질문 테이블
/// 설문 조사에 사용되는 모든 질문들을 저장
model SurveyQuestion {
  id            Int            @id @default(autoincrement())
  category      String
  questionText  String         @map("question_text")
  sortOrder     Int            @map("sort_order")
  createdAt     DateTime       @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  categoryCode  String         @map("category_code")
  surveyId      Int?           @map("survey_id")
  isActive      Boolean        @default(true) @map("is_active")
  surveyAnswers SurveyAnswer[]
  survey        Survey?        @relation(fields: [surveyId], references: [id])

  @@index([surveyId])
  @@index([isActive], map: "idx_survey_questions_is_active")
  @@map("survey_questions")
}

/// 옵션 마스터 테이블
/// 설문 응답에 사용되는 공통 옵션들
model SurveyOption {
  id            Int            @id @default(autoincrement())
  optionText    String         @map("option_text")
  score         Int
  createdAt     DateTime       @map("created_at")
  isActive      Boolean        @default(true) @map("is_active")
  surveyAnswers SurveyAnswer[]

  @@index([isActive], map: "idx_survey_options_is_active")
  @@map("survey_options")
}

/// 사용자 설문 참여 테이블
/// 사용자가 설문에 참여한 실제 답변 데이터를 저장
model SurveyAnswer {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  surveyOptionId   Int            @map("survey_option_id")
  surveyQuestionId Int            @map("survey_question_id")
  type             String
  createdAt        DateTime       @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")
  userChallengeId  Int?           @map("user_challenge_id")
  surveyOption     SurveyOption   @relation(fields: [surveyOptionId], references: [id])
  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id], onDelete: Cascade)
  userChallenge    UserChallenge? @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyQuestionId, type])
  @@unique([userChallengeId, surveyQuestionId, type])
  @@index([userId])
  @@index([userChallengeId])
  @@index([createdAt])
  @@map("survey_answers")
}

/// 건강 유형별 동물 캐릭터 테이블
/// 설문 결과에 따른 건강 유형별 동물 캐릭터 정보를 저장
model HealthTypeAnimal {
  id                        Int                         @id @default(autoincrement())
  healthType                String                      @unique(map: "category_details_category_code_key") @map("health_type") @db.VarChar(50)
  typeName                  String                      @map("type_name") @db.VarChar(50)
  animalName                String                      @map("animal_name") @db.VarChar(50)
  catchphrase               String
  symptoms                  String
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime?                   @updatedAt @map("updated_at")
  users                     User[]
  recommendedProducts       HealthTypeAnimalProduct[]

  @@map("health_type_animals")
}

/// 포인트 내역 테이블
/// 사용자의 포인트 적립/사용 내역 관리
model PointHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String
  amount      Int
  balance     Int
  description String
  relatedType String?  @map("related_type")
  relatedId   Int?     @map("related_id")
  createdAt   DateTime @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("point_histories")
}

/// 미션 정의 테이블
/// 챌린지에서 수행할 모든 미션 타입 정의
model Mission {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  points            Int
  requireUpload     Boolean            @default(false) @map("require_upload")
  sortOrder         Int                @map("sort_order")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @map("created_at")
  updatedAt         DateTime?          @updatedAt @map("updated_at")
  category          String             @default("DAILY")
  type              String             @default("MISSION") @db.VarChar(20)
  recordType        String             @unique @map("record_type") @db.VarChar(50)
  dailyLimit        Int                @default(1) @map("daily_limit")
  specificDay       Int?               @map("specific_day")
  totalDays         Int                @default(21) @map("total_days")
  uploadType        String?            @map("upload_type")
  challengeMissions ChallengeMission[]
  dailyMissions     DailyMission[]
  missionQuizzes    MissionQuiz[]

  @@index([category, isActive])
  @@index([sortOrder])
  @@index([type, isActive])
  @@map("missions")
}

/// 데일리 미션 마스터 테이블
/// 일차별 미션 내용을 관리 (Mission과 연결)
model DailyMission {
  id          Int       @id @default(autoincrement())
  day         Int
  title       String
  description String?
  verifyType  String    @map("verify_type") @db.VarChar(20)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  points      Int       @default(100)
  reason      String?
  method      String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  missionId   Int       @map("mission_id")
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, day])
  @@index([missionId])
  @@index([day])
  @@index([isActive])
  @@map("daily_missions")
}

/// 챌린지-미션 연결 테이블
/// 각 상품(챌린지 이용권)에서 사용할 미션과 일차별 매핑
model ChallengeMission {
  id           Int           @id @default(autoincrement())
  productId    Int           @map("product_id")
  missionId    Int           @map("mission_id")
  day          Int
  points       Int           @default(100)
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")
  mission      Mission       @relation(fields: [missionId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  userMissions UserMission[]

  @@unique([productId, missionId, day])
  @@index([productId, day])
  @@index([missionId])
  @@map("challenge_missions")
}

/// 챌린지-설문 연결 테이블
/// 각 상품(챌린지 이용권)에서 사용할 설문을 일차별로 관리
model ChallengeSurvey {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  surveyId  Int       @map("survey_id")
  day       Int
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  product   Product   @relation(fields: [productId], references: [id])
  survey    Survey    @relation(fields: [surveyId], references: [id])

  @@unique([productId, surveyId, day])
  @@index([productId, day])
  @@index([surveyId])
  @@map("challenge_surveys")
}

/// 퀴즈 마스터 테이블
/// 순수 퀴즈 데이터만 관리 (종속성 없음)
/// 강의 퀴즈, 미션 퀴즈 모두 MissionQuiz, LectureQuiz 관계 테이블로 매핑
model Quiz {
  id             Int           @id @default(autoincrement())
  question       String
  options        Json
  correctAnswer  Int           @map("correct_answer")
  points         Int?          @default(300)
  isActive       Boolean?      @default(true) @map("is_active")
  createdAt      DateTime?     @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamp(6)
  explanation    String?
  lectureQuizzes LectureQuiz[]
  missionQuizzes MissionQuiz[]
  attempts       QuizAttempt[]

  @@map("quizzes")
}

/// 퀴즈 시도 기록 테이블
/// 사용자의 퀴즈 답변 기록 (강의 퀴즈용)
/// - 여러 번 시도 가능 (오답 재도전)
/// - 포인트는 최초 1회만 지급
model QuizAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  quizId         Int      @map("quiz_id")
  contentId      Int?     @map("content_id")
  selectedAnswer Int      @map("selected_answer")
  isCorrect      Boolean  @map("is_correct")
  pointsEarned   Int      @map("points_earned")
  createdAt      DateTime @map("created_at")
  content        Content? @relation(fields: [contentId], references: [id])
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId], map: "idx_quiz_attempts_content_id")
  @@index([quizId], map: "idx_quiz_attempts_quiz_id")
  @@index([userId], map: "idx_quiz_attempts_user_id")
  @@map("quiz_attempts")
}

/// 미션-퀴즈 연결 테이블
/// 미션과 퀴즈를 일차별로 연결
/// 올바른 관계: 챌린지 → ChallengeMission → Mission → MissionQuiz → Quiz
model MissionQuiz {
  id        Int       @id @default(autoincrement())
  missionId Int       @map("mission_id")
  quizId    Int       @map("quiz_id")
  day       Int
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  mission   Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([missionId, quizId, day], map: "uq_mission_quizzes_mission_quiz_day")
  @@index([missionId, day], map: "idx_mission_quizzes_mission_day")
  @@index([missionId], map: "idx_mission_quizzes_mission_id")
  @@index([quizId], map: "idx_mission_quizzes_quiz_id")
  @@map("mission_quizzes")
}

/// 챌린지 구매권 테이블
/// 주문을 통해 획득한 챌린지 수행권 (상품 기반)
model ChallengeTicket {
  id             Int             @id @default(autoincrement())
  userId         Int             @map("user_id")
  productId      Int?            @map("product_id")
  orderItemId    Int?            @map("order_item_id")
  purchaseDate   DateTime        @map("purchase_date")
  status         String          @default("PURCHASED") @db.VarChar(20)
  createdAt      DateTime        @map("created_at")
  updatedAt      DateTime?       @updatedAt @map("updated_at")
  ticketType     String          @default("CHALLENGE") @map("ticket_type") @db.VarChar(20)
  startDate      DateTime?       @map("start_date")
  endDate        DateTime?       @map("end_date")
  orderItem      OrderItem?      @relation(fields: [orderItemId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  userChallenges UserChallenge[]

  @@index([userId, status, ticketType])
  @@map("challenge_tickets")
}

/// 사용자별 활성 챌린지
/// 활성화된 챌린지 진행 상황 관리 (상품 기반)
model UserChallenge {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  productId           Int             @map("product_id")
  ticketId            Int             @map("ticket_id")
  activatedAt         DateTime        @map("activated_at")
  expiresAt           DateTime        @map("expires_at")
  totalPoints         Int             @default(0) @map("total_points")
  status              String          @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime        @map("created_at")
  updatedAt           DateTime?       @updatedAt @map("updated_at")
  startDate           DateTime?       @map("start_date") @db.Date
  deliveryArrivalDate DateTime?       @map("delivery_arrival_date") @db.Date
  endDate             DateTime?       @map("end_date") @db.Date
  purchasedAt         DateTime        @map("purchased_at")
  deliveryStartDate   DateTime?       @map("delivery_start_date") @db.Date
  dailyProgress       DailyProgress[]
  surveyAnswers       SurveyAnswer[]
  product             Product         @relation(fields: [productId], references: [id])
  ticket              ChallengeTicket @relation(fields: [ticketId], references: [id])
  user                User            @relation(fields: [userId], references: [id])
  userMissions        UserMission[]
  userRecords         UserRecord[]

  @@index([userId, status])
  @@map("user_challenges")
}

/// 일별 진행 상황
/// 사용자 챌린지의 일차별 진행 상황 관리
model DailyProgress {
  id                 Int           @id @default(autoincrement())
  userChallengeId    Int           @map("user_challenge_id")
  day                Int
  date               DateTime      @db.Date
  missionsTotal      Int           @default(0) @map("missions_total")
  missionsCompleted  Int           @default(0) @map("missions_completed")
  surveysTotal       Int           @default(0) @map("surveys_total")
  surveysCompleted   Int           @default(0) @map("surveys_completed")
  quizzesTotal       Int           @default(0) @map("quizzes_total")
  quizzesCorrect     Int           @default(0) @map("quizzes_correct")
  contentsTotal      Int           @default(0) @map("contents_total")
  contentsViewed     Int           @default(0) @map("contents_viewed")
  trackingsTotal     Int           @default(0) @map("trackings_total")
  trackingsCompleted Int           @default(0) @map("trackings_completed")
  pointsEarned       Int           @default(0) @map("points_earned")
  createdAt          DateTime      @map("created_at")
  updatedAt          DateTime?     @updatedAt @map("updated_at")
  userChallenge      UserChallenge @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)

  @@unique([userChallengeId, day])
  @@index([userChallengeId])
  @@map("daily_progress")
}

/// 운동 종목 마스터 테이블
/// 활동 기록에서 사용할 운동 종목들
model ExerciseType {
  id          Int       @id @default(autoincrement())
  /// 운동 종목명
  name        String    @db.VarChar(50)
  /// 운동 종목 코드 (WALKING, RUNNING, WEIGHT_TRAINING 등)
  code        String    @unique @db.VarChar(50)
  /// 칼로리 계수 (10분당 소모 칼로리)
  calorieRate Float?    @map("calorie_rate")
  /// 정렬 순서
  sortOrder   Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime  @map("created_at")
  /// 수정일시
  updatedAt   DateTime? @updatedAt @map("updated_at")
  /// 기준 시간 (분 단위, 기본값: 10분)
  baseMinutes Int       @default(10) @map("base_minutes")

  @@index([sortOrder])
  @@map("exercise_types")
}

/// 사용자 기록 데이터
/// 사용자의 실제 기록 데이터 (수면, 식단, 운동 등)
model UserRecord {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  userChallengeId Int?           @map("user_challenge_id")
  recordType      String         @map("record_type") @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime?      @updatedAt @map("updated_at")
  date            DateTime       @db.Date
  userMissions    UserMission[]
  userChallenge   UserChallenge? @relation(fields: [userChallengeId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@index([userChallengeId])
  @@index([userId, recordType, date])
  @@map("user_records")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

/// 상품 마스터 테이블
/// 판매 상품의 기본 정보 관리
model Product {
  id                           Int                            @id @default(autoincrement())
  /// 재고 관리 코드 (재고 API 연동용)
  sku                          String                         @unique @db.VarChar(100)
  /// 상품명
  name                         String                         @db.VarChar(255)
  /// 상품 설명
  description                  String?
  /// 상품 타입 (SINGLE: 단품, SET: 세트)
  productType                  String                         @default("SINGLE") @map("product_type") @db.VarChar(20)
  /// 세트 구성 정보 [{"sku": "P001", "name": "상품1", "qty": 2}]
  setItems                     Json?                          @map("set_items")
  /// 상품 상세 정보 (성분, 사용법, 주의사항 등)
  productInfo                  Json?                          @map("product_info")
  /// 상태 (ACTIVE: 활성, INACTIVE: 비활성, SOLD_OUT: 품절)
  status                       String                         @default("ACTIVE") @db.VarChar(20)
  /// 추천 상품 여부
  isFeatured                   Boolean                        @default(false) @map("is_featured")
  /// 조회수
  viewCount                    Int                            @default(0) @map("view_count")
  /// 생성일시
  createdAt                    DateTime                       @map("created_at")
  /// 수정일시
  updatedAt                    DateTime?                      @updatedAt @map("updated_at")
  /// 카테고리 코드 (SUPPLEMENT, HEALTH_FOOD 등)
  categoryCode                 String                         @map("category_code") @db.VarChar(50)
  /// 카테고리명 (영양제, 건강 보조 식품 등)
  categoryName                 String                         @map("category_name") @db.VarChar(100)
  /// 할인율 (%)
  discountRate                 Int?                           @default(0) @map("discount_rate")
  /// 무료배송 기준 금액
  freeShippingAmount           Decimal?                       @map("free_shipping_amount") @db.Decimal(10, 0)
  /// 1인당 최대 주문 수량
  maxOrderQty                  Int                            @default(10) @map("max_order_qty")
  /// 정가 (할인 전 가격)
  originalPrice                Decimal?                       @map("original_price") @db.Decimal(10, 0)
  /// 적립 포인트율 (%)
  pointRate                    Int                            @default(1) @map("point_rate")
  /// 기본 판매 가격 (옵션 없는 경우)
  price                        Decimal?                       @db.Decimal(10, 0)
  /// 배송비
  shippingFee                  Decimal                        @default(3000) @map("shipping_fee") @db.Decimal(10, 0)
  /// 배송비 정책 (FREE: 무료, PAID: 유료, CONDITIONAL: 조건부)
  shippingPolicy               String                         @default("CONDITIONAL") @map("shipping_policy") @db.VarChar(20)
  /// 상품 무게 (배송비 계산용, g)
  weight                       Int?                           @default(0)
  /// 상품 태그 (검색용, 쉼표 구분)
  tags                         String?
  /// 챌린지 메타데이터 (challengeType, totalDays, description 등)
  metadata                     Json?
  cartItems                    CartItem[]
  challengeContents            Content[]                      @relation("ChallengeContents")
  challengeMissions            ChallengeMission[]
  challengeSurveys             ChallengeSurvey[]
  challengeTickets             ChallengeTicket[]
  coupons                      Coupon[]
  lectureProducts              LectureProduct[]
  orderItems                   OrderItem[]
  feedback                     ProductFeedback[]
  images                       ProductImage[]
  recentlyViewed               RecentlyViewed[]
  supplementNutrients          SupplementNutrient[]
  userChallengeSurveyResults   UserChallengeSurveyResult[]
  userChallenges               UserChallenge[]
  userSupplementRoutine        UserSupplementRoutine[]        @relation("UserSupplementRoutineProduct")
  userSupplementRoutineHistory UserSupplementRoutineHistory[] @relation("UserSupplementRoutineHistoryProduct")
  wishlistItems                Wishlist[]
  healthTypeAnimalProducts     HealthTypeAnimalProduct[]

  @@index([sku])
  @@index([categoryCode, status])
  @@map("products")
}

/// 상품 이미지 테이블
/// 상품 이미지 관리
model ProductImage {
  id        Int      @id @default(autoincrement())
  /// 상품 ID
  productId Int      @map("product_id")
  /// 이미지 전체 URL
  imageUrl  String   @map("image_url") @db.VarChar(500)
  /// 이미지 타입 (MAIN: 대표, SUB: 추가, DETAIL: 상세)
  imageType String   @default("SUB") @map("image_type") @db.VarChar(20)
  /// 정렬 순서
  sortOrder Int      @default(0) @map("sort_order")
  /// 대체 텍스트
  altText   String?  @map("alt_text") @db.VarChar(200)
  /// 생성일시
  createdAt DateTime @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// 장바구니 테이블
/// 사용자별 장바구니 관리
model Cart {
  id        Int        @id @default(autoincrement())
  /// 사용자 ID
  userId    Int        @unique @map("user_id")
  /// 생성일시
  createdAt DateTime   @map("created_at")
  /// 수정일시
  updatedAt DateTime?  @updatedAt @map("updated_at")
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

/// 장바구니 아이템 테이블
/// 장바구니에 담긴 상품 정보
model CartItem {
  id             Int       @id @default(autoincrement())
  /// 장바구니 ID
  cartId         Int       @map("cart_id")
  /// 상품 ID
  productId      Int       @map("product_id")
  /// 수량
  quantity       Int       @default(1)
  /// 재고 확인 시각
  stockCheckedAt DateTime? @map("stock_checked_at")
  /// 재고 가용 여부
  stockAvailable Boolean   @default(true) @map("stock_available")
  /// 추가일시
  addedAt        DateTime  @map("added_at")
  /// 수정일시
  updatedAt      DateTime? @updatedAt @map("updated_at")
  cart           Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

/// 주문 테이블
/// 주문 정보 관리
model Order {
  id                Int              @id @default(autoincrement())
  /// 주문번호 (O20250814115621567 형식)
  orderNumber       String           @unique @map("order_number") @db.VarChar(50)
  /// 사용자 ID
  userId            Int              @map("user_id")
  /// 주문 상태
  status            String           @default("PENDING_PAYMENT") @db.VarChar(30)
  /// 재고 처리 상태
  inventoryStatus   String           @default("NOT_PROCESSED") @map("inventory_status") @db.VarChar(30)
  /// 상품 총액
  totalProductPrice Decimal          @map("total_product_price") @db.Decimal(10, 0)
  /// 할인 총액
  totalDiscount     Decimal          @default(0) @map("total_discount") @db.Decimal(10, 0)
  /// 배송비
  shippingFee       Decimal          @default(0) @map("shipping_fee") @db.Decimal(10, 0)
  /// 사용 포인트
  pointUsed         Decimal          @default(0) @map("point_used") @db.Decimal(10, 0)
  /// 최종 결제액
  totalAmount       Decimal          @map("total_amount") @db.Decimal(10, 0)
  /// 수령인명 (암호화)
  recipientName     String           @map("recipient_name") @db.VarChar(255)
  /// 수령인 휴대폰번호 (암호화)
  recipientMobile   String           @map("recipient_mobile") @db.VarChar(255)
  /// 우편번호
  postalCode        String           @map("postal_code") @db.VarChar(10)
  /// 주소 (암호화)
  address           String           @db.VarChar(500)
  /// 상세주소 (암호화)
  addressDetail     String?          @map("address_detail") @db.VarChar(500)
  /// 배송 메시지
  deliveryMessage   String?          @map("delivery_message")
  /// 주문일시
  orderedAt         DateTime         @map("ordered_at")
  /// 결제일시
  paidAt            DateTime?        @map("paid_at")
  /// 발송일시
  shippedAt         DateTime?        @map("shipped_at")
  /// 배송완료일시
  deliveredAt       DateTime?        @map("delivered_at")
  /// 구매확정일시
  completedAt       DateTime?        @map("completed_at")
  /// 취소일시
  cancelledAt       DateTime?        @map("cancelled_at")
  /// 생성일시
  createdAt         DateTime         @map("created_at")
  /// 수정일시
  updatedAt         DateTime?        @updatedAt @map("updated_at")
  exchangeReturns   ExchangeReturn[]
  items             OrderItem[]
  stateLogs         OrderStateLog[]
  user              User             @relation(fields: [userId], references: [id])
  payment           Payment?
  refundWarranty    RefundWarranty?
  refund            Refund?
  shipping          Shipping?
  usedCoupons       UserCoupon[]

  @@index([userId, status])
  @@index([inventoryStatus])
  @@index([orderNumber])
  @@index([orderedAt])
  @@map("orders")
}

/// 주문 상품 테이블
/// 주문한 상품 상세 정보
model OrderItem {
  id               Int               @id @default(autoincrement())
  /// 주문 ID
  orderId          Int               @map("order_id")
  /// 상품 ID
  productId        Int               @map("product_id")
  /// 상품명 (주문 시점 스냅샷)
  productName      String            @map("product_name") @db.VarChar(255)
  /// 상품 단가
  productPrice     Decimal           @map("product_price") @db.Decimal(10, 0)
  /// 수량
  quantity         Int
  /// 소계 (단가 × 수량)
  subtotal         Decimal           @db.Decimal(10, 0)
  /// 생성일시
  createdAt        DateTime          @map("created_at")
  /// 수정일시
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  challengeTickets ChallengeTicket[]
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  feedback         ProductFeedback?

  @@index([orderId])
  @@map("order_items")
}

/// 주문 상태 변경 로그
/// 주문 상태 변경 이력 추적
model OrderStateLog {
  id           Int      @id @default(autoincrement())
  /// 주문 ID
  orderId      Int      @map("order_id")
  /// 이전 상태
  fromStatus   String?  @map("from_status") @db.VarChar(50)
  /// 변경된 상태
  toStatus     String   @map("to_status") @db.VarChar(50)
  /// 변경한 사용자 ID (NULL이면 시스템)
  changedBy    Int?     @map("changed_by")
  /// 변경 사유
  changeReason String?  @map("change_reason")
  /// 생성일시
  createdAt    DateTime @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_state_logs")
}

/// 결제 정보 테이블
/// 주문 결제 정보 관리
model Payment {
  id              Int       @id @default(autoincrement())
  /// 주문 ID
  orderId         Int       @unique @map("order_id")
  /// PG사 (TOSS: 토스페이먼츠)
  pgProvider      String    @default("TOSS") @map("pg_provider") @db.VarChar(20)
  /// PG사 거래번호
  pgTransactionId String?   @unique @map("pg_transaction_id") @db.VarChar(100)
  /// 결제수단
  paymentMethod   String    @map("payment_method") @db.VarChar(30)
  /// 결제 상태
  status          String    @default("READY") @db.VarChar(30)
  /// PG사 결제 금액
  amount          Decimal   @db.Decimal(10, 0)
  /// 포인트 결제 금액
  pointAmount     Decimal   @default(0) @map("point_amount") @db.Decimal(10, 0)
  /// 결제 상세 정보 (암호화 필요)
  paymentDetails  Json?     @map("payment_details")
  /// 요청일시
  requestedAt     DateTime  @map("requested_at")
  /// 결제일시
  paidAt          DateTime? @map("paid_at")
  /// 취소일시
  cancelledAt     DateTime? @map("cancelled_at")
  /// 실패일시
  failedAt        DateTime? @map("failed_at")
  /// 실패 사유
  failReason      String?   @map("fail_reason") @db.VarChar(500)
  /// 생성일시
  createdAt       DateTime  @map("created_at")
  /// 수정일시
  updatedAt       DateTime? @updatedAt @map("updated_at")
  order           Order     @relation(fields: [orderId], references: [id])
  refunds         Refund[]

  @@index([status])
  @@index([pgTransactionId])
  @@map("payments")
}

/// 환불 정보 테이블
/// 주문 취소/반품 환불 관리
model Refund {
  id                   Int       @id @default(autoincrement())
  /// 주문 ID
  orderId              Int       @unique @map("order_id")
  /// 결제 ID
  paymentId            Int       @map("payment_id")
  /// 환불 타입 (CANCEL: 취소, RETURN: 반품)
  refundType           String    @map("refund_type") @db.VarChar(20)
  /// 환불 상태
  status               String    @default("REQUESTED") @db.VarChar(20)
  /// 환불 금액
  refundAmount         Decimal   @map("refund_amount") @db.Decimal(10, 0)
  /// 포인트 환불액
  pointRefund          Decimal   @default(0) @map("point_refund") @db.Decimal(10, 0)
  /// 토스페이먼츠 취소 ID
  tossCancelId         String?   @map("toss_cancel_id") @db.VarChar(100)
  /// 토스페이먼츠 응답
  tossResponse         Json?     @map("toss_response")
  /// 환불 사유
  reason               String    @db.VarChar(200)
  /// 상세 사유
  reasonDetail         String?   @map("reason_detail")
  /// 반품 송장번호
  returnTrackingNumber String?   @map("return_tracking_number") @db.VarChar(100)
  /// 반품 수령일시
  returnReceivedAt     DateTime? @map("return_received_at")
  /// 처리한 관리자 ID
  adminId              Int?      @map("admin_id")
  /// 관리자 메모
  adminMemo            String?   @map("admin_memo")
  /// 요청일시
  requestedAt          DateTime  @map("requested_at")
  /// 완료일시
  completedAt          DateTime? @map("completed_at")
  /// 거절일시
  rejectedAt           DateTime? @map("rejected_at")
  /// 생성일시
  createdAt            DateTime  @map("created_at")
  order                Order     @relation(fields: [orderId], references: [id])
  payment              Payment   @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@index([requestedAt])
  @@map("refunds")
}

/// 환불 정책 테이블
/// 환불 가능 기간 등 정책 관리
model RefundPolicy {
  id               Int      @id @default(autoincrement())
  /// 정책명
  name             String   @db.VarChar(100)
  /// 반품 가능 기간 (일)
  returnPeriodDays Int      @default(7) @map("return_period_days")
  /// 자동 구매확정 기간 (일)
  autoConfirmDays  Int      @default(7) @map("auto_confirm_days")
  /// 활성화 여부
  isActive         Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt        DateTime @map("created_at")

  @@map("refund_policies")
}

/// 상품 피드백 통합 테이블 (리뷰 + 문의)
/// 상품에 대한 고객 피드백을 통합 관리
model ProductFeedback {
  id             Int               @id @default(autoincrement())
  /// 상품 ID
  productId      Int               @map("product_id")
  /// 사용자 ID
  userId         Int               @map("user_id")
  /// 피드백 타입 (REVIEW: 리뷰, QUESTION: 문의)
  feedbackType   String            @map("feedback_type") @db.VarChar(20)
  /// 원글 ID (답글인 경우)
  parentId       Int?              @map("parent_id")
  /// 주문 상품 ID (리뷰인 경우 구매 확인용)
  orderItemId    Int?              @unique @map("order_item_id")
  /// 제목
  title          String?           @db.VarChar(200)
  /// 내용
  content        String
  /// 상태 (ACTIVE, HIDDEN, DELETED)
  status         String            @default("ACTIVE") @db.VarChar(20)
  /// 생성일시
  createdAt      DateTime          @map("created_at")
  /// 수정일시
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  /// 별점 (1~5, 리뷰인 경우만)
  rating         Int?
  /// 리뷰 타입 (TEXT, PHOTO, VIDEO)
  reviewType     String?           @map("review_type") @db.VarChar(20)
  /// 미디어 URL 배열
  mediaUrls      Json?             @map("media_urls")
  /// 베스트 리뷰 여부
  isBest         Boolean           @default(false) @map("is_best")
  /// 베스트 선정일시
  bestSelectedAt DateTime?         @map("best_selected_at")
  /// 도움됨 수
  helpfulCount   Int               @default(0) @map("helpful_count")
  /// 문의 타입 (PRODUCT, DELIVERY, STOCK, SIZE, OTHER)
  questionType   String?           @map("question_type") @db.VarChar(20)
  /// 비밀글 여부
  isSecret       Boolean           @default(false) @map("is_secret")
  /// 답변 여부
  hasAnswer      Boolean           @default(false) @map("has_answer")
  /// 답변한 관리자 ID
  answeredBy     Int?              @map("answered_by")
  /// 답변일시
  answeredAt     DateTime?         @map("answered_at")
  /// 숨김 사유
  hiddenReason   String?           @map("hidden_reason") @db.VarChar(200)
  /// 지급된 적립금 금액
  rewardAmount   Int?              @map("reward_amount")
  /// 적립금 지급 여부
  rewardGiven    Boolean           @default(false) @map("reward_given")
  /// 적립금 지급일시
  rewardedAt     DateTime?         @map("rewarded_at")
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id])
  parent         ProductFeedback?  @relation("FeedbackReply", fields: [parentId], references: [id])
  replies        ProductFeedback[] @relation("FeedbackReply")
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id])

  @@index([productId, feedbackType, status])
  @@index([userId])
  @@index([parentId])
  @@index([feedbackType, rating])
  @@index([feedbackType, hasAnswer])
  @@index([isBest])
  @@index([rewardGiven])
  @@map("product_feedback")
}

/// 찜하기 테이블
/// 사용자의 찜한 상품
model Wishlist {
  id        Int      @id @default(autoincrement())
  /// 사용자 ID
  userId    Int      @map("user_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

/// 최근 본 상품 테이블
/// 사용자가 최근에 조회한 상품
model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  /// 사용자 ID
  userId    Int      @map("user_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 조회일시
  viewedAt  DateTime @map("viewed_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

/// AI 페르소나 테이블
/// 챌린지를 도와주는 AI 페르소나들
model AiPersona {
  id               Int               @id(map: "ai_characters_pkey") @default(autoincrement())
  /// 페르소나 이름 (철민님, 유진님, 뽑이)
  name             String            @db.VarChar(50)
  /// 페르소나 설명
  description      String?
  /// 페르소나 성격/대화 스타일
  personality      String?
  /// 페르소나 이미지 URL
  personaUrl       String?           @map("persona_url") @db.VarChar(500)
  /// 활성화 여부
  isActive         Boolean           @default(true) @map("is_active")
  /// 정렬 순서
  sortOrder        Int               @default(0) @map("sort_order")
  /// 생성일시
  createdAt        DateTime          @map("created_at")
  /// 수정일시
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  /// 페르소나 성별 (M: 남성, F: 여성)
  gender           Gender?
  /// 소개 제목
  introTitle       String?           @map("intro_title") @db.VarChar(200)
  /// 소개 내용
  introContent     String?           @map("intro_content")
  /// 해시태그 (JSON 배열)
  hashtags         String?
  /// 특징 제목
  featureTitle     String?           @map("feature_title") @db.VarChar(200)
  /// 특징 내용
  featureContent   String?           @map("feature_content")
  /// 말투 제목
  speechTitle      String?           @map("speech_title") @db.VarChar(200)
  /// 말투 내용
  speechContent    String?           @map("speech_content")
  /// 말투 이미지 URL
  speechImageUrl   String?           @map("speech_image_url") @db.VarChar(500)
  /// 친밀도 제목
  intimacyTitle    String?           @map("intimacy_title") @db.VarChar(200)
  /// 친밀도 내용
  intimacyContent  String?           @map("intimacy_content")
  /// 친밀도 이미지 URL
  intimacyImageUrl String?           @map("intimacy_image_url") @db.VarChar(500)
  /// 페르소나 썸네일 이미지 URL
  thumbnailUrl     String?           @map("thumbnail_url") @db.VarChar(500)
  balanceGameSteps BalanceGameStep[]
  users            User[]

  @@index([isActive, sortOrder], map: "ai_characters_is_active_sort_order_idx")
  @@map("ai_personas")
}

/// 사용자별 챌린지별 설문 결과 테이블
/// 챌린지마다 다른 사전/사후 설문 결과 저장
model UserChallengeSurveyResult {
  id                    Int       @id @default(autoincrement())
  /// 사용자 ID
  userId                Int       @map("user_id")
  /// 상품 ID (챌린지 이용권)
  productId             Int       @map("product_id")
  /// 사전설문 건강 유형 (HealthTypeAnimal.healthType 참조)
  beforeHealthType      String?   @map("before_health_type") @db.VarChar(50)
  /// 사후설문 건강 유형 (HealthTypeAnimal.healthType 참조)
  afterHealthType       String?   @map("after_health_type") @db.VarChar(50)
  /// 사전설문 피부건강 점수
  beforeScoreSkinHealth Int?      @map("before_score_skin_health")
  /// 사전설문 대사 점수
  beforeScoreMetabolism Int?      @map("before_score_metabolism")
  /// 사전설문 면역 점수
  beforeScoreImmune     Int?      @map("before_score_immune")
  /// 사전설문 장건강 점수
  beforeScoreGutHealth  Int?      @map("before_score_gut_health")
  /// 사전설문 총점
  beforeScoreTotal      Int?      @map("before_score_total")
  /// 사후설문 피부건강 점수
  afterScoreSkinHealth  Int?      @map("after_score_skin_health")
  /// 사후설문 대사 점수
  afterScoreMetabolism  Int?      @map("after_score_metabolism")
  /// 사후설문 면역 점수
  afterScoreImmune      Int?      @map("after_score_immune")
  /// 사후설문 장건강 점수
  afterScoreGutHealth   Int?      @map("after_score_gut_health")
  /// 사후설문 총점
  afterScoreTotal       Int?      @map("after_score_total")
  /// 사전설문 완료일시
  beforeCompletedAt     DateTime? @map("before_completed_at")
  /// 사후설문 완료일시
  afterCompletedAt      DateTime? @map("after_completed_at")
  /// 생성일시
  createdAt             DateTime  @map("created_at")
  /// 수정일시
  updatedAt             DateTime? @updatedAt @map("updated_at")
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("user_challenge_survey_results")
}

/// 미션 시도 기록 테이블
/// 사용자의 미션 수행 시도를 기록하고, dailyLimit 기반 진행도 추적
model UserMission {
  id                 Int              @id(map: "mission_attempts_pkey") @default(autoincrement())
  /// 사용자 ID
  userId             Int              @map("user_id")
  /// 챌린지 미션 ID
  challengeMissionId Int              @map("challenge_mission_id")
  /// 사용자 챌린지 ID
  userChallengeId    Int              @map("user_challenge_id")
  /// 챌린지 진행 일차
  day                Int
  /// 당일 시도 순서 (1, 2, 3...)
  attemptNumber      Int              @map("attempt_number")
  /// 최종 완료 여부 (dailyLimit 달성)
  isCompleted        Boolean          @default(false) @map("is_completed")
  /// 획득 포인트 (최종 완료시만)
  pointsEarned       Int              @default(0) @map("points_earned")
  /// 업로드된 파일 ID
  fileUploadId       Int?             @map("file_upload_id")
  /// 기록형 미션의 UserRecord ID
  trackingRecordId   Int?             @map("tracking_record_id")
  /// 추가 데이터
  metadata           Json?
  /// 시도 일시
  createdAt          DateTime         @map("created_at")
  /// 수정일시
  updatedAt          DateTime?        @updatedAt @map("updated_at")
  challengeMission   ChallengeMission @relation(fields: [challengeMissionId], references: [id], onDelete: Cascade, map: "mission_attempts_challenge_mission_id_fkey")
  userFile           UserFile?        @relation(fields: [fileUploadId], references: [id], map: "mission_attempts_file_upload_id_fkey")
  trackingRecord     UserRecord?      @relation(fields: [trackingRecordId], references: [id], map: "mission_attempts_tracking_record_id_fkey")
  userChallenge      UserChallenge    @relation(fields: [userChallengeId], references: [id], onDelete: Cascade, map: "mission_attempts_user_challenge_id_fkey")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "mission_attempts_user_id_fkey")

  @@unique([userId, challengeMissionId, day, attemptNumber], map: "mission_attempts_user_id_challenge_mission_id_day_attempt_n_key")
  @@index([challengeMissionId], map: "mission_attempts_challenge_mission_id_idx")
  @@index([createdAt], map: "mission_attempts_created_at_idx")
  @@index([userChallengeId, day], map: "mission_attempts_user_challenge_id_day_idx")
  @@index([userId, day], map: "mission_attempts_user_id_day_idx")
  @@map("user_missions")
}

/// 강의-퀴즈 연결 테이블
/// 각 강의에 연결된 퀴즈들 (일차별 매핑)
model LectureQuiz {
  id        Int       @id @default(autoincrement())
  /// 강의 컨텐츠 ID
  contentId Int       @map("content_id")
  /// 퀴즈 ID
  quizId    Int       @map("quiz_id")
  /// 정렬 순서
  sortOrder Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive  Boolean   @default(true) @map("is_active")
  /// 일차 (해당 강의가 몇일차인지)
  day       Int?
  /// 생성일시
  createdAt DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime? @updatedAt @map("updated_at")
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([contentId, quizId])
  @@index([contentId])
  @@index([quizId])
  @@map("lecture_quizzes")
}

/// 강의-상품 연결 테이블
/// 각 강의에 연결된 추천 상품들
model LectureProduct {
  id        Int      @id @default(autoincrement())
  /// 강의 컨텐츠 ID
  contentId Int      @map("content_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 정렬 순서
  sortOrder Int      @default(0) @map("sort_order")
  /// 활성화 여부
  isActive  Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime @updatedAt @map("updated_at")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([contentId, productId])
  @@index([contentId])
  @@index([productId])
  @@map("lecture_products")
}

/// 밸런스게임 마스터 테이블
/// 밸런스게임 기본 정보 관리
model BalanceGame {
  id                   Int                      @id @default(autoincrement())
  /// 게임명
  title                String                   @db.VarChar(200)
  /// 게임 설명
  description          String?
  /// 활성화 여부
  isActive             Boolean                  @default(true) @map("is_active")
  /// 생성일시
  createdAt            DateTime                 @map("created_at")
  /// 수정일시
  updatedAt            DateTime?                @updatedAt @map("updated_at")
  /// 챌린지 일차 (1~21일차)
  challengeDay         Int                      @unique @map("challenge_day")
  /// 선택지 1 키워드
  option1Keyword       String?                  @map("option1_keyword") @db.VarChar(100)
  /// 선택지 1 연결 제품
  option1LinkedProduct String?                  @map("option1_linked_product") @db.VarChar(100)
  /// 선택지 1 텍스트
  option1Text          String?                  @map("option1_text") @db.VarChar(200)
  /// 선택지 2 키워드
  option2Keyword       String?                  @map("option2_keyword") @db.VarChar(100)
  /// 선택지 2 연결 제품
  option2LinkedProduct String?                  @map("option2_linked_product") @db.VarChar(100)
  /// 선택지 2 텍스트
  option2Text          String?                  @map("option2_text") @db.VarChar(200)
  steps                BalanceGameStep[]
  userHistories        UserBalanceGameHistory[]

  @@index([isActive, challengeDay])
  @@map("balance_games")
}

/// 밸런스게임 단계별 대본 테이블
/// 각 게임의 단계별 질문과 선택지, 대화 내용 관리
model BalanceGameStep {
  id             Int               @id @default(autoincrement())
  /// 밸런스게임 ID
  gameId         Int               @map("game_id")
  /// 단계 번호 (1: 선택 단계, 2~N: 대화 단계)
  stepNumber     Int               @map("step_number")
  /// 부모 단계 ID (선택지별 분기용)
  parentStepId   Int?              @map("parent_step_id")
  /// 선택한 옵션 값 (부모 단계에서 선택한 값, 1 또는 2)
  selectedOption Int?              @map("selected_option")
  /// 단계 타입 (QUESTION: 질문, DIALOGUE: 대화, RESULT: 결과)
  stepType       String            @map("step_type") @db.VarChar(20)
  /// 제목
  title          String?           @db.VarChar(200)
  /// 내용/질문
  content        String
  /// 선택지 (JSON) [{"value": 1, "text": "장원영 얼굴"}, {"value": 2, "text": "권은비 몸매"}]
  options        Json?
  /// 획득할 쿠폰 ID (결과 단계인 경우)
  couponId       Int?              @map("coupon_id")
  /// 정렬 순서
  sortOrder      Int               @default(0) @map("sort_order")
  /// 활성화 여부
  isActive       Boolean           @default(true) @map("is_active")
  /// 생성일시
  createdAt      DateTime          @map("created_at")
  /// 수정일시
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  /// AI 페르소나 ID (페르소나별 대사 구분용)
  aiPersonaId    Int               @map("ai_persona_id")
  aiPersona      AiPersona         @relation(fields: [aiPersonaId], references: [id], map: "balance_game_steps_character_id_fkey")
  coupon         Coupon?           @relation(fields: [couponId], references: [id])
  game           BalanceGame       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  parentStep     BalanceGameStep?  @relation("StepHierarchy", fields: [parentStepId], references: [id])
  childSteps     BalanceGameStep[] @relation("StepHierarchy")

  @@index([parentStepId])
  @@index([gameId, aiPersonaId, stepType], map: "balance_game_steps_game_id_character_id_step_type_idx")
  @@index([gameId, aiPersonaId, stepType], map: "balance_game_steps_gameid_aipersonaid_steptype_idx")
  @@map("balance_game_steps")
}

/// 사용자 밸런스게임 완료 이력 테이블
/// 사용자의 밸런스게임 완료 기록 관리
model UserBalanceGameHistory {
  id              Int         @id @default(autoincrement())
  /// 사용자 ID
  userId          Int         @map("user_id")
  /// 밸런스게임 ID
  gameId          Int         @map("game_id")
  /// 플레이 날짜 (YYYY-MM-DD)
  playDate        String      @map("play_date") @db.VarChar(10)
  /// 선택한 옵션들 JSON [{"step": 1, "option": 1}]
  selectedOptions Json        @map("selected_options")
  /// 획득 쿠폰 ID
  earnedCouponId  Int?        @map("earned_coupon_id")
  /// 완료일시
  completedAt     DateTime    @map("completed_at")
  earnedCoupon    Coupon?     @relation(fields: [earnedCouponId], references: [id])
  game            BalanceGame @relation(fields: [gameId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playDate])
  @@index([userId])
  @@index([gameId])
  @@map("user_balance_game_histories")
}

/// 쿠폰 마스터 테이블
/// 할인 쿠폰 정보 관리
model Coupon {
  id                Int                      @id @default(autoincrement())
  /// 쿠폰명
  name              String                   @db.VarChar(200)
  /// 쿠폰 설명
  description       String?
  /// 할인 타입 (PERCENTAGE: 퍼센트, AMOUNT: 고정금액)
  discountType      String                   @map("discount_type") @db.VarChar(20)
  /// 할인값 (퍼센트인 경우 %, 고정금액인 경우 원)
  discountValue     Int                      @map("discount_value")
  /// 최대 할인 금액 (퍼센트 할인인 경우)
  maxDiscountAmount Int?                     @map("max_discount_amount")
  /// 적용 상품 ID (특정 상품에만 적용)
  productId         Int                      @map("product_id")
  /// 유효시간 (시간 단위, 48시간 = 48)
  validHours        Int                      @default(48) @map("valid_hours")
  /// 활성화 여부
  isActive          Boolean                  @default(true) @map("is_active")
  /// 생성일시
  createdAt         DateTime                 @map("created_at")
  /// 수정일시
  updatedAt         DateTime?                @updatedAt @map("updated_at")
  gameSteps         BalanceGameStep[]
  product           Product                  @relation(fields: [productId], references: [id])
  earnedInGames     UserBalanceGameHistory[]
  userCoupons       UserCoupon[]

  @@index([productId, isActive])
  @@map("coupons")
}

/// 사용자 쿠폰 테이블
/// 사용자가 보유한 쿠폰 관리
model UserCoupon {
  id          Int       @id @default(autoincrement())
  /// 사용자 ID
  userId      Int       @map("user_id")
  /// 쿠폰 ID
  couponId    Int       @map("coupon_id")
  /// 쿠폰 상태 (ACTIVE: 사용가능, USED: 사용완료, EXPIRED: 만료)
  status      String    @default("ACTIVE") @db.VarChar(20)
  /// 발급일시
  issuedAt    DateTime  @map("issued_at")
  /// 만료일시
  expiresAt   DateTime  @map("expires_at")
  /// 사용일시
  usedAt      DateTime? @map("used_at")
  /// 사용한 주문 ID
  usedOrderId Int?      @map("used_order_id")
  coupon      Coupon    @relation(fields: [couponId], references: [id])
  usedOrder   Order?    @relation(fields: [usedOrderId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([couponId])
  @@index([expiresAt])
  @@map("user_coupons")
}

/// 배송 테이블
/// 주문의 배송 정보를 관리
model Shipping {
  id             Int       @id @default(autoincrement())
  /// 주문 ID
  orderId        Int       @unique @map("order_id")
  /// 택배사 코드 (한진택배: CJ, 우체국: EPOST 등)
  courierCode    String?   @map("courier_code") @db.VarChar(20)
  /// 택배사명
  courierName    String?   @map("courier_name") @db.VarChar(50)
  /// 운송장 번호
  trackingNumber String?   @map("tracking_number") @db.VarChar(50)
  /// 배송 상태 (PENDING: 대기, READY_FOR_SHIPMENT: 배송준비, IN_TRANSIT: 배송중, DELIVERED: 배송완료)
  status         String    @default("PENDING") @db.VarChar(30)
  /// 배송비
  shippingFee    Decimal   @default(3000) @map("shipping_fee") @db.Decimal(10, 2)
  /// 배송 준비 완료일시
  readyAt        DateTime? @map("ready_at")
  /// 배송 시작일시
  shippedAt      DateTime? @map("shipped_at")
  /// 배송 완료일시
  deliveredAt    DateTime? @map("delivered_at")
  /// 생성일시
  createdAt      DateTime  @map("created_at")
  /// 수정일시
  updatedAt      DateTime  @updatedAt @map("updated_at")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([courierCode])
  @@index([trackingNumber])
  @@index([createdAt])
  @@map("shipping")
}

/// 배송 정책 테이블
/// 배송비 및 배송 관련 정책 설정
model ShippingPolicy {
  id                    Int      @id @default(autoincrement())
  /// 정책명
  name                  String   @db.VarChar(100)
  /// 기본 배송비
  baseShippingFee       Decimal  @default(3000) @map("base_shipping_fee") @db.Decimal(10, 2)
  /// 무료배송 최소 주문금액
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(10, 2)
  /// 도서산간 추가 배송비
  remoteAreaFee         Decimal  @default(3000) @map("remote_area_fee") @db.Decimal(10, 2)
  /// 제주도 추가 배송비
  jejuAreaFee           Decimal  @default(3000) @map("jeju_area_fee") @db.Decimal(10, 2)
  /// 기본 택배사 코드
  defaultCourierCode    String   @default("CJ") @map("default_courier_code") @db.VarChar(20)
  /// 기본 택배사명
  defaultCourierName    String   @default("한진택배") @map("default_courier_name") @db.VarChar(50)
  /// 활성화 여부
  isActive              Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt             DateTime @map("created_at")
  /// 수정일시
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shipping_policies")
}

/// 교환/반품 테이블
/// 주문 상품의 교환 및 반품 신청 관리
model ExchangeReturn {
  id             Int       @id @default(autoincrement())
  /// 주문 ID
  orderId        Int       @map("order_id")
  /// 교환/반품 타입 (EXCHANGE: 교환, RETURN: 반품)
  type           String    @db.VarChar(20)
  /// 신청 상태 (REQUESTED: 신청, APPROVED: 승인, REJECTED: 거절, COMPLETED: 완료)
  status         String    @default("REQUESTED") @db.VarChar(20)
  /// 신청 사유
  reason         String    @db.VarChar(500)
  /// 상세 사유
  reasonDetail   String?   @map("reason_detail")
  /// 수거 주소
  pickupAddress  String    @map("pickup_address")
  /// 배송비 (국내: 6000원, 해외직구: 19600원)
  shippingFee    Decimal   @default(6000) @map("shipping_fee") @db.Decimal(10, 2)
  /// 택배사 코드
  courierCode    String?   @map("courier_code") @db.VarChar(20)
  /// 택배사명
  courierName    String?   @map("courier_name") @db.VarChar(50)
  /// 운송장 번호
  trackingNumber String?   @map("tracking_number") @db.VarChar(50)
  /// 관리자 메모
  adminMemo      String?   @map("admin_memo")
  /// 신청일시
  requestedAt    DateTime  @map("requested_at")
  /// 승인일시
  approvedAt     DateTime? @map("approved_at")
  /// 거절일시
  rejectedAt     DateTime? @map("rejected_at")
  /// 완료일시
  completedAt    DateTime? @map("completed_at")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type, status])
  @@index([requestedAt])
  @@map("exchange_returns")
}

/// 교환/반품 정책 테이블
/// 교환/반품 관련 정책 설정
model ExchangeReturnPolicy {
  id                  Int      @id @default(autoincrement())
  /// 정책명
  name                String   @db.VarChar(100)
  /// 교환/반품 가능 기간 (일)
  exchangeReturnDays  Int      @default(7) @map("exchange_return_days")
  /// 기본 택배사 코드
  defaultCourierCode  String   @default("CJ") @map("default_courier_code") @db.VarChar(20)
  /// 기본 택배사명
  defaultCourierName  String   @default("한진택배") @map("default_courier_name") @db.VarChar(50)
  /// 국내 배송비
  domesticShippingFee Decimal  @default(6000) @map("domestic_shipping_fee") @db.Decimal(10, 2)
  /// 해외직구 배송비
  overseasShippingFee Decimal  @default(19600) @map("overseas_shipping_fee") @db.Decimal(10, 2)
  /// 교환/반품 주소
  returnAddress       String   @default("서울 강서구 마곡중앙로 59-17 (마곡동, 류마타워2) 3층 바이오컴 (07807)") @map("return_address")
  /// 활성화 여부
  isActive            Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt           DateTime @map("created_at")
  /// 수정일시
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("exchange_return_policies")
}

/// 30일 체험 후 환불 워런티 테이블
/// 건강기능식품 불만족시 100% 환불 워런티 정책
model RefundWarranty {
  id                     Int       @id @default(autoincrement())
  /// 주문 ID
  orderId                Int       @unique @map("order_id")
  /// 사용자 ID
  userId                 Int       @map("user_id")
  /// 워런티 상태 (ACTIVE: 활성, USED: 사용완료, EXPIRED: 만료)
  status                 String    @default("ACTIVE") @db.VarChar(20)
  /// 제품 개봉 여부
  isOpened               Boolean   @default(false) @map("is_opened")
  /// 섭취 시작일
  consumptionStartAt     DateTime? @map("consumption_start_at")
  /// 30일 섭취 완료일
  consumptionEndAt       DateTime? @map("consumption_end_at")
  /// 환불 신청일
  refundRequestedAt      DateTime? @map("refund_requested_at")
  /// 환불 완료일
  refundCompletedAt      DateTime? @map("refund_completed_at")
  /// 환불 금액
  refundAmount           Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  /// 배송비 입금 확인일
  shippingFeeConfirmedAt DateTime? @map("shipping_fee_confirmed_at")
  /// 제품 회수 완료일
  productReturnedAt      DateTime? @map("product_returned_at")
  /// 관리자 메모
  adminMemo              String?   @map("admin_memo")
  /// 생성일시 (상품 수령일)
  createdAt              DateTime  @map("created_at")
  /// 수정일시
  updatedAt              DateTime  @updatedAt @map("updated_at")
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orderId])
  @@index([createdAt])
  @@map("refund_warranties")
}

/// 공통 배너 테이블
model Banner {
  id          Int       @id @default(autoincrement())
  /// 배너 제목
  title       String    @db.VarChar(100)
  /// 배너 이미지 URL
  imageUrl    String    @map("image_url") @db.VarChar(500)
  /// 클릭시 이동할 라우팅 URL
  linkUrl     String?   @map("link_url") @db.VarChar(500)
  /// 링크 타입 (INTERNAL: 앱 내부 라우팅, EXTERNAL: 외부 URL, PRODUCT: 상품 상세)
  linkType    String    @default("INTERNAL") @map("link_type") @db.VarChar(20)
  /// 배너 설명 (선택)
  description String?
  /// 정렬 순서 (낮을수록 우선)
  sortOrder   Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 노출 시작일
  startDate   DateTime? @map("start_date")
  /// 노출 종료일
  endDate     DateTime? @map("end_date")
  /// 생성일시
  createdAt   DateTime  @map("created_at")
  /// 수정일시
  updatedAt   DateTime? @updatedAt @map("updated_at")
  /// 배너 타입 (SHOP: 쇼핑몰, HOME: 메인홈, EVENT: 이벤트)
  bannerType  String    @default("SHOP") @map("banner_type") @db.VarChar(20)

  @@index([bannerType, isActive, sortOrder])
  @@index([startDate, endDate])
  @@map("banners")
}

/// 식품 카테고리 테이블
/// 고포드맵 식품, 가공식품 등 식단 관련 식품 분류 정보 관리
model FoodCategory {
  id           Int      @id @default(autoincrement())
  /// 식품명
  name         String   @db.VarChar(100)
  /// 카테고리 (HIGH_FODMAP: 고포드맵 식품, PROCESSED: 가공식품)
  category     String   @db.VarChar(50)
  /// 정렬 순서
  displayOrder Int      @default(0) @map("display_order")
  /// 활성화 여부
  isActive     Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt    DateTime @default(now()) @map("created_at")
  /// 수정일시
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category, isActive], map: "idx_food_categories_category_active")
  @@index([category, isActive], map: "idx_food_categories_category_is_active")
  @@map("food_categories")
}

/// 뷰티 설문지 마스터 테이블
/// 이너뷰티 4개 항목 + 아우터뷰티 4개 항목 관리
model BeautyQuestion {
  id        Int       @id @default(autoincrement())
  /// 뷰티 타입 (INNER: 이너뷰티, OUTER: 아우터뷰티)
  type      String    @db.VarChar(20)
  /// 구분 (장 건강, 대사 밸런스, 붓기, 수분감 등)
  category  String    @db.VarChar(50)
  /// 질문 문구
  question  String
  /// 정렬 순서
  sortOrder Int       @map("sort_order")
  /// 활성화 여부 (false시 앱에서 안보임)
  isActive  Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([isActive], map: "idx_beauty_questions_is_active")
  @@index([sortOrder], map: "idx_beauty_questions_sort_order")
  @@index([type], map: "idx_beauty_questions_type")
  @@map("beauty_questions")
}

/// 휴대폰 본인인증 로그 테이블
/// NHN KCP SMS 인증 감사 로그 (법적 요구사항)
model PhoneVerificationLog {
  id                 Int       @id @default(autoincrement())
  /// 본인확인 거래번호 (KCP 발급)
  certNumber         String    @unique @map("cert_number") @db.VarChar(50)
  /// 휴대폰 번호
  mobile             String    @db.VarChar(500)
  /// 통신사 코드 (SKT, KTF, LGT, SKM, KTM, LGM)
  telecom            String    @db.VarChar(3)
  /// 사용자 이름
  userName           String    @map("user_name") @db.VarChar(500)
  /// 생년월일 (YYYYMMDD)
  birthDay           String    @map("birth_day") @db.VarChar(500)
  /// 성별 코드 (1: 남, 2: 여)
  sex                String    @db.VarChar(2)
  /// CI (개인 고유 연계정보)
  ci                 String?   @db.VarChar(500)
  /// DI (업체별 중복가입 확인정보)
  di                 String?   @db.VarChar(500)
  /// 인증 상태 (pending: 대기, completed: 완료, failed: 실패)
  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(50)
  /// 진행 단계 (identity: 실명확인, sms_sent: SMS발송, verified: 인증완료)
  step               String    @db.VarChar(50)
  /// 실패 사유
  failReason         String?   @map("fail_reason")
  /// 생성일시
  createdAt          DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt          DateTime? @updatedAt @map("updated_at")
  /// 주문번호 (우리 시스템에서 생성)
  orderId            String?   @map("order_id") @db.VarChar(50)
  /// KCP VAN Transaction ID
  vanTxId            String?   @map("van_tx_id") @db.VarChar(100)
  /// KCP SMS 발송 여부
  smsSndYn           String?   @map("sms_snd_yn") @db.VarChar(1)
  /// KCP 본인확인 전용 여부
  idenOnlyYn         String?   @map("iden_only_yn") @db.VarChar(1)
  /// KCP SafeGuard 여부
  safeGuardYn        String?   @map("safe_guard_yn") @db.VarChar(1)
  /// KCP USIM OTP 여부
  usimOtpYn          String?   @map("usim_otp_yn") @db.VarChar(1)
  /// KCP 인증번호 보호 여부
  certNumGuardYn     String?   @map("cert_num_guard_yn") @db.VarChar(1)
  /// KCP 기관 Transaction ID
  authTxId           String?   @map("auth_tx_id") @db.VarChar(100)

  @@index([certNumber], map: "idx_phone_verification_logs_cert_number")
  @@index([createdAt], map: "idx_phone_verification_logs_created_at")
  @@index([mobile], map: "idx_phone_verification_logs_phone_number")
  @@index([verificationStatus], map: "idx_phone_verification_logs_verification_status")
  @@map("phone_verification_logs")
}

/// 구독 테이블
/// 정기 구독 상품 관리 (자동결제)
model Subscription {
  /// 구독 ID
  id              Int       @id @default(autoincrement())
  /// 사용자 ID
  userId          Int       @map("user_id")
  /// 구독 상품 ID (products 테이블 참조)
  productId       Int       @map("product_id")
  /// 빌링키 (토스페이먼츠 자동결제 키)
  billingKey      String    @map("billing_key") @db.VarChar(200)
  /// 고객키 (토스페이먼츠 고객 식별자)
  customerKey     String    @map("customer_key") @db.VarChar(200)
  /// 구독 상태
  /// - ACTIVE: 정상 구독 중
  /// - PAUSED: 일시정지
  /// - CANCELLED: 사용자가 취소
  /// - BILLING_DELETED: 빌링키 삭제됨 (카드 삭제, 유효기간 만료 등)
  /// - PAYMENT_FAILED: 자동결제 실패로 중지
  /// - EXPIRED: 구독 기간 만료
  status          String    @default("ACTIVE") @db.VarChar(20)
  /// 구독 시작일
  startDate       DateTime  @map("start_date")
  /// 다음 결제일 (자동결제 예정일)
  nextBillingDate DateTime  @map("next_billing_date")
  /// 구독 종료일 (취소 시 설정)
  endDate         DateTime? @map("end_date")
  /// 결제 주기 (일 단위)
  /// 예: 30 (월 구독), 90 (3개월 구독), 365 (연 구독)
  billingCycle    Int       @default(30) @map("billing_cycle")
  /// 구독 가격 (매 결제 금액)
  price           Int
  /// 생성일시
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([billingKey], map: "idx_subscriptions_billing_key")
  @@index([nextBillingDate], map: "idx_subscriptions_next_billing_date")
  @@index([status], map: "idx_subscriptions_status")
  @@index([userId], map: "idx_subscriptions_user_id")
  @@map("subscriptions")
}

model datetime_tests {
  id         Int      @id @default(autoincrement())
  test_date  DateTime @db.Date
  test_time  DateTime
  memo       String?  @db.VarChar(200)
  created_at DateTime @default(now())
}

/// 푸시 토큰 통합 테이블
/// 모든 푸시 서비스(FCM, OneSignal, APNs 등)의 토큰 관리
model PushToken {
  /// 고유 ID
  id               Int                   @id @default(autoincrement())
  /// 유저 ID
  userId           Int                   @map("user_id")
  /// 푸시 서비스 제공자 (FCM, ONESIGNAL, APNS 등)
  provider         String                @db.VarChar(20)
  /// 디바이스 고유 ID
  deviceId         String?               @map("device_id") @db.VarChar(255)
  /// 플랫폼 (ios, android, web)
  platform         String?               @db.VarChar(20)
  /// 디바이스 모델명
  deviceModel      String?               @map("device_model") @db.VarChar(100)
  /// OS 버전
  osVersion        String?               @map("os_version") @db.VarChar(50)
  /// 앱 버전
  appVersion       String?               @map("app_version") @db.VarChar(50)
  /// 활성화 여부
  isActive         Boolean               @default(true) @map("is_active")
  /// 토큰 무효화 시간
  invalidatedAt    DateTime?             @map("invalidated_at")
  /// 무효화 이유
  invalidReason    String?               @map("invalid_reason") @db.VarChar(100)
  /// 마지막 사용 시간 (발송 성공)
  lastUsedAt       DateTime?             @map("last_used_at")
  /// 마지막 실패 시간
  lastFailedAt     DateTime?             @map("last_failed_at")
  /// 연속 실패 횟수
  failureCount     Int                   @default(0) @map("failure_count")
  /// 총 성공 횟수
  successCount     Int                   @default(0) @map("success_count")
  /// 마케팅 알림 수신 동의
  marketingEnabled Boolean               @default(false) @map("marketing_enabled")
  /// 야간 푸시 수신 동의
  nightPushEnabled Boolean               @default(true) @map("night_push_enabled")
  /// User Agent
  userAgent        String?               @map("user_agent") @db.VarChar(500)
  /// IP 주소
  ipAddress        String?               @map("ip_address") @db.VarChar(45)
  /// 타임존
  timezone         String?               @default("Asia/Seoul") @db.VarChar(50)
  /// 생성일시
  createdAt        DateTime              @default(now()) @map("created_at")
  /// 수정일시
  updatedAt        DateTime?             @updatedAt @map("updated_at")
  /// 푸시 토큰 (필수)
  token            String                @db.VarChar(255)
  /// 메타데이터 (선택적 부가 정보)
  metadata         Json?
  logs             PushNotificationLog[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, provider])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@index([platform])
  @@index([token])
  @@map("push_tokens")
}

model SupplementNutrient {
  id           Int       @id @default(autoincrement())
  productId    Int       @map("product_id")
  nutrientName String    @map("nutrient_name") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, nutrientName])
  @@index([nutrientName])
  @@index([productId])
  @@map("supplement_nutrients")
}

model UserChart {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  chartId     String    @unique @map("chart_id") @db.VarChar(50)
  receiptDate DateTime  @map("receipt_date")
  resultYn    String    @map("result_yn") @db.VarChar(1)
  orderCode   String    @map("order_code") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@index([chartId], map: "idx_user_charts_chart_id")
  @@index([userId], map: "idx_user_charts_user_id")
  @@map("user_charts")
}

/// 푸시 알림 발송 로그 테이블
/// 개별 유저별 발송 상세 이력
model PushNotificationLog {
  /// 고유 ID
  id           Int                       @id @default(autoincrement())
  /// 유저 ID
  userId       Int                       @map("user_id")
  /// 푸시 토큰 ID
  pushTokenId  Int?                      @map("push_token_id")
  /// 제목
  title        String?                   @db.VarChar(255)
  /// 본문
  body         String
  /// 추가 데이터 (주문번호, 미션ID, 딥링크 등)
  data         Json?
  /// 푸시 타입
  type         String?                   @db.VarChar(50)
  /// 발송 성공 여부
  success      Boolean
  /// 에러 코드
  errorCode    String?                   @map("error_code") @db.VarChar(100)
  /// 에러 메시지
  errorMessage String?                   @map("error_message")
  /// 발송 시간
  sentAt       DateTime?                 @map("sent_at")
  /// 알림 읽은 시간
  readAt       DateTime?                 @map("read_at")
  /// 알림 클릭한 시간
  clickedAt    DateTime?                 @map("clicked_at")
  /// 캠페인 ID
  campaignId   Int?                      @map("campaign_id")
  /// 테스트 발송 여부
  isTest       Boolean                   @map("is_test")
  /// 생성일시
  createdAt    DateTime?                 @map("created_at")
  /// 이미지 URL
  imageUrl     String?                   @map("image_url") @db.VarChar(500)
  /// 메시지 ID
  messageId    String?                   @map("message_id") @db.VarChar(255)
  campaign     PushNotificationCampaign? @relation(fields: [campaignId], references: [id])
  pushToken    PushToken?                @relation(fields: [pushTokenId], references: [id])
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, pushTokenId])
  @@index([userId], map: "idx_push_notification_logs_user_id")
  @@index([campaignId])
  @@index([pushTokenId])
  @@index([type])
  @@index([success])
  @@index([isTest])
  @@map("push_notification_logs")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model UserConsent {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  agreeToTerms      Boolean   @map("agree_to_terms")
  agreeToAge14      Boolean   @map("agree_to_age14")
  agreeToPrivacy    Boolean   @map("agree_to_privacy")
  agreeToThirdParty Boolean   @map("agree_to_third_party")
  agreeToMarketing  Boolean   @map("agree_to_marketing")
  agreedAt          DateTime  @map("agreed_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(6)

  @@index([userId], map: "idx_user_consents_user_id")
  @@map("user_consents")
}

/// 사용자별 영양제 루틴 테이블
/// 회원가입 후 배정받은 동물의 기본 영양제 3종 + 사용자가 추가한 영양제 관리
model UserSupplementRoutine {
  id           Int       @id @default(autoincrement())
  /// 사용자 ID
  userId       Int       @map("user_id")
  /// 상품 ID
  productId    Int       @map("product_id")
  /// 기본 영양제 여부 (true: 온보딩 시 자동 추가된 기본 3종, 삭제 불가)
  isDefault    Boolean   @default(false) @map("is_default")
  /// 노출 순서 (기본 3종은 1~3, 추가 영양제는 4부터)
  displayOrder Int       @default(999) @map("display_order")
  /// 활성화 여부
  isActive     Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt    DateTime? @updatedAt @map("updated_at")

  /// Relations
  product      Product   @relation("UserSupplementRoutineProduct", fields: [productId], references: [id], onDelete: Cascade)
  user         User      @relation("UserSupplementRoutineUser", fields: [userId], references: [id], onDelete: Cascade)

  /// 같은 사용자가 같은 상품을 중복 등록할 수 없음
  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, isActive])
  @@map("user_supplement_routine")
}

model UserSupplementRoutineHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation("UserSupplementRoutineHistoryProduct", fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation("UserSupplementRoutineHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, date])
  @@index([userId, date])
  @@map("user_supplement_routine_history")
}

/// 푸시 알림 스케줄 테이블
/// 반복 발송 설정 및 메시지 템플릿 관리
model PushNotificationSchedule {
  /// 고유 ID
  id                 Int                        @id @default(autoincrement())
  /// 스케줄 이름
  name               String                     @db.VarChar(100)
  /// 스케줄 설명
  description        String?                    @db.VarChar(500)
  /// 스케줄 타입 (ONCE: 단발성, RECURRING: 반복)
  scheduleType       String                     @default("RECURRING") @map("schedule_type") @db.VarChar(20)
  /// 푸시 타입
  type               String                     @db.VarChar(50)
  /// 카테고리 (AUTO, MARKETING)
  category           String                     @db.VarChar(20)
  /// 크론 표현식 (예: 0 9 * * *) - RECURRING 타입일 때 사용
  cronExpression     String?                    @map("cron_expression") @db.VarChar(50)
  /// 단발성 예약 시간 (ONCE 타입일 때 사용)
  oneTimeScheduledAt DateTime?                  @map("one_time_scheduled_at")
  /// 제목
  title              String                     @db.VarChar(100)
  /// 본문 템플릿
  bodyTemplate       String                     @map("body_template")
  /// 이미지 URL
  imageUrl           String?                    @map("image_url") @db.VarChar(500)
  /// 추가 데이터 (JSON)
  data               Json?
  /// 타겟팅 쿼리 조건 (JSON)
  /// 예: { "marketingEnabled": true, "userIds": [1,2,3], "platforms": ["IOS", "ANDROID"] }
  targetQuery        Json?                      @map("target_query")
  /// 반복 발송 시작일 (RECURRING 타입일 때 유효 기간 시작)
  startDate          DateTime?                  @map("start_date")
  /// 반복 발송 종료일 (RECURRING 타입일 때 유효 기간 종료)
  endDate            DateTime?                  @map("end_date")
  /// 활성화 여부
  isActive           Boolean                    @default(true) @map("is_active")
  /// 마지막 실행 시간
  lastExecutedAt     DateTime?                  @map("last_executed_at")
  /// 다음 실행 예정 시간
  nextExecutionAt    DateTime?                  @map("next_execution_at")
  /// 총 실행 횟수
  executionCount     Int                        @default(0) @map("execution_count")
  /// 생성한 관리자 ID
  createdBy          Int?                       @map("created_by")
  /// 생성일시
  createdAt          DateTime                   @default(now()) @map("created_at")
  /// 수정일시
  updatedAt          DateTime?                  @updatedAt @map("updated_at")
  campaigns          PushNotificationCampaign[]

  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([scheduleType])
  @@index([nextExecutionAt])
  @@index([startDate, endDate])
  @@map("push_notification_schedules")
}

/// 푸시 알림 캠페인 테이블
/// 특정 시점의 실제 발송 실행 기록
model PushNotificationCampaign {
  /// 고유 ID
  id           Int                       @id @default(autoincrement())
  /// 스케줄 ID (스케줄 기반 발송이면 설정, 수동 발송이면 null)
  scheduleId   Int?                      @map("schedule_id")
  /// 캠페인 고유 키
  campaignKey  String                    @unique @map("campaign_key") @db.VarChar(255)
  /// 캠페인 타입 (MANUAL: 수동, SCHEDULED: 예약, RECURRING: 반복)
  campaignType String                    @default("MANUAL") @map("campaign_type") @db.VarChar(20)
  /// 제목
  title        String                    @db.VarChar(100)
  /// 본문
  body         String
  /// 이미지 URL
  imageUrl     String?                   @map("image_url") @db.VarChar(500)
  /// 추가 데이터 (JSON)
  data         Json?
  /// 푸시 타입
  type         String                    @db.VarChar(50)
  /// 카테고리
  category     String                    @db.VarChar(20)
  /// 상태 (PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED)
  status       String                    @default("PENDING") @db.VarChar(20)
  /// 목표 발송 수
  targetCount  Int                       @default(0) @map("target_count")
  /// 실제 발송 성공 수
  sentCount    Int                       @default(0) @map("sent_count")
  /// 실패 수
  failCount    Int                       @default(0) @map("fail_count")
  /// 예약 발송 시간
  scheduledAt  DateTime?                 @map("scheduled_at")
  /// 발송 시작 시간
  startedAt    DateTime?                 @map("started_at")
  /// 발송 완료 시간
  completedAt  DateTime?                 @map("completed_at")
  /// 취소 시간
  cancelledAt  DateTime?                 @map("cancelled_at")
  /// 취소 사유
  cancelReason String?                   @map("cancel_reason") @db.VarChar(500)
  /// 에러 메시지 (발송 실패 시)
  errorMessage String?                   @map("error_message")
  /// 생성일시
  createdAt    DateTime                  @default(now()) @map("created_at")
  /// 생성한 관리자 ID (수동 발송인 경우)
  createdBy    Int?                      @map("created_by")
  schedule     PushNotificationSchedule? @relation(fields: [scheduleId], references: [id])
  logs         PushNotificationLog[]

  @@index([campaignKey])
  @@index([scheduleId])
  @@index([campaignType])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("push_notification_campaigns")
}

/// 건강 타입 동물별 추천 영양제 관계 테이블
/// 각 동물 타입별로 맞춤 영양제 정보를 관리 (최대 3개)
model HealthTypeAnimalProduct {
  id                   Int              @id @default(autoincrement())
  /// 건강 타입 동물 ID
  healthTypeAnimalId   Int              @map("health_type_animal_id")
  /// 상품 ID
  productId            Int              @map("product_id")
  /// 노출 순서 (1~3)
  displayOrder         Int              @map("display_order")
  /// 활성화 여부
  isActive             Boolean          @default(true) @map("is_active")
  /// 생성일시
  createdAt            DateTime         @default(now()) @map("created_at")
  /// 수정일시
  updatedAt            DateTime?        @updatedAt @map("updated_at")

  /// Relations
  healthTypeAnimal     HealthTypeAnimal @relation(fields: [healthTypeAnimalId], references: [id], onDelete: Cascade)
  product              Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 각 동물 타입별로 같은 순서의 상품은 하나만 존재
  @@unique([healthTypeAnimalId, displayOrder])
  /// 같은 동물 타입에 같은 상품이 중복 등록되지 않도록
  @@unique([healthTypeAnimalId, productId])
  @@index([healthTypeAnimalId])
  @@index([productId])
  @@index([isActive])
  @@map("health_type_animal_products")
}

/// AI 페르소나 성별 Enum
enum Gender {
  M
  F
}
