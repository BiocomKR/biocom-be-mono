/// 사용자별 영양제 루틴 테이블
/// 회원가입 후 배정받은 동물의 기본 영양제 3종 + 사용자가 추가한 영양제 관리
model UserSupplementRoutine {
  id           Int       @id @default(autoincrement())
  /// 사용자 ID
  userId       Int       @map("user_id")
  /// 상품 ID
  productId    Int       @map("product_id")
  /// 생성일시
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt    DateTime? @updatedAt @map("updated_at")
  /// 노출 순서 (기본 3종은 1~3, 추가 영양제는 4부터)
  displayOrder Int       @default(999) @map("display_order")
  /// 활성화 여부
  isActive     Boolean   @default(true) @map("is_active")
  /// 기본 영양제 여부 (true: 온보딩 시 자동 추가된 기본 3종, 삭제 불가)
  isDefault    Boolean   @default(false) @map("is_default")
  product      Product   @relation("UserSupplementRoutineProduct", fields: [productId], references: [id], onDelete: Cascade)
  user         User      @relation("UserSupplementRoutineUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, isActive])
  @@map("user_supplement_routine")
}

model UserSupplementRoutineHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation("UserSupplementRoutineHistoryProduct", fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation("UserSupplementRoutineHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, date])
  @@index([userId, date])
  @@map("user_supplement_routine_history")
}

/// 건강 타입 동물별 추천 상품 관계 테이블
/// 각 동물 타입별로 맞춤 영양제/식단/포뮬러 정보를 관리
model HealthTypeAnimalProduct {
  id                 Int              @id @default(autoincrement())
  /// 건강 타입 동물 ID
  healthTypeAnimalId Int              @map("health_type_animal_id")
  /// 상품 ID
  productId          Int              @map("product_id")
  /// 노출 순서 (기존 호환용)
  displayOrder       Int              @map("display_order")
  /// 활성화 여부
  isActive           Boolean          @default(true) @map("is_active")
  /// 생성일시
  createdAt          DateTime         @default(now()) @map("created_at")
  /// 수정일시
  updatedAt          DateTime?        @updatedAt @map("updated_at")
  /// 상품 타입 (SUPPLEMENT: 영양제, DIET: 식단, FORMULA: 맞춤 포뮬러)
  type               String?          @db.VarChar(20)
  /// 우선순위 (1, 2, 3)
  priority           Int?
  /// 키워드 (장벽 복구, 독소 배출 등)
  keyword            String?          @db.VarChar(100)
  /// 추천 이유
  recommendReason    String?          @map("recommend_reason")
  /// 복용법 (1일 1회, 1회 3정)
  dosage             String?          @db.VarChar(100)
  /// 영양제 성분별 메커니즘 JSON
  mechanisms         Json?
  healthTypeAnimal   HealthTypeAnimal @relation(fields: [healthTypeAnimalId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([healthTypeAnimalId, productId])
  @@unique([healthTypeAnimalId, displayOrder])
  @@index([healthTypeAnimalId])
  @@index([productId])
  @@index([isActive])
  @@index([healthTypeAnimalId, type], map: "health_type_animal_products_type_idx")
  @@index([healthTypeAnimalId, type, priority], map: "health_type_animal_products_type_priority_idx")
  @@map("health_type_animal_products")
}

/// 부서 테이블
model Department {
