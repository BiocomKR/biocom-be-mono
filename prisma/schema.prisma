  user      User      @relation(fields: [userId], references: [id], map: "fk_user_consents_user_id")

  @@unique([userId, consentId], map: "user_consents_user_id_consent_id_unique")
  @@index([userId], map: "idx_user_consents_user_id")
  @@index([consentId], map: "idx_user_consents_consent_id")
