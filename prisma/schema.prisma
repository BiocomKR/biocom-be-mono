generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 탈퇴 회원 정보 테이블
/// 개인정보보호법 준수를 위해 탈퇴 회원 정보를 별도 보관
model WithdrawnUser {
  id          Int      @id @default(autoincrement())
  /// 원본 사용자 ID (추적용)
  userId      Int      @map("user_id")
  /// 이름 (암호화된 상태로 이관)
  name        String
  /// 휴대폰 번호 (암호화된 상태로 이관)
  mobile      String
  /// 탈퇴 사유 (선택)
  reason      String?
  /// 탈퇴 일시
  withdrawnAt DateTime @map("withdrawn_at")
  /// 생성 일시
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([withdrawnAt])
  @@map("withdrawn_users")
}

/// 사용자 테이블
/// 애플리케이션의 모든 사용자 정보를 저장
model User {
  id                           Int                            @id @default(autoincrement())
  email                        String?
  password                     String?
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime?                      @updatedAt @map("updated_at")
  points                       Int                            @default(0)
  mobile                       String
  name                         String
  isActive                     Boolean                        @default(true) @map("is_active")
  deletedAt                    DateTime?                      @map("deleted_at")
  aiPersonaId                  Int?                           @map("ai_persona_id")
  status                       String                         @default("NEWCOMER") @map("status") @db.VarChar(20)
  role                         String?                        @default("USER") @db.VarChar(20)
  birthDate                    String?                        @map("birth_date") @db.VarChar(8)
  telecom                      String?                        @db.VarChar(3)
  sex                          String?                        @db.VarChar(2)
  localCode                    String?                        @map("local_code") @db.VarChar(2)
  health_type_animal_id        Int?
  isFirstAppEntry              Boolean                        @default(true) @map("is_first_app_entry")
  refundAccountNo              String?                        @map("refund_account_no") @db.VarChar(30)
  refundBankCode               String?                        @map("refund_bank_code") @db.VarChar(10)
  refundBankName               String?                        @map("refund_bank_name") @db.VarChar(50)
  refundHolder                 String?                        @map("refund_holder") @db.VarChar(50)
  mbti                         String?                        @db.VarChar(4)
  /// 푸시 알림 수신 동의 여부
  pushEnabled                  Boolean?                       @map("push_enabled")
  /// 마케팅 알림 수신 동의 여부
  marketingEnabled             Boolean                        @default(false) @map("marketing_enabled")
  /// 야간 푸시 수신 동의 여부
  nightPushEnabled             Boolean                        @default(true) @map("night_push_enabled")
  /// 테스터 여부 (통계/기록에서 제외)
  isTester                     Boolean                        @default(false) @map("is_tester")
  /// 마지막 접속 시간 (미접속 조건 푸시용)
  lastSeenAt                   DateTime?                      @map("last_seen_at")
  /// 솔루션 확인 시간 (솔루션 페이지 진입 시 기록)
  solutionSeenAt               DateTime?                      @map("solution_seen_at")
  cart                         Cart?
  challengeTickets             ChallengeTicket[]
  iapReceipts                  IAPReceipt[]
  issueReports                 IssueReport[]
  orders                       Order[]
  pointHistories               PointHistory[]
  productFeedback              ProductFeedback[]
  pushNotificationLogs         PushNotificationLog[]
  pushTokens                   PushToken[]
  quizAttempts                 QuizAttempt[]
  recentlyViewed               RecentlyViewed[]
  refreshTokens                RefreshToken[]
  refundWarranties             RefundWarranty[]
  surveyAnswers                SurveyAnswer[]
  addresses                    UserAddress[]
  userAllergyReports           UserAllergyReport[]
  balanceGameHistories         UserBalanceGameHistory[]
  challengeSurveyResults       UserChallengeSurveyResult[]
  userChallenges               UserChallenge[]
  userCharts                   UserChart[]
  userChatDailySummaries       UserChatDailySummary[]
  userChatHistories            UserChatHistory[]
  userConsents                 UserConsent[]
  userCoupons                  UserCoupon[]
  userDeepReports              UserDeepReport[]
  userEmotionalState           UserEmotionalState?
  userFiles                    UserFile[]
  userMetabolicReports         UserMetabolicReport[]
  userMissions                 UserMission[]
  userRecords                  UserRecord[]
  userSupplementRoutine        UserSupplementRoutine[]        @relation("UserSupplementRoutineUser")
  userSupplementRoutineHistory UserSupplementRoutineHistory[] @relation("UserSupplementRoutineHistoryUser")
  aiPersona                    AiPersona?                     @relation(fields: [aiPersonaId], references: [id], map: "users_character_id_fkey")
  healthTypeAnimal             HealthTypeAnimal?              @relation(fields: [health_type_animal_id], references: [id])
  wishlist                     Wishlist[]
  notificationInbox            NotificationInbox[]
  paymentCustomers             PaymentCustomer[]

  @@map("users")
}

/// Refresh Token 테이블
/// 사용자 인증 토큰 갱신을 위한 장기 토큰 저장
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// 파일 업로드 테이블
/// 파일 마스터 테이블
/// 모든 파일 정보를 중앙에서 관리
model File {
  id                    Int                    @id @default(autoincrement())
  originalName          String                 @map("original_name") @db.VarChar(255)
  storedName            String                 @unique(map: "uq_files_stored_name") @map("stored_name") @db.VarChar(255)
  filePath              String                 @map("file_path")
  fileSize              Int                    @map("file_size")
  mimeType              String                 @map("mime_type") @db.VarChar(100)
  storageType           String                 @default("local") @map("storage_type") @db.VarChar(50)
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime?              @updatedAt @map("updated_at")
  contentFiles          ContentFile[]
  healthTypeAnimalFiles HealthTypeAnimalFile[]
  productFiles          ProductFile[]
  userFiles             UserFile[]

  @@index([createdAt], map: "idx_files_created_at")
  @@index([isActive], map: "idx_files_is_active")
  @@index([mimeType], map: "idx_files_mime_type")
  @@map("files")
}

/// 사용자 파일 관계 테이블
model UserFile {
  id             Int           @id(map: "file_uploads_pkey") @default(autoincrement())
  userId         Int           @map("user_id")
  uploadedAt     DateTime      @default(now()) @map("uploaded_at")
  fileType       String        @map("file_type")
  uploadCategory String        @map("upload_category")
  fileId         Int           @map("file_id")
  user           User          @relation(fields: [userId], references: [id], map: "file_uploads_user_id_fkey")
  file           File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userMissions   UserMission[]

  @@index([fileId], map: "idx_user_files_file_id")
  @@map("user_files")
}

model Content {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(255)
  content         String
  type            String?          @db.VarChar(50)
  weekNumber      Int?             @map("week_number")
  dayNumber       Int?             @map("day_number")
  sortOrder       Int              @default(0) @map("sort_order")
  points          Int              @default(300)
  viewCount       Int              @default(0) @map("view_count")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  challengeId     Int?             @map("challenge_id")
  /// 홈 배너 타이틀 (LECTURE용, 예: "10살 어려지는 식단 비법")
  bannerTitle     String?          @map("banner_title") @db.VarChar(200)
  contentFiles    ContentFile[]
  challenge       Product?         @relation("ChallengeContents", fields: [challengeId], references: [id])
  lectureProducts LectureProduct[]
  lectureQuizzes  LectureQuiz[]
  quizAttempts    QuizAttempt[]

  @@index([type, isActive])
  @@index([weekNumber, dayNumber])
  @@index([sortOrder])
  @@index([challengeId], map: "idx_contents_challenge_id")
  @@map("contents")
}

/// 컨텐츠 첨부파일 관계 테이블
model ContentFile {
  id        Int      @id @default(autoincrement())
  contentId Int      @map("content_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @map("created_at")
  fileId    Int      @map("file_id")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([fileId], map: "idx_content_files_file_id")
  @@map("content_files")
}

/// 아임웹 사이트 정보 테이블
/// 아임웹 API 연동을 위한 인증 정보 저장
model ImwebInfo {
  /// 고유 식별자
  id           Int       @id @default(autoincrement())
  /// 아임웹 사이트 이름 (관리용)
  name         String    @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 ID
  clientId     String    @map("client_id") @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 Secret
  clientSecret String    @map("client_secret") @db.VarChar(255)
  /// 아임웹 사이트 코드 (고유값, API 호출 시 사용)
  siteCode     String    @unique @map("site_code") @db.VarChar(255)
  /// OAuth 인가 코드 수신용 콜백 URI
  redirectUri  String    @map("redirect_uri") @db.VarChar(500)
  /// API 사용 권한 범위 (예: member-info:read site-info:write)
  scope        String    @db.VarChar(500)
  /// 아임웹 API 액세스 토큰 (2시간 유효)
  accessToken  String?   @map("access_token")
  /// 아임웹 API 리프레시 토큰 (90일 유효)
  refreshToken String?   @map("refresh_token")
  /// 생성 일시
  createdAt    DateTime  @map("created_at")
  /// 수정 일시 (최초 생성 시 null)
  updatedAt    DateTime? @map("updated_at")

  @@map("imweb_info")
}

/// 설문 마스터 테이블
/// 설문 세트를 관리 (예: "기본 건강 설문", "다이어트 설문" 등)
model Survey {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  description      String?
  /// 설문 타입 ('before': 사전설문, 'after': 사후설문)
  type             String            @default("before") @db.VarChar(20)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @map("created_at")
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  challengeSurveys ChallengeSurvey[]
  surveyQuestions  SurveyQuestion[]

  @@index([type, isActive])
  @@map("surveys")
}

/// 설문지 질문 테이블
/// 설문 조사에 사용되는 모든 질문들을 저장
model SurveyQuestion {
  id            Int            @id @default(autoincrement())
  category      String
  questionText  String         @map("question_text")
  sortOrder     Int            @map("sort_order")
  createdAt     DateTime       @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  categoryCode  String         @map("category_code")
  surveyId      Int?           @map("survey_id")
  isActive      Boolean        @default(true) @map("is_active")
  surveyAnswers SurveyAnswer[]
  survey        Survey?        @relation(fields: [surveyId], references: [id])

  @@index([surveyId])
  @@index([isActive], map: "idx_survey_questions_is_active")
  @@map("survey_questions")
}

/// 옵션 마스터 테이블
/// 설문 응답에 사용되는 공통 옵션들
/// surveyType: PRE_SURVEY(사전문진 4/8/12/16/20), DAILY(데일리문진 5/10/15/20/25)
model SurveyOption {
  id            Int            @id @default(autoincrement())
  optionText    String         @map("option_text")
  score         Int
  createdAt     DateTime       @map("created_at")
  isActive      Boolean        @default(true) @map("is_active")
  /// 설문 옵션 타입 (PRE_SURVEY: 사전문진, DAILY: 데일리문진)
  surveyType    String         @default("PRE_SURVEY") @map("survey_type") @db.VarChar(20)
  surveyAnswers SurveyAnswer[]

  @@index([isActive], map: "idx_survey_options_is_active")
  @@index([surveyType], map: "idx_survey_options_survey_type")
  @@map("survey_options")
}

/// 사용자 설문 참여 테이블
/// 사용자가 설문에 참여한 실제 답변 데이터를 저장
model SurveyAnswer {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  surveyOptionId   Int            @map("survey_option_id")
  surveyQuestionId Int            @map("survey_question_id")
  type             String
  createdAt        DateTime       @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")
  userChallengeId  Int?           @map("user_challenge_id")
  surveyOption     SurveyOption   @relation(fields: [surveyOptionId], references: [id])
  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id], onDelete: Cascade)
  userChallenge    UserChallenge? @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyQuestionId, type])
  @@unique([userChallengeId, surveyQuestionId, type])
  @@index([userId])
  @@index([userChallengeId])
  @@index([createdAt])
  @@map("survey_answers")
}

/// 건강 유형별 동물 캐릭터 테이블
/// 설문 결과에 따른 건강 유형별 동물 캐릭터 정보를 저장
model HealthTypeAnimal {
  id                  Int                       @id @default(autoincrement())
  healthType          String                    @unique(map: "category_details_category_code_key") @map("health_type") @db.VarChar(50)
  typeName            String                    @map("type_name") @db.VarChar(50)
  animalName          String                    @map("animal_name") @db.VarChar(50)
  catchphrase         String
  symptoms            String
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime?                 @updatedAt @map("updated_at")
  /// 유형 설명
  description         String?
  /// 어떻게 해결할 수 있나요?
  solution            String?
  /// 대표 이미지 URL
  imageUrl            String?                   @map("image_url") @db.VarChar(500)
  /// 메타데이터 JSON (synergyEffects, intakeGuide, dietRecommendation)
  metadata            Json?
  /// 활성화 여부
  isActive            Boolean                   @default(true) @map("is_active")
  images              HealthTypeAnimalFile[]
  recommendedProducts HealthTypeAnimalProduct[]
  users               User[]

  @@map("health_type_animals")
}

/// 건강 타입 동물 파일 관계 테이블
/// health_type_animals -< health_type_animal_files >- files 다대다 관계
model HealthTypeAnimalFile {
  id                 Int              @id @default(autoincrement())
  /// 건강 타입 동물 ID
  healthTypeAnimalId Int              @map("health_type_animal_id")
  /// 파일 ID
  fileId             Int              @map("file_id")
  /// 이미지 타입 (THUMBNAIL: 썸네일, DESCRIPTION: 설명 이미지)
  imageType          String           @map("image_type") @db.VarChar(20)
  /// 정렬 순서 (같은 타입 내 정렬)
  sortOrder          Int              @default(0) @map("sort_order")
  /// 생성일시
  createdAt          DateTime         @default(now()) @map("created_at")
  file               File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  healthTypeAnimal   HealthTypeAnimal @relation(fields: [healthTypeAnimalId], references: [id], onDelete: Cascade)

  @@index([healthTypeAnimalId, imageType, sortOrder])
  @@index([fileId])
  @@map("health_type_animal_files")
}

/// 포인트 내역 테이블
/// 사용자의 포인트 적립/사용 내역 관리
model PointHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String
  amount      Int
  balance     Int
  description String
  relatedType String?  @map("related_type")
  relatedId   Int?     @map("related_id")
  recordType  String?  @map("record_type") @db.VarChar(50)
  createdAt   DateTime @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("point_histories")
}

/// 미션 정의 테이블
/// 챌린지에서 수행할 모든 미션 타입 정의
model Mission {
  id                    Int                @id @default(autoincrement())
  name                  String
  description           String?
  points                Int
  requireUpload         Boolean            @default(false) @map("require_upload")
  sortOrder             Int                @map("sort_order")
  isActive              Boolean            @default(true) @map("is_active")
  createdAt             DateTime           @map("created_at")
  updatedAt             DateTime?          @updatedAt @map("updated_at")
  category              String             @default("DAILY")
  type                  String             @default("MISSION") @db.VarChar(20)
  recordType            String             @unique @map("record_type") @db.VarChar(50)
  dailyLimit            Int?               @map("daily_limit")
  specificDay           Int?               @map("specific_day")
  totalDays             Int                @default(21) @map("total_days")
  uploadType            String?            @map("upload_type")
  allowedUserTypes      String[]           @default([]) @map("allowed_user_types")
  frequency             String             @default("DAILY") @map("frequency") @db.VarChar(20)
  maxPointsPerDay       Int?               @map("max_points_per_day")
  prerequisiteMissionId Int?               @map("prerequisite_mission_id")
  recordableFromDay     Int?               @map("recordable_from_day")
  recordableToDay       Int?               @map("recordable_to_day")
  recordableUserTypes   String[]           @default([]) @map("recordable_user_types")
  visibleFromDay        Int?               @map("visible_from_day")
  visibleToDay          Int?               @map("visible_to_day")
  visibleAfterSettings  Json?              @map("visible_after_settings")
  dailyTimeLimitMinutes Int?               @map("daily_time_limit_minutes")
  targetProductIds      Int[]              @default([]) @map("target_product_ids")
  pointsConfig          Json?              @map("points_config") // 계급별 포인트 지급 설정 { "CHALLENGER": { "untilDay": 21 }, "SUBSCRIBER": { "unlimited": true } }
  challengeMissions     ChallengeMission[]
  dailyMissions         DailyMission[]
  missionQuizzes        MissionQuiz[]

  @@index([category, isActive])
  @@index([sortOrder])
  @@index([type, isActive])
  @@map("missions")
}

/// 데일리 미션 마스터 테이블
/// 일차별 미션 내용을 관리 (Mission과 연결)
model DailyMission {
  id          Int       @id @default(autoincrement())
  day         Int
  title       String
  description String?
  verifyType  String    @map("verify_type") @db.VarChar(20)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  points      Int       @default(100)
  reason      String?
  method      String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  missionId   Int       @map("mission_id")
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, day])
  @@index([missionId])
  @@index([day])
  @@index([isActive])
  @@map("daily_missions")
}

/// 챌린지-미션 연결 테이블
/// 각 상품(챌린지 이용권)에서 사용할 미션과 일차별 매핑
model ChallengeMission {
  id           Int           @id @default(autoincrement())
  productId    Int           @map("product_id")
  missionId    Int           @map("mission_id")
  day          Int
  points       Int           @default(100)
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")
  mission      Mission       @relation(fields: [missionId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  userMissions UserMission[]

  @@unique([productId, missionId, day])
  @@index([productId, day])
  @@index([missionId])
  @@map("challenge_missions")
}

/// 챌린지-설문 연결 테이블
/// 각 상품(챌린지 이용권)에서 사용할 설문을 일차별로 관리
model ChallengeSurvey {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  surveyId  Int       @map("survey_id")
  day       Int
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  product   Product   @relation(fields: [productId], references: [id])
  survey    Survey    @relation(fields: [surveyId], references: [id])

  @@unique([productId, surveyId, day])
  @@index([productId, day])
  @@index([surveyId])
  @@map("challenge_surveys")
}

/// 퀴즈 마스터 테이블
/// 순수 퀴즈 데이터만 관리 (종속성 없음)
/// 강의 퀴즈, 미션 퀴즈 모두 MissionQuiz, LectureQuiz 관계 테이블로 매핑
model Quiz {
  id             Int           @id @default(autoincrement())
  question       String
  options        Json
  correctAnswer  Int           @map("correct_answer")
  points         Int?          @default(300)
  isActive       Boolean?      @default(true) @map("is_active")
  createdAt      DateTime?     @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamp(6)
  explanation    String?
  lectureQuizzes LectureQuiz[]
  missionQuizzes MissionQuiz[]
  attempts       QuizAttempt[]

  @@map("quizzes")
}

/// 퀴즈 시도 기록 테이블
/// 사용자의 퀴즈 답변 기록 (강의 퀴즈용)
/// - 여러 번 시도 가능 (오답 재도전)
/// - 포인트는 최초 1회만 지급
model QuizAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  quizId         Int      @map("quiz_id")
  contentId      Int?     @map("content_id")
  selectedAnswer Int      @map("selected_answer")
  isCorrect      Boolean  @map("is_correct")
  pointsEarned   Int      @map("points_earned")
  createdAt      DateTime @map("created_at")
  content        Content? @relation(fields: [contentId], references: [id])
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId], map: "idx_quiz_attempts_content_id")
  @@index([quizId], map: "idx_quiz_attempts_quiz_id")
  @@index([userId], map: "idx_quiz_attempts_user_id")
  @@map("quiz_attempts")
}

/// 미션-퀴즈 연결 테이블
/// 미션과 퀴즈를 일차별로 연결
/// 올바른 관계: 챌린지 → ChallengeMission → Mission → MissionQuiz → Quiz
model MissionQuiz {
  id        Int       @id @default(autoincrement())
  missionId Int       @map("mission_id")
  quizId    Int       @map("quiz_id")
  day       Int
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  mission   Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([missionId, quizId, day], map: "uq_mission_quizzes_mission_quiz_day")
  @@index([missionId, day], map: "idx_mission_quizzes_mission_day")
  @@index([missionId], map: "idx_mission_quizzes_mission_id")
  @@index([quizId], map: "idx_mission_quizzes_quiz_id")
  @@map("mission_quizzes")
}

/// 챌린지 구매권 테이블
/// 주문을 통해 획득한 챌린지 수행권 (상품 기반)
model ChallengeTicket {
  id             Int             @id @default(autoincrement())
  userId         Int             @map("user_id")
  productId      Int?            @map("product_id")
  orderItemId    Int?            @map("order_item_id")
  purchaseDate   DateTime        @map("purchase_date")
  status         String          @default("PURCHASED") @db.VarChar(20)
  createdAt      DateTime        @map("created_at")
  updatedAt      DateTime?       @updatedAt @map("updated_at")
  ticketType     String          @default("CHALLENGE") @map("ticket_type") @db.VarChar(20)
  startDate      DateTime?       @map("start_date")
  endDate        DateTime?       @map("end_date")
  seq            Int             @default(1) @map("seq")
  orderItem      OrderItem?      @relation(fields: [orderItemId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  iapReceipt     IAPReceipt?
  userChallenges UserChallenge[]

  @@unique([orderItemId, seq])
  @@index([userId, status, ticketType])
  @@map("challenge_tickets")
}

/// 사용자별 활성 챌린지
/// 활성화된 챌린지 진행 상황 관리 (상품 기반)
model UserChallenge {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  productId           Int             @map("product_id")
  ticketId            Int             @map("ticket_id")
  activatedAt         DateTime        @map("activated_at")
  expiresAt           DateTime        @map("expires_at")
  totalPoints         Int             @default(0) @map("total_points")
  status              String          @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime        @map("created_at")
  updatedAt           DateTime?       @updatedAt @map("updated_at")
  deliveryArrivalDate DateTime?       @map("delivery_arrival_date") @db.Date
  purchasedAt         DateTime        @map("purchased_at")
  deliveryStartDate   DateTime?       @map("delivery_start_date") @db.Date
  /// 챌린지 홈 최초 진입 여부 (true: 첫 진입, false: 재진입)
  isFirstEntry        Boolean         @default(true) @map("is_first_entry")
  /// 챌린지 종료 후 첫 접속 여부 (true: 첫 접속, false: 재접속)
  isFirstChallengeEnd Boolean         @default(true) @map("is_first_challenge_end")
  /// 시작일 설정 시점 (null = 미설정)
  startDateSetAt      DateTime?       @map("start_date_set_at")
  dailyProgress       DailyProgress[]
  surveyAnswers       SurveyAnswer[]
  product             Product         @relation(fields: [productId], references: [id])
  ticket              ChallengeTicket @relation(fields: [ticketId], references: [id])
  user                User            @relation(fields: [userId], references: [id])
  userMissions        UserMission[]
  userRecords         UserRecord[]

  @@index([userId, status])
  @@map("user_challenges")
}

/// 일별 진행 상황
/// 사용자 챌린지의 일차별 진행 상황 관리
model DailyProgress {
  id                 Int           @id @default(autoincrement())
  userChallengeId    Int           @map("user_challenge_id")
  day                Int
  date               DateTime      @db.Date
  missionsTotal      Int           @default(0) @map("missions_total")
  missionsCompleted  Int           @default(0) @map("missions_completed")
  surveysTotal       Int           @default(0) @map("surveys_total")
  surveysCompleted   Int           @default(0) @map("surveys_completed")
  quizzesTotal       Int           @default(0) @map("quizzes_total")
  quizzesCorrect     Int           @default(0) @map("quizzes_correct")
  contentsTotal      Int           @default(0) @map("contents_total")
  contentsViewed     Int           @default(0) @map("contents_viewed")
  trackingsTotal     Int           @default(0) @map("trackings_total")
  trackingsCompleted Int           @default(0) @map("trackings_completed")
  pointsEarned       Int           @default(0) @map("points_earned")
  createdAt          DateTime      @map("created_at")
  updatedAt          DateTime?     @updatedAt @map("updated_at")
  userChallenge      UserChallenge @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)

  @@unique([userChallengeId, day])
  @@index([userChallengeId])
  @@map("daily_progress")
}

/// 운동 종목 마스터 테이블
/// 활동 기록에서 사용할 운동 종목들
model ExerciseType {
  id          Int       @id @default(autoincrement())
  /// 운동 종목명
  name        String    @db.VarChar(50)
  /// 운동 종목 코드 (WALKING, RUNNING, WEIGHT_TRAINING 등)
  code        String    @unique @db.VarChar(50)
  /// 칼로리 계수 (10분당 소모 칼로리)
  calorieRate Float?    @map("calorie_rate")
  /// 정렬 순서
  sortOrder   Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime  @map("created_at")
  /// 수정일시
  updatedAt   DateTime? @updatedAt @map("updated_at")
  /// 기준 시간 (분 단위, 기본값: 10분)
  baseMinutes Int       @default(10) @map("base_minutes")

  @@index([sortOrder])
  @@map("exercise_types")
}

/// 사용자 기록 데이터
/// 사용자의 실제 기록 데이터 (수면, 식단, 운동 등)
model UserRecord {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  userChallengeId Int?           @map("user_challenge_id")
  recordType      String         @map("record_type") @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime?      @updatedAt @map("updated_at")
  date            DateTime       @db.Date
  userMissions    UserMission[]
  userChallenge   UserChallenge? @relation(fields: [userChallengeId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@index([userChallengeId])
  @@index([userId, recordType, date])
  @@map("user_records")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

/// 상품 마스터 테이블
/// 판매 상품의 기본 정보 관리
model Product {
  id                           Int                            @id @default(autoincrement())
  /// 재고 관리 코드 (재고 API 연동용)
  sku                          String                         @unique @db.VarChar(100)
  /// 상품명
  name                         String                         @db.VarChar(255)
  /// 상품 설명
  description                  String?
  /// 상품 타입 (SINGLE: 단품, SET: 세트)
  productType                  String                         @default("SINGLE") @map("product_type") @db.VarChar(20)
  /// 세트 구성 정보 [{"sku": "P001", "name": "상품1", "qty": 2}]
  setItems                     Json?                          @map("set_items")
  /// 상품 상세 정보 (성분, 사용법, 주의사항 등)
  productInfo                  Json?                          @map("product_info")
  /// 상태 (ACTIVE: 활성, INACTIVE: 비활성, SOLD_OUT: 품절)
  status                       String                         @default("ACTIVE") @db.VarChar(20)
  /// 추천 상품 여부
  isFeatured                   Boolean                        @default(false) @map("is_featured")
  /// 조회수
  viewCount                    Int                            @default(0) @map("view_count")
  /// 생성일시
  createdAt                    DateTime                       @map("created_at")
  /// 수정일시
  updatedAt                    DateTime?                      @updatedAt @map("updated_at")
  /// 카테고리 코드 (SUPPLEMENT, HEALTH_FOOD 등)
  categoryCode                 String                         @map("category_code") @db.VarChar(50)
  /// 카테고리명 (영양제, 건강 보조 식품 등)
  categoryName                 String                         @map("category_name") @db.VarChar(100)
  /// 할인율 (%)
  discountRate                 Int?                           @default(0) @map("discount_rate")
  /// 무료배송 기준 금액
  freeShippingAmount           Decimal?                       @map("free_shipping_amount") @db.Decimal(10, 0)
  /// 1인당 최대 주문 수량
  maxOrderQty                  Int                            @default(10) @map("max_order_qty")
  /// 정가 (할인 전 가격)
  originalPrice                Decimal?                       @map("original_price") @db.Decimal(10, 0)
  /// 적립 포인트율 (%)
  pointRate                    Int                            @default(1) @map("point_rate")
  /// 기본 판매 가격 (옵션 없는 경우)
  price                        Decimal?                       @db.Decimal(10, 0)
  /// 배송비
  shippingFee                  Decimal                        @default(3000) @map("shipping_fee") @db.Decimal(10, 0)
  /// 배송비 정책 (FREE: 무료, PAID: 유료, CONDITIONAL: 조건부)
  shippingPolicy               String                         @default("CONDITIONAL") @map("shipping_policy") @db.VarChar(20)
  /// 상품 무게 (배송비 계산용, g)
  weight                       Int?                           @default(0)
  /// 상품 태그 (검색용, 쉼표 구분)
  tags                         String?
  /// 챌린지 메타데이터 (challengeType, totalDays, description 등)
  metadata                     Json?
  /// 라인업 ID (식단용)
  lineupId                     Int?                           @map("lineup_id")
  /// 칼로리 (식단용)
  calories                     Decimal?                       @db.Decimal(6, 1)
  /// 순탄수화물 (식단용)
  netCarbs                     Decimal?                       @map("net_carbs") @db.Decimal(5, 1)
  /// 단백질 (식단용)
  protein                      Decimal?                       @db.Decimal(5, 1)
  /// 지방 (식단용)
  fat                          Decimal?                       @db.Decimal(5, 1)
  /// 식이섬유 (식단용)
  fiber                        Decimal?                       @db.Decimal(5, 1)
  cartItems                    CartItem[]
  challengeMissions            ChallengeMission[]
  challengeSurveys             ChallengeSurvey[]
  challengeTickets             ChallengeTicket[]
  challengeContents            Content[]                      @relation("ChallengeContents")
  coupons                      Coupon[]
  couponProducts               CouponProduct[]
  healthTypeAnimalProducts     HealthTypeAnimalProduct[]
  iapProducts                  IAPProduct[]
  lectureProducts              LectureProduct[]
  orderItems                   OrderItem[]
  feedback                     ProductFeedback[]
  productFiles                 ProductFile[]
  lineup                       ProductLineup?                 @relation(fields: [lineupId], references: [id])
  recentlyViewed               RecentlyViewed[]
  supplementNutrients          SupplementNutrient[]
  userChallengeSurveyResults   UserChallengeSurveyResult[]
  userChallenges               UserChallenge[]
  userSupplementRoutine        UserSupplementRoutine[]        @relation("UserSupplementRoutineProduct")
  userSupplementRoutineHistory UserSupplementRoutineHistory[] @relation("UserSupplementRoutineHistoryProduct")
  wishlistItems                Wishlist[]

  @@index([sku])
  @@index([categoryCode, status])
  @@index([lineupId])
  @@map("products")
}

/// 상품 파일 관계 테이블
/// products -< product_files >- files 다대다 관계
model ProductFile {
  id        Int      @id @default(autoincrement())
  /// 상품 ID
  productId Int      @map("product_id")
  /// 파일 ID
  fileId    Int      @map("file_id")
  /// 이미지 타입 (MAIN: 실물상품이미지, CONTENT: 상품내용이미지)
  imageType String   @map("image_type") @db.VarChar(20)
  /// 정렬 순서
  sortOrder Int      @default(0) @map("sort_order")
  /// 대체 텍스트
  altText   String?  @map("alt_text") @db.VarChar(200)
  /// 생성일시
  createdAt DateTime @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, imageType, sortOrder])
  @@map("product_files")
}

/// 장바구니 테이블
/// 사용자별 장바구니 관리
model Cart {
  id        Int        @id @default(autoincrement())
  /// 사용자 ID
  userId    Int        @unique @map("user_id")
  /// 생성일시
  createdAt DateTime   @map("created_at")
  /// 수정일시
  updatedAt DateTime?  @updatedAt @map("updated_at")
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

/// 장바구니 아이템 테이블
/// 장바구니에 담긴 상품 정보
model CartItem {
  id             Int       @id @default(autoincrement())
  /// 장바구니 ID
  cartId         Int       @map("cart_id")
  /// 상품 ID
  productId      Int       @map("product_id")
  /// 수량
  quantity       Int       @default(1)
  /// 재고 확인 시각
  stockCheckedAt DateTime? @map("stock_checked_at")
  /// 재고 가용 여부
  stockAvailable Boolean   @default(true) @map("stock_available")
  /// 추가일시
  addedAt        DateTime  @map("added_at")
  /// 수정일시
  updatedAt      DateTime? @updatedAt @map("updated_at")
  cart           Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

/// 주문 테이블
/// 주문 정보 관리
model Order {
  id                Int              @id @default(autoincrement())
  /// 주문번호 (O20250814115621567 형식)
  orderNumber       String           @unique @map("order_number") @db.VarChar(50)
  /// 사용자 ID
  userId            Int              @map("user_id")
  /// 주문 상태
  status            String           @default("PENDING_PAYMENT") @db.VarChar(30)
  /// 재고 처리 상태
  inventoryStatus   String           @default("NOT_PROCESSED") @map("inventory_status") @db.VarChar(30)
  /// 상품 총액
  totalProductPrice Decimal          @map("total_product_price") @db.Decimal(10, 0)
  /// 할인 총액
  totalDiscount     Decimal          @default(0) @map("total_discount") @db.Decimal(10, 0)
  /// 배송비
  shippingFee       Decimal          @default(0) @map("shipping_fee") @db.Decimal(10, 0)
  /// 사용 포인트
  pointUsed         Decimal          @default(0) @map("point_used") @db.Decimal(10, 0)
  /// 최종 결제액
  totalAmount       Decimal          @map("total_amount") @db.Decimal(10, 0)
  /// 수령인명 (암호화)
  recipientName     String           @map("recipient_name") @db.VarChar(255)
  /// 수령인 휴대폰번호 (암호화)
  recipientMobile   String           @map("recipient_mobile") @db.VarChar(255)
  /// 우편번호
  postalCode        String           @map("postal_code") @db.VarChar(10)
  /// 주소 (암호화)
  address           String           @db.VarChar(500)
  /// 상세주소 (암호화)
  addressDetail     String?          @map("address_detail") @db.VarChar(500)
  /// 배송 메시지
  deliveryMessage   String?          @map("delivery_message")
  /// 주문일시
  orderedAt         DateTime         @map("ordered_at")
  /// 결제일시
  paidAt            DateTime?        @map("paid_at")
  /// 발송일시
  shippedAt         DateTime?        @map("shipped_at")
  /// 배송완료일시
  deliveredAt       DateTime?        @map("delivered_at")
  /// 구매확정일시
  completedAt       DateTime?        @map("completed_at")
  /// 취소일시
  cancelledAt       DateTime?        @map("cancelled_at")
  /// 생성일시
  createdAt         DateTime         @map("created_at")
  /// 수정일시
  updatedAt         DateTime?        @updatedAt @map("updated_at")
  /// 물류 서비스명 (PLAYAUTO, GOODSFLOW 등)
  logisticsProvider String?          @map("logistics_provider") @db.VarChar(50)
  /// 물류 서비스 주문 고유번호
  logisticsUniq     String?          @map("logistics_uniq") @db.VarChar(50)
  /// 물류 서비스 주문 묶음번호
  logisticsBundleNo String?          @map("logistics_bundle_no") @db.VarChar(50)
  exchangeReturns   ExchangeReturn[]
  items             OrderItem[]
  stateLogs         OrderStateLog[]
  user              User             @relation(fields: [userId], references: [id])
  payment           Payment?
  refundWarranty    RefundWarranty?
  refund            Refund?
  shipping          Shipping?
  usedCoupons       UserCoupon[]

  @@index([userId, status])
  @@index([inventoryStatus])
  @@index([orderNumber])
  @@index([orderedAt])
  @@map("orders")
}

/// 주문 상품 테이블
/// 주문한 상품 상세 정보
model OrderItem {
  id               Int               @id @default(autoincrement())
  /// 주문 ID
  orderId          Int               @map("order_id")
  /// 상품 ID
  productId        Int               @map("product_id")
  /// 상품명 (주문 시점 스냅샷)
  productName      String            @map("product_name") @db.VarChar(255)
  /// 상품 단가
  productPrice     Decimal           @map("product_price") @db.Decimal(10, 0)
  /// 수량
  quantity         Int
  /// 소계 (단가 × 수량)
  subtotal         Decimal           @db.Decimal(10, 0)
  /// 생성일시
  createdAt        DateTime          @map("created_at")
  /// 수정일시
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  challengeTickets ChallengeTicket[]
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  feedback         ProductFeedback?

  @@index([orderId])
  @@map("order_items")
}

/// 주문 상태 변경 로그
/// 주문 상태 변경 이력 추적
model OrderStateLog {
  id           Int      @id @default(autoincrement())
  /// 주문 ID
  orderId      Int      @map("order_id")
  /// 이전 상태
  fromStatus   String?  @map("from_status") @db.VarChar(50)
  /// 변경된 상태
  toStatus     String   @map("to_status") @db.VarChar(50)
  /// 변경한 사용자 ID (NULL이면 시스템)
  changedBy    Int?     @map("changed_by")
  /// 변경 사유
  changeReason String?  @map("change_reason")
  /// 생성일시
  createdAt    DateTime @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_state_logs")
}

/// 결제 정보 테이블
/// 주문 결제 정보 관리
model Payment {
  id              Int          @id @default(autoincrement())
  /// 주문 ID
  orderId         Int          @unique @map("order_id")
  /// PG사 (TOSS: 토스페이먼츠)
  pgProvider      String       @default("TOSS") @map("pg_provider") @db.VarChar(20)
  /// PG사 거래번호
  pgTransactionId String?      @unique @map("pg_transaction_id") @db.VarChar(100)
  /// 결제수단
  paymentMethod   String       @map("payment_method") @db.VarChar(30)
  /// 결제 상태
  status          String       @default("READY") @db.VarChar(30)
  /// PG사 결제 금액
  amount          Decimal      @db.Decimal(10, 0)
  /// 포인트 결제 금액
  pointAmount     Decimal      @default(0) @map("point_amount") @db.Decimal(10, 0)
  /// 결제 상세 정보 (암호화 필요)
  paymentDetails  Json?        @map("payment_details")
  /// 요청일시
  requestedAt     DateTime     @map("requested_at")
  /// 결제일시
  paidAt          DateTime?    @map("paid_at")
  /// 취소일시
  cancelledAt     DateTime?    @map("cancelled_at")
  /// 실패일시
  failedAt        DateTime?    @map("failed_at")
  /// 실패 사유
  failReason      String?      @map("fail_reason") @db.VarChar(500)
  /// 생성일시
  createdAt       DateTime     @map("created_at")
  /// 수정일시
  updatedAt       DateTime?    @updatedAt @map("updated_at")
  paymentLogs     PaymentLog[]
  order           Order        @relation(fields: [orderId], references: [id])
  refunds         Refund[]

  @@index([status])
  @@index([pgTransactionId])
  @@map("payments")
}

/// 결제 상태 변경 로그 테이블
/// 웹훅을 통한 결제 상태 변경 이력 추적
model PaymentLog {
  id             Int      @id @default(autoincrement())
  /// 결제 ID
  paymentId      Int      @map("payment_id")
  /// 이전 상태
  previousStatus String?  @map("previous_status") @db.VarChar(30)
  /// 변경된 상태
  newStatus      String   @map("new_status") @db.VarChar(30)
  /// 금액 (취소/환불 시)
  amount         Decimal? @db.Decimal(10, 0)
  /// 변경 사유
  reason         String?  @db.VarChar(500)
  /// 토스 웹훅 원본 데이터
  rawData        Json?    @map("raw_data")
  /// 생성일시
  createdAt      DateTime @default(now()) @map("created_at")
  payment        Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_logs")
}

/// 환불 정보 테이블
/// 주문 취소/반품 환불 관리
model Refund {
  id                   Int       @id @default(autoincrement())
  /// 주문 ID
  orderId              Int       @unique @map("order_id")
  /// 결제 ID
  paymentId            Int       @map("payment_id")
  /// 환불 타입 (CANCEL: 취소, RETURN: 반품)
  refundType           String    @map("refund_type") @db.VarChar(20)
  /// 환불 상태
  status               String    @default("REQUESTED") @db.VarChar(20)
  /// 환불 금액
  refundAmount         Decimal   @map("refund_amount") @db.Decimal(10, 0)
  /// 포인트 환불액
  pointRefund          Decimal   @default(0) @map("point_refund") @db.Decimal(10, 0)
  /// 환불 사유
  reason               String    @db.VarChar(200)
  /// 상세 사유
  reasonDetail         String?   @map("reason_detail")
  /// 반품 송장번호
  returnTrackingNumber String?   @map("return_tracking_number") @db.VarChar(100)
  /// 반품 수령일시
  returnReceivedAt     DateTime? @map("return_received_at")
  /// 처리한 관리자 ID
  adminId              Int?      @map("admin_id")
  /// 관리자 메모
  adminMemo            String?   @map("admin_memo")
  /// 요청일시
  requestedAt          DateTime  @map("requested_at")
  /// 완료일시
  completedAt          DateTime? @map("completed_at")
  /// 거절일시
  rejectedAt           DateTime? @map("rejected_at")
  /// 생성일시
  createdAt            DateTime  @map("created_at")
  /// 수정일시
  updatedAt            DateTime? @map("updated_at") @db.Timestamp(6)
  /// PG사 취소 거래 ID
  pgCancelId           String?   @map("pg_cancel_id") @db.VarChar(100)
  /// PG사 취소 응답 (JSON)
  pgResponse           Json?     @map("pg_response")
  /// PG사 (결제 취소 처리한 PG)
  pgProvider           String?   @map("pg_provider") @db.VarChar(20)
  order                Order     @relation(fields: [orderId], references: [id])
  payment              Payment   @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@index([requestedAt])
  @@map("refunds")
}

/// 환불 정책 테이블
/// 환불 가능 기간 등 정책 관리
model RefundPolicy {
  id               Int      @id @default(autoincrement())
  /// 정책명
  name             String   @db.VarChar(100)
  /// 반품 가능 기간 (일)
  returnPeriodDays Int      @default(7) @map("return_period_days")
  /// 자동 구매확정 기간 (일)
  autoConfirmDays  Int      @default(7) @map("auto_confirm_days")
  /// 활성화 여부
  isActive         Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt        DateTime @map("created_at")

  @@map("refund_policies")
}

/// 상품 피드백 통합 테이블 (리뷰 + 문의)
/// 상품에 대한 고객 피드백을 통합 관리
model ProductFeedback {
  id             Int               @id @default(autoincrement())
  /// 상품 ID
  productId      Int               @map("product_id")
  /// 사용자 ID
  userId         Int               @map("user_id")
  /// 피드백 타입 (REVIEW: 리뷰, QUESTION: 문의)
  feedbackType   String            @map("feedback_type") @db.VarChar(20)
  /// 원글 ID (답글인 경우)
  parentId       Int?              @map("parent_id")
  /// 주문 상품 ID (리뷰인 경우 구매 확인용)
  orderItemId    Int?              @unique @map("order_item_id")
  /// 제목
  title          String?           @db.VarChar(200)
  /// 내용
  content        String
  /// 상태 (ACTIVE, HIDDEN, DELETED)
  status         String            @default("ACTIVE") @db.VarChar(20)
  /// 생성일시
  createdAt      DateTime          @map("created_at")
  /// 수정일시
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  /// 별점 (1~5, 리뷰인 경우만)
  rating         Int?
  /// 리뷰 타입 (TEXT, PHOTO, VIDEO)
  reviewType     String?           @map("review_type") @db.VarChar(20)
  /// 미디어 URL 배열
  mediaUrls      Json?             @map("media_urls")
  /// 베스트 리뷰 여부
  isBest         Boolean           @default(false) @map("is_best")
  /// 베스트 선정일시
  bestSelectedAt DateTime?         @map("best_selected_at")
  /// 도움됨 수
  helpfulCount   Int               @default(0) @map("helpful_count")
  /// 문의 타입 (PRODUCT, DELIVERY, STOCK, SIZE, OTHER)
  questionType   String?           @map("question_type") @db.VarChar(20)
  /// 비밀글 여부
  isSecret       Boolean           @default(false) @map("is_secret")
  /// 답변 여부
  hasAnswer      Boolean           @default(false) @map("has_answer")
  /// 답변한 관리자 ID
  answeredBy     Int?              @map("answered_by")
  /// 답변일시
  answeredAt     DateTime?         @map("answered_at")
  /// 숨김 사유
  hiddenReason   String?           @map("hidden_reason") @db.VarChar(200)
  /// 지급된 적립금 금액
  rewardAmount   Int?              @map("reward_amount")
  /// 적립금 지급 여부
  rewardGiven    Boolean           @default(false) @map("reward_given")
  /// 적립금 지급일시
  rewardedAt     DateTime?         @map("rewarded_at")
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id])
  parent         ProductFeedback?  @relation("FeedbackReply", fields: [parentId], references: [id])
  replies        ProductFeedback[] @relation("FeedbackReply")
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id])

  @@index([productId, feedbackType, status])
  @@index([userId])
  @@index([parentId])
  @@index([feedbackType, rating])
  @@index([feedbackType, hasAnswer])
  @@index([isBest])
  @@index([rewardGiven])
  @@map("product_feedback")
}

/// 찜하기 테이블
/// 사용자의 찜한 상품
model Wishlist {
  id        Int      @id @default(autoincrement())
  /// 사용자 ID
  userId    Int      @map("user_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

/// 최근 본 상품 테이블
/// 사용자가 최근에 조회한 상품
model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  /// 사용자 ID
  userId    Int      @map("user_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 조회일시
  viewedAt  DateTime @map("viewed_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

/// AI 페르소나 테이블
