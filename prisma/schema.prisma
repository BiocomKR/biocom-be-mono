/// 앱 이벤트 로그 테이블
/// 앱에서 발생하는 모든 커스텀 이벤트를 저장 (GA4 대체/보조)
model AppEvent {
  id            Int      @id @default(autoincrement())
  eventName     String   @map("event_name") @db.VarChar(100)
  userId        Int?     @map("user_id")
  params        Json?
  createdAt     DateTime @default(now()) @map("created_at")
  platform      String   @db.VarChar(20)
  amount        Decimal? @db.Decimal(12, 2)
  appId         String   @default("innerbeauty_challenge") @map("app_id") @db.VarChar(50)
  eventCategory String?  @map("event_category") @db.VarChar(50)
  itemId        String?  @map("item_id") @db.VarChar(100)
  itemType      String?  @map("item_type") @db.VarChar(50)
  quantity      Int?
  sessionId     String?  @map("session_id") @db.VarChar(100)

  @@index([appId, eventName, createdAt])
  @@index([appId, eventCategory, createdAt])
  @@index([userId, createdAt])
  @@index([itemId, itemType])
  @@index([eventCategory, itemType, createdAt])
  @@index([platform])
  @@map("app_events")
}

/// IAP 상품 마스터 테이블
/// App Store / Play Store에 등록된 IAP 상품 정보를 관리
model IAPProduct {
  id              Int            @id @default(autoincrement())
  /// Apple App Store 상품 ID (com.BiocomChallenge.consumable.xxx)
  appleProductId  String?        @unique @map("apple_product_id") @db.VarChar(200)
  /// Google Play 상품 ID (challenge_xxx)
  googleProductId String?        @unique @map("google_product_id") @db.VarChar(200)
  /// 내부 상품 ID (products 테이블과 매핑)
  productId       Int            @map("product_id")
  /// IAP 상품 타입
  productType     IAPProductType @map("product_type")
  /// 상품명 (관리용)
  name            String         @db.VarChar(200)
  /// 상품 설명
  description     String?
  /// 활성화 여부
  isActive        Boolean        @default(true) @map("is_active")
  /// 생성일시
  createdAt       DateTime       @default(now()) @map("created_at")
  /// 수정일시
  updatedAt       DateTime?      @updatedAt @map("updated_at")
  product         Product        @relation(fields: [productId], references: [id])
  receipts        IAPReceipt[]

  @@index([productId])
  @@index([isActive])
  @@map("iap_products")
}

/// IAP 영수증 검증 기록 테이블
/// Apple/Google 영수증 검증 내역 및 구매 이력 관리
model IAPReceipt {
  id                    Int              @id @default(autoincrement())
  /// 사용자 ID
  userId                Int              @map("user_id")
  /// IAP 상품 ID
  iapProductId          Int              @map("iap_product_id")
  /// 플랫폼 (APPLE, GOOGLE)
  platform              IAPPlatform
  /// 플랫폼 트랜잭션 ID (Apple: transactionId, Google: orderId)
  transactionId         String           @unique @map("transaction_id") @db.VarChar(200)
  /// 원본 트랜잭션 ID (구독 갱신시 최초 구매 트랜잭션 ID)
  originalTransactionId String?          @map("original_transaction_id") @db.VarChar(200)
  /// 구매일시
  purchaseDate          DateTime         @map("purchase_date")
  /// 만료일시 (구독인 경우)
  expiresDate           DateTime?        @map("expires_date")
  /// 원본 영수증 데이터 (Apple: receipt-data, Google: purchaseToken)
  receiptData           String           @map("receipt_data")
  /// 검증 응답 데이터 (JSON)
  verificationResponse  Json?            @map("verification_response")
  /// 영수증 상태
  status                IAPReceiptStatus @default(PENDING)
  /// 환불일시
  refundedAt            DateTime?        @map("refunded_at")
  /// 환불 사유 (Apple revocationReason)
  refundReason          String?          @map("refund_reason") @db.VarChar(200)
  /// 발급된 챌린지 티켓 ID
  challengeTicketId     Int?             @unique @map("challenge_ticket_id")
  /// 생성일시
  createdAt             DateTime         @default(now()) @map("created_at")
  /// 수정일시
  updatedAt             DateTime?        @updatedAt @map("updated_at")
  /// Google Acknowledge 완료일시
  acknowledgedAt        DateTime?        @map("acknowledged_at")
  challengeTicket       ChallengeTicket? @relation(fields: [challengeTicketId], references: [id])
  iapProduct            IAPProduct       @relation(fields: [iapProductId], references: [id])
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([iapProductId])
  @@index([platform])
  @@index([status])
  @@index([originalTransactionId])
  @@index([purchaseDate])
  @@map("iap_receipts")
}

/// IAP 웹훅 로그 테이블
/// Apple S2S Notification / Google RTDN 웹훅 이력 저장
model IAPWebhookLog {
  id               Int         @id @default(autoincrement())
  /// 플랫폼 (APPLE, GOOGLE)
  platform         IAPPlatform
  /// 웹훅 메시지 ID (Apple: signedPayload의 일부, Google: messageId)
  messageId        String      @unique @map("message_id") @db.VarChar(200)
  /// 알림 타입 (Apple: notificationType, Google: notificationType)
  notificationType String      @map("notification_type") @db.VarChar(100)
  /// 알림 하위 타입 (Apple: subtype)
  subtype          String?     @db.VarChar(100)
  /// 원본 페이로드 (JSON)
  payload          Json
  /// 처리 상태 (RECEIVED, PROCESSED, FAILED)
  processStatus    String      @default("RECEIVED") @map("process_status") @db.VarChar(20)
  /// 처리 에러 메시지
  errorMessage     String?     @map("error_message")
  /// 관련 트랜잭션 ID
  transactionId    String?     @map("transaction_id") @db.VarChar(200)
  /// 수신일시
  receivedAt       DateTime    @default(now()) @map("received_at")
  /// 처리완료일시
  processedAt      DateTime?   @map("processed_at")

  @@index([platform])
  @@index([notificationType])
  @@index([processStatus])
  @@index([transactionId])
  @@index([receivedAt])
  @@map("iap_webhook_logs")
}

/// 푸시 템플릿 변수 정의 테이블
/// 개인화 푸시에서 사용 가능한 변수 목록 관리
model PushTemplateVariable {
  /// 고유 ID
  id               Int       @id @default(autoincrement())
  /// 카테고리 (사용자, 건강유형, 페르소나 등)
  category         String    @db.VarChar(50)
  /// 변수 키 (템플릿에서 사용: {{variableKey}})
  variableKey      String    @unique @map("variable_key") @db.VarChar(50)
  /// 표시 이름 (관리자 화면용)
  displayName      String    @map("display_name") @db.VarChar(100)
  /// 설명
  description      String?
  /// 데이터 경로 (user.name, user.healthTypeAnimal.animalName 등)
  dataPath         String    @map("data_path") @db.VarChar(200)
  /// 필요한 관계 로딩 목록 (JSON: ["healthTypeAnimal", "aiPersona"])
  requiredIncludes Json?     @map("required_includes")
  /// null일 때 기본값
  defaultValue     String?   @map("default_value") @db.VarChar(200)
  /// 정렬 순서
  sortOrder        Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive         Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt        DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt        DateTime? @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
  @@map("push_template_variables")
}

/// 푸시 세그먼트 조건 정의 테이블
/// 개인화 푸시에서 사용 가능한 타겟팅 조건 목록 관리
model PushSegmentCondition {
  /// 고유 ID
  id               Int       @id @default(autoincrement())
  /// 카테고리 (사용자, 구매, 챌린지, 접속 등)
  category         String    @db.VarChar(50)
  /// 표시 이름 (관리자 화면용)
  displayName      String    @map("display_name") @db.VarChar(100)
  /// 설명
  description      String?
  /// 조건 키 (프론트엔드에서 사용)
  conditionKey     String    @unique @map("condition_key") @db.VarChar(50)
  /// 필드 표현식 (SQL WHERE절 왼쪽: users.points, (SELECT ...) 등)
  fieldExpression  String    @map("field_expression")
  /// 값 타입 (date, number, boolean, enum)
  valueType        String    @map("value_type") @db.VarChar(20)
  /// enum일 경우 선택지 (JSON: ["M", "F"])
  enumOptions      Json?     @map("enum_options")
  /// 허용된 연산자 목록 (JSON: ["eq", "gte", "lte"])
  allowedOperators Json      @map("allowed_operators")
  /// 정렬 순서
  sortOrder        Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive         Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt        DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt        DateTime? @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
  @@map("push_segment_conditions")
}

/// 앱 버전 관리 테이블
/// 클라이언트 버전 관리, 강제 업데이트, 점검 모드 제어
model AppVersion {
  /// 고유 ID
  id                 Int       @id @default(autoincrement())
  /// 플랫폼 (IOS, ANDROID, WEB)
  platform           String    @db.VarChar(20)
  /// 앱 패키지명/번들ID (예: kr.biocom.challenge, kr.biocom.challenge.dev)
  bundleId           String?   @map("bundle_id") @db.VarChar(100)
  /// 버전 (semver: 1.0.0)
  version            String    @db.VarChar(20)
  /// 빌드 번호 (모바일용)
  buildNumber        Int?      @map("build_number")
  /// 강제 업데이트 여부
  isForceUpdate      Boolean   @default(false) @map("is_force_update")
  /// 점검 모드 여부
  isMaintenanceMode  Boolean   @default(false) @map("is_maintenance_mode")
  /// 점검 안내 메시지
  maintenanceMessage String?   @map("maintenance_message")
  /// 릴리즈 노트
  releaseNotes       String?   @map("release_notes")
  /// 스토어/배포 URL
  storeUrl           String?   @map("store_url") @db.VarChar(500)
  /// 활성화 여부 (현재 최신 버전인지)
  isActive           Boolean   @default(true) @map("is_active")
  /// 배포일
  releasedAt         DateTime? @map("released_at")
  /// 생성일시
  createdAt          DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt          DateTime? @updatedAt @map("updated_at")

  @@unique([platform, bundleId, version])
  @@index([platform, isActive])
  @@index([bundleId, isActive])
  @@map("app_versions")
}

/// 물류 서비스 인증 토큰 테이블
/// 물류 API 호출용 인증 토큰 관리 (24시간 유효)
model LogisticsToken {
  /// 고유 ID (항상 1개만 존재)
  id        Int      @id @default(1)
  /// 물류 서비스명 (PLAYAUTO, GOODSFLOW 등)
  provider  String   @default("PLAYAUTO") @db.VarChar(50)
  /// 인증 토큰 (JWT - 길이가 길어 TEXT 사용)
  token     String
  /// 솔루션 번호 (플레이오토 등 서비스별 고유값)
  solNo     Int      @map("sol_no")
  /// 만료 시각 (발급시각 + 23시간, 1시간 버퍼)
  expiresAt DateTime @map("expires_at")
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("logistics_tokens")
}

/// 물류 서비스 API 호출 로그 테이블
/// API 호출 실패/성공 기록 (디버깅 및 재시도용)
model LogisticsApiLog {
  /// 고유 ID
  id           Int      @id @default(autoincrement())
  /// 물류 서비스명 (PLAYAUTO, GOODSFLOW 등)
  provider     String   @default("PLAYAUTO") @db.VarChar(50)
  /// 주문 ID (주문 관련 API인 경우)
  orderId      Int?     @map("order_id")
  /// API 엔드포인트
  endpoint     String   @db.VarChar(200)
  /// HTTP 메서드
  method       String   @db.VarChar(10)
  /// 요청 데이터
  requestData  Json?    @map("request_data")
  /// 응답 데이터
  responseData Json?    @map("response_data")
  /// 상태 (SUCCESS, FAILED)
  status       String   @db.VarChar(20)
  /// 에러 메시지
  errorMessage String?  @map("error_message")
  /// 재시도 횟수
  retryCount   Int      @default(0) @map("retry_count")
  /// 생성일시
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("logistics_api_logs")
}

/// 사용자 알레르기 검사 리포트
/// 배치 동기화 시 userId 없이 저장 가능 (나중에 유저 조회 시 매핑)
/// chartId는 UserChart와 연결하지 않음 (SIB 데이터에 UserChart 없는 경우 많음)
model UserAllergyReport {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  chartId    String    @unique @map("chart_id") @db.VarChar(50)
  level1     String?
  level2     String?
  level3     String?
  level4     String?
  level5     String?
  animalType String?   @map("animal_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_allergy_reports_user_id")

  @@index([userId], map: "idx_user_allergy_reports_user_id")
  @@map("user_allergy_reports")
}

/// 사용자 대사 기능 검사 리포트
model UserMetabolicReport {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
