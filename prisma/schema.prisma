generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 사용자 테이블
/// 애플리케이션의 모든 사용자 정보를 저장
model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  password       String
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime?      @updatedAt @map("updated_at")
  points         Int            @default(0)
  mobile         String
  name           String
  isActive       Boolean        @default(true) @map("is_active")  // 계정 활성화 상태 (false = 차단)
  deletedAt      DateTime?      @map("deleted_at")               // 회원탈퇴 일시 (논리적 삭제)
  eventUsers     EventUser[]
  fileUploads    FileUpload[]
  pointHistories PointHistory[]
  surveyAnswers  SurveyAnswer[]
  refreshTokens  RefreshToken[]
  
  // 쇼핑몰 관련
  cart           Cart?
  orders         Order[]
  productReviews ProductReview[]
  productQuestions ProductQuestion[]
  wishlist       Wishlist[]
  recentlyViewed RecentlyViewed[]

  @@map("users")
}

/// Refresh Token 테이블
/// 사용자 인증 토큰 갱신을 위한 장기 토큰 저장
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// 파일 업로드 테이블
/// 사용자가 업로드한 파일 정보를 저장
model FileUpload {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @map("user_id")
  originalName       String              @map("original_name")
  filename           String
  mimetype           String
  size               Int
  path               String
  uploadedAt         DateTime            @default(now()) @map("uploaded_at")
  fileType           String              @map("file_type")
  uploadCategory     String              @map("upload_category")
  user               User                @relation(fields: [userId], references: [id])
  missionCompletions MissionCompletion[]

  @@map("file_uploads")
}

/// 컨텐츠 마스터 테이블
/// 재사용 가능한 컨텐츠들을 관리
model Content {
  id            Int             @id @default(autoincrement())
  title         String          @db.VarChar(255)
  content       String          @db.Text
  type          String?         @db.VarChar(50)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime?       @updatedAt @map("updated_at")
  
  eventContents EventContent[]
  contentFiles  ContentFile[]
  
  @@index([type, isActive])
  @@map("contents")
}

/// 컨텐츠 첨부파일 관계 테이블
model ContentFile {
  id          Int       @id @default(autoincrement())
  contentId   Int       @map("content_id")
  fileUrl     String    @map("file_url")
  fileName    String    @map("file_name")
  fileSize    Int       @map("file_size")
  mimeType    String    @map("mime_type")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  @@index([contentId])
  @@map("content_files")
}

/// 이벤트-컨텐츠 관계 테이블
model EventContent {
  id          Int       @id @default(autoincrement())
  eventId     Int       @map("event_id")
  contentId   Int       @map("content_id")
  day         Int
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  
  event       Event     @relation(fields: [eventId], references: [id])
  content     Content   @relation(fields: [contentId], references: [id])
  
  @@unique([eventId, day])
  @@unique([eventId, contentId, day])
  @@index([eventId, isActive])
  @@index([contentId])
  @@index([day])
  @@map("event_contents")
}

/// 아임웹 사이트 정보 테이블
/// 아임웹 API 연동을 위한 인증 정보 저장
model ImwebInfo {
  /// 고유 식별자
  id           Int       @id @default(autoincrement())
  /// 아임웹 사이트 이름 (관리용)
  name         String    @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 ID
  clientId     String    @map("client_id") @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 Secret
  clientSecret String    @map("client_secret") @db.VarChar(255)
  /// 아임웹 사이트 코드 (고유값, API 호출 시 사용)
  siteCode     String    @unique @map("site_code") @db.VarChar(255)
  /// OAuth 인가 코드 수신용 콜백 URI
  redirectUri  String    @map("redirect_uri") @db.VarChar(500)
  /// API 사용 권한 범위 (예: member-info:read site-info:write)
  scope        String    @db.VarChar(500)
  /// 아임웹 API 액세스 토큰 (2시간 유효)
  accessToken  String?   @map("access_token")
  /// 아임웹 API 리프레시 토큰 (90일 유효)
  refreshToken String?   @map("refresh_token")
  /// 생성 일시
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 수정 일시 (최초 생성 시 null)
  updatedAt    DateTime? @map("updated_at")

  @@map("imweb_info")
}

/// 설문 마스터 테이블
/// 설문 세트를 관리 (예: "기본 건강 설문", "다이어트 설문" 등)
model Survey {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  eventSurveys    EventSurvey[]
  surveyQuestions SurveyQuestion[]

  @@map("surveys")
}

/// 설문지 질문 테이블
/// 설문 조사에 사용되는 모든 질문들을 저장
model SurveyQuestion {
  id            Int            @id @default(autoincrement())
  category      String
  questionText  String         @map("question_text")
  sortOrder     Int            @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  categoryCode  String         @map("category_code")
  surveyId      Int?           @map("survey_id")
  surveyAnswers SurveyAnswer[]
  survey        Survey?        @relation(fields: [surveyId], references: [id])

  @@index([surveyId])
  @@map("survey_questions")
}

/// 옵션 마스터 테이블
/// 설문 응답에 사용되는 공통 옵션들
model SurveyOption {
  id            Int            @id @default(autoincrement())
  optionText    String         @map("option_text")
  score         Int
  createdAt     DateTime       @default(now()) @map("created_at")
  surveyAnswers SurveyAnswer[]

  @@map("survey_options")
}

/// 사용자 설문 참여 테이블
/// 사용자가 설문에 참여한 실제 답변 데이터를 저장
model SurveyAnswer {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  surveyOptionId   Int            @map("survey_option_id")
  surveyQuestionId Int            @map("survey_question_id")
  type             String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")
  eventUserId      Int?           @map("event_user_id")
  eventUser        EventUser?     @relation(fields: [eventUserId], references: [id], onDelete: Cascade)
  surveyOption     SurveyOption   @relation(fields: [surveyOptionId], references: [id])
  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyQuestionId, type])
  @@unique([eventUserId, surveyQuestionId, type])
  @@index([userId])
  @@index([eventUserId])
  @@index([createdAt])
  @@map("survey_answers")
}

/// 카테고리 상세 정보 테이블
/// 각 카테고리별 동물 캐릭터 및 상세 설명 정보를 저장
model CategoryDetail {
  id               Int       @id @default(autoincrement())
  categoryCode     String    @unique @map("category_code")
  categoryType     String    @map("category_type")
  animalCharacter  String    @map("animal_character")
  characterKeyword String    @map("character_keyword")
  detailedFeatures String    @map("detailed_features")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  @@map("category_details")
}

/// 포인트 내역 테이블
/// 사용자의 포인트 적립/사용 내역 관리
model PointHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String
  amount      Int
  balance     Int
  description String
  relatedType String?  @map("related_type")
  relatedId   Int?     @map("related_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("point_histories")
}

/// 미션 정의 테이블
/// 챌린지에서 수행할 모든 미션 타입 정의
model Mission {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  name          String
  description   String?
  points        Int
  requireUpload Boolean           @default(false) @map("require_upload")
  sortOrder     Int               @map("sort_order")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime?         @updatedAt @map("updated_at")
  category      String            @default("DAILY")
  type          String            @default("DAILY") @db.VarChar(20)
  dailyLimit    Int               @default(1) @map("daily_limit")
  specificDay   Int?              @map("specific_day")
  totalDays     Int               @default(21) @map("total_days")
  uploadType    String?           @map("upload_type")
  eventMissions EventMission[]
  schedules     MissionSchedule[]

  @@index([category, isActive])
  @@index([sortOrder])
  @@index([type, isActive])
  @@map("missions")
}

/// 미션 스케줄 테이블
/// 일차별로 다른 미션 내용을 관리 (JSON 기반 유연한 구조)
model MissionSchedule {
  id          Int       @id @default(autoincrement())
  missionId   Int       @map("mission_id")
  day         Int
  title       String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  points      Int       @default(0)
  data        Json
  type        String
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, day])
  @@index([day])
  @@index([type])
  @@map("mission_schedules")
}

/// 이벤트 관리 테이블
/// 챌린지, 프로모션, 캠페인 등 모든 기간 기반 이벤트 관리
model Event {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime       @map("end_date") @db.Date
  totalDays     Int            @default(21) @map("total_days")
  isActive      Boolean        @default(false) @map("is_active")
  description   String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  type          String         @default("CHALLENGE") @db.VarChar(20)
  eventMissions EventMission[]
  eventQuizzes  EventQuiz[]
  eventSurveys  EventSurvey[]
  eventUsers    EventUser[]
  eventContents EventContent[]

  @@index([isActive, startDate])
  @@index([startDate, endDate])
  @@index([type, isActive])
  @@map("events")
}

/// 이벤트별 미션 매핑 테이블
/// 각 이벤트(챌린지)에서 사용할 미션과 포인트를 관리
model EventMission {
  id                 Int                 @id @default(autoincrement())
  eventId            Int                 @map("event_id")
  missionId          Int                 @map("mission_id")
  points             Int
  activeFromDay      Int?                @map("active_from_day")
  activeToDay        Int?                @map("active_to_day")
  isActive           Boolean             @default(true) @map("is_active")
  sortOrder          Int                 @default(0) @map("sort_order")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime?           @updatedAt @map("updated_at")
  event              Event               @relation(fields: [eventId], references: [id])
  mission            Mission             @relation(fields: [missionId], references: [id])
  missionCompletions MissionCompletion[]

  @@unique([eventId, missionId, activeFromDay])
  @@index([eventId, isActive])
  @@index([missionId])
  @@map("event_missions")
}

/// 이벤트별 설문 매핑 테이블
/// 각 이벤트에서 사용할 설문을 관리
model EventSurvey {
  id            Int         @id @default(autoincrement())
  eventId       Int         @map("event_id")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime?   @updatedAt @map("updated_at")
  surveyId      Int         @map("survey_id")
  surveyOptions Json?       @map("survey_options")
  event         Event       @relation(fields: [eventId], references: [id])
  survey        Survey      @relation(fields: [surveyId], references: [id])

  @@unique([eventId, surveyId])
  @@index([eventId, isActive])
  @@index([surveyId])
  @@map("event_surveys")
}

/// 퀴즈 마스터 테이블
/// 재사용 가능한 퀴즈 문제들을 관리
model Quiz {
  id            Int         @id @default(autoincrement())
  title         String      @db.VarChar(255)
  question      String
  options       Json
  correctAnswer Int         @map("correct_answer")
  points        Int?        @default(50)
  category      String?     @db.VarChar(255)
  difficulty    String?     @db.VarChar(50)
  isActive      Boolean?    @default(true) @map("is_active")
  createdAt     DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?   @updatedAt @map("updated_at") @db.Timestamp(6)
  eventQuizzes  EventQuiz[]

  @@map("quizzes")
}

/// 이벤트-퀴즈 관계 테이블
/// 이벤트와 퀴즈를 일차별로 연결
model EventQuiz {
  id          Int          @id @default(autoincrement())
  eventId     Int          @map("event_id")
  day         Int
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  quizId      Int          @map("quiz_id")
  sortOrder   Int?         @default(0) @map("sort_order")
  event       Event        @relation(fields: [eventId], references: [id])
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_event_quiz_quiz")
  quizAnswers QuizAnswer[]

  @@unique([eventId, day])
  @@unique([eventId, quizId, day], map: "unique_event_quiz_day")
  @@index([day])
  @@index([eventId, isActive])
  @@index([eventId, day], map: "idx_event_quizzes_event_day")
  @@index([quizId], map: "idx_event_quizzes_quiz")
  @@map("event_quizzes")
}

/// 이벤트 참여자 관리 테이블
/// 각 이벤트에 참여하는 사용자를 관리
model EventUser {
  id                 Int                 @id @default(autoincrement())
  eventId            Int                 @map("event_id")
  userId             Int                 @map("user_id")
  joinedAt           DateTime            @default(now()) @map("joined_at")
  status             String              @default("ACTIVE")
  completedAt        DateTime?           @map("completed_at")
  totalPoints        Int                 @default(0) @map("total_points")
  completedDays      Int                 @default(0) @map("completed_days")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime?           @updatedAt @map("updated_at")
  event              Event               @relation(fields: [eventId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  missionCompletions MissionCompletion[]
  quizAnswers        QuizAnswer[]
  surveyAnswers      SurveyAnswer[]

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_users")
}

/// 미션 완료 기록 테이블
/// 이벤트 참여자의 미션 수행 기록을 관리
model MissionCompletion {
  id             Int          @id @default(autoincrement())
  eventUserId    Int          @map("event_user_id")
  eventMissionId Int          @map("event_mission_id")
  day            Int
  completedAt    DateTime     @default(now()) @map("completed_at")
  pointsEarned   Int          @map("points_earned")
  fileUploadId   Int?         @map("file_upload_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime?    @updatedAt @map("updated_at")
  eventMission   EventMission @relation(fields: [eventMissionId], references: [id])
  eventUser      EventUser    @relation(fields: [eventUserId], references: [id], onDelete: Cascade)
  fileUpload     FileUpload?  @relation(fields: [fileUploadId], references: [id])

  @@unique([eventUserId, eventMissionId, day])
  @@index([eventUserId, day])
  @@index([eventMissionId])
  @@index([completedAt])
  @@map("mission_completions")
}

/// 퀴즈 답변 테이블
/// 이벤트 참여자의 퀴즈 답변을 관리
model QuizAnswer {
  id             Int       @id @default(autoincrement())
  eventUserId    Int       @map("event_user_id")
  eventQuizId    Int       @map("event_quiz_id")
  selectedAnswer Int       @map("selected_answer")
  isCorrect      Boolean   @map("is_correct")
  pointsEarned   Int       @map("points_earned")
  answeredAt     DateTime  @default(now()) @map("answered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  eventQuiz      EventQuiz @relation(fields: [eventQuizId], references: [id])
  eventUser      EventUser @relation(fields: [eventUserId], references: [id], onDelete: Cascade)

  @@unique([eventUserId, eventQuizId])
  @@index([eventUserId])
  @@index([eventQuizId])
  @@index([answeredAt])
  @@map("quiz_answers")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}
// ===== 카테고리 관련 =====

/// 상품 카테고리 테이블
/// 계층 구조를 지원하는 카테고리 관리
model Category {
  id         Int       @id @default(autoincrement())
  parentId   Int?      @map("parent_id")      /// 상위 카테고리 ID (NULL이면 최상위)
  name       String    @db.VarChar(100)       /// 카테고리명
  slug       String    @unique @db.VarChar(100) /// URL용 슬러그 (예: health-food)
  path       String?   @db.VarChar(500)       /// 전체 경로 (예: /1/3/5/)
  depth      Int       @default(0)            /// 계층 깊이 (0=최상위)
  sortOrder  Int       @default(0) @map("sort_order") /// 정렬 순서
  isActive   Boolean   @default(true) @map("is_active") /// 활성화 여부
  createdAt  DateTime  @default(now()) @map("created_at") /// 생성일시
  updatedAt  DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive, sortOrder])
  @@map("categories")
}

// ===== 상품 관련 =====

/// 상품 마스터 테이블
/// 판매 상품의 기본 정보 관리
model Product {
  id           Int      @id @default(autoincrement())
  sku          String   @unique @db.VarChar(100)  /// 재고 관리 코드 (재고 API 연동용)
  categoryId   Int      @map("category_id")       /// 카테고리 ID
  name         String   @db.VarChar(255)          /// 상품명
  slug         String   @unique @db.VarChar(255)  /// URL용 슬러그
  description  String?  @db.Text                  /// 상품 설명
  productType  String   @default("SINGLE") @map("product_type") @db.VarChar(20) /// 상품 타입 (SINGLE: 단품, SET: 세트)
  setItems     Json?    @map("set_items")         /// 세트 구성 정보 [{"sku": "P001", "name": "상품1", "qty": 2}]
  productInfo  Json?    @map("product_info")      /// 상품 상세 정보 (성분, 사용법, 주의사항 등)
  status       String   @default("ACTIVE") @db.VarChar(20) /// 상태 (ACTIVE: 활성, INACTIVE: 비활성, SOLD_OUT: 품절)
  isFeatured   Boolean  @default(false) @map("is_featured") /// 추천 상품 여부
  viewCount    Int      @default(0) @map("view_count") /// 조회수
  createdAt    DateTime @default(now()) @map("created_at") /// 생성일시
  updatedAt    DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  category       Category         @relation(fields: [categoryId], references: [id])
  options        ProductOption[]
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  questions      ProductQuestion[]
  wishlistItems  Wishlist[]
  recentlyViewed RecentlyViewed[]

  @@index([sku])
  @@index([categoryId, status])
  @@index([slug])
  @@map("products")
}

/// 상품 옵션 테이블
/// 상품의 옵션별 가격 관리 (재고는 외부 API)
model ProductOption {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")         /// 상품 ID
  sku          String   @unique @db.VarChar(100)   /// 옵션별 재고 관리 코드
  optionName   String   @map("option_name") @db.VarChar(100) /// 옵션명 (예: 30정, 60정)
  optionValue  String?  @map("option_value") @db.VarChar(100) /// 옵션값
  price        Decimal  @db.Decimal(10, 0)         /// 판매가격
  maxOrderQty  Int      @default(10) @map("max_order_qty") /// 1인당 최대 주문 수량
  isActive     Boolean  @default(true) @map("is_active") /// 활성화 여부
  sortOrder    Int      @default(0) @map("sort_order") /// 정렬 순서
  createdAt    DateTime @default(now()) @map("created_at") /// 생성일시
  updatedAt    DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  product    Product     @relation(fields: [productId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    ProductReview[]

  @@unique([productId, optionName])
  @@index([sku])
  @@map("product_options")
}

/// 상품 이미지 테이블
/// 상품 이미지 관리
model ProductImage {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")          /// 상품 ID
  imageUrl   String   @map("image_url") @db.VarChar(500) /// 이미지 전체 URL
  imageType  String   @default("SUB") @map("image_type") @db.VarChar(20) /// 이미지 타입 (MAIN: 대표, SUB: 추가, DETAIL: 상세)
  sortOrder  Int      @default(0) @map("sort_order") /// 정렬 순서
  altText    String?  @map("alt_text") @db.VarChar(200) /// 대체 텍스트
  createdAt  DateTime @default(now()) @map("created_at") /// 생성일시

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ===== 장바구니 관련 =====

/// 장바구니 테이블
/// 사용자별 장바구니 관리
model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")     /// 사용자 ID
  createdAt DateTime  @default(now()) @map("created_at") /// 생성일시
  updatedAt DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

/// 장바구니 아이템 테이블
/// 장바구니에 담긴 상품 정보
model CartItem {
  id              Int       @id @default(autoincrement())
  cartId          Int       @map("cart_id")           /// 장바구니 ID
  productId       Int       @map("product_id")        /// 상품 ID
  productOptionId Int       @map("product_option_id") /// 상품 옵션 ID
  quantity        Int       @default(1)               /// 수량
  stockCheckedAt  DateTime? @map("stock_checked_at")  /// 재고 확인 시각
  stockAvailable  Boolean   @default(true) @map("stock_available") /// 재고 가용 여부
  addedAt         DateTime  @default(now()) @map("added_at") /// 추가일시
  updatedAt       DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  cart          Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  productOption ProductOption @relation(fields: [productOptionId], references: [id])

  @@unique([cartId, productOptionId])
  @@index([cartId])
  @@map("cart_items")
}

// ===== 주문 관련 =====

/// 주문 테이블
/// 주문 정보 관리
model Order {
  id               Int       @id @default(autoincrement())
  orderNumber      String    @unique @map("order_number") @db.VarChar(50) /// 주문번호 (O20250814115621567 형식)
  userId           Int       @map("user_id")            /// 사용자 ID
  status           String    @default("PENDING_PAYMENT") @db.VarChar(30) /// 주문 상태
  inventoryStatus  String    @default("NOT_PROCESSED") @map("inventory_status") @db.VarChar(30) /// 재고 처리 상태
  
  // 금액 정보
  totalProductPrice Decimal  @map("total_product_price") @db.Decimal(10, 0) /// 상품 총액
  totalDiscount     Decimal  @default(0) @map("total_discount") @db.Decimal(10, 0) /// 할인 총액
  shippingFee       Decimal  @default(0) @map("shipping_fee") @db.Decimal(10, 0) /// 배송비
  pointUsed         Decimal  @default(0) @map("point_used") @db.Decimal(10, 0) /// 사용 포인트
  totalAmount       Decimal  @map("total_amount") @db.Decimal(10, 0) /// 최종 결제액
  
  // 배송 정보
  recipientName    String   @map("recipient_name") @db.VarChar(100) /// 수령인명
  recipientPhone   String   @map("recipient_phone") @db.VarChar(255) /// 수령인 전화번호 (암호화)
  postalCode       String   @map("postal_code") @db.VarChar(10) /// 우편번호
  address          String   @db.VarChar(255)          /// 주소
  addressDetail    String?  @map("address_detail") @db.VarChar(255) /// 상세주소
  deliveryMessage  String?  @map("delivery_message") @db.Text /// 배송 메시지
  
  // 시간 정보
  orderedAt   DateTime  @default(now()) @map("ordered_at") /// 주문일시
  paidAt      DateTime? @map("paid_at")      /// 결제일시
  shippedAt   DateTime? @map("shipped_at")   /// 발송일시
  deliveredAt DateTime? @map("delivered_at") /// 배송완료일시
  completedAt DateTime? @map("completed_at") /// 구매확정일시
  cancelledAt DateTime? @map("cancelled_at") /// 취소일시
  
  createdAt   DateTime  @default(now()) @map("created_at") /// 생성일시
  updatedAt   DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  user        User              @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?
  refund      Refund?
  shipping    Shipping?
  stateLogs   OrderStateLog[]

  @@index([userId, status])
  @@index([inventoryStatus])
  @@index([orderNumber])
  @@index([orderedAt])
  @@map("orders")
}

/// 주문 상품 테이블
/// 주문한 상품 상세 정보
model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")           /// 주문 ID
  productId       Int      @map("product_id")         /// 상품 ID
  productOptionId Int      @map("product_option_id")  /// 상품 옵션 ID
  productName     String   @map("product_name") @db.VarChar(255) /// 상품명 (주문 시점 스냅샷)
  optionName      String?  @map("option_name") @db.VarChar(100) /// 옵션명 (주문 시점 스냅샷)
  productPrice    Decimal  @map("product_price") @db.Decimal(10, 0) /// 상품 단가
  quantity        Int                                  /// 수량
  subtotal        Decimal  @db.Decimal(10, 0)         /// 소계 (단가 × 수량)
  createdAt       DateTime @default(now()) @map("created_at") /// 생성일시
  updatedAt       DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  productOption ProductOption @relation(fields: [productOptionId], references: [id])
  reviews       ProductReview[]

  @@index([orderId])
  @@map("order_items")
}

/// 주문 상태 변경 로그
/// 주문 상태 변경 이력 추적
model OrderStateLog {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")              /// 주문 ID
  fromStatus   String?  @map("from_status") @db.VarChar(50) /// 이전 상태
  toStatus     String   @map("to_status") @db.VarChar(50) /// 변경된 상태
  changedBy    Int?     @map("changed_by")            /// 변경한 사용자 ID (NULL이면 시스템)
  changeReason String?  @map("change_reason") @db.Text /// 변경 사유
  createdAt    DateTime @default(now()) @map("created_at") /// 생성일시

  // Relations
  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_state_logs")
}

// ===== 결제 관련 =====

/// 결제 정보 테이블
/// 주문 결제 정보 관리
model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique @map("order_id")  /// 주문 ID
  pgProvider      String    @default("TOSS") @map("pg_provider") @db.VarChar(20) /// PG사 (TOSS: 토스페이먼츠)
  pgTransactionId String?   @unique @map("pg_transaction_id") @db.VarChar(100) /// PG사 거래번호
  paymentMethod   String    @map("payment_method") @db.VarChar(30) /// 결제수단
  status          String    @default("READY") @db.VarChar(30) /// 결제 상태
  amount          Decimal   @db.Decimal(10, 0)          /// PG사 결제 금액
  pointAmount     Decimal   @default(0) @map("point_amount") @db.Decimal(10, 0) /// 포인트 결제 금액
  paymentDetails  Json?     @map("payment_details")     /// 결제 상세 정보 (암호화 필요)
  
  // 시간 정보
  requestedAt DateTime  @default(now()) @map("requested_at") /// 요청일시
  paidAt      DateTime? @map("paid_at")       /// 결제일시
  cancelledAt DateTime? @map("cancelled_at")  /// 취소일시
  failedAt    DateTime? @map("failed_at")     /// 실패일시
  failReason  String?   @map("fail_reason") @db.VarChar(500) /// 실패 사유
  
  createdAt   DateTime  @default(now()) @map("created_at") /// 생성일시
  updatedAt   DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([status])
  @@index([pgTransactionId])
  @@map("payments")
}

/// 환불 정보 테이블
/// 주문 취소/반품 환불 관리
model Refund {
  id                   Int       @id @default(autoincrement())
  orderId              Int       @unique @map("order_id")    /// 주문 ID
  paymentId            Int       @map("payment_id")          /// 결제 ID
  refundType           String    @map("refund_type") @db.VarChar(20) /// 환불 타입 (CANCEL: 취소, RETURN: 반품)
  status               String    @default("REQUESTED") @db.VarChar(20) /// 환불 상태
  refundAmount         Decimal   @map("refund_amount") @db.Decimal(10, 0) /// 환불 금액
  pointRefund          Decimal   @default(0) @map("point_refund") @db.Decimal(10, 0) /// 포인트 환불액
  tossCancelId         String?   @map("toss_cancel_id") @db.VarChar(100) /// 토스페이먼츠 취소 ID
  tossResponse         Json?     @map("toss_response")       /// 토스페이먼츠 응답
  reason               String    @db.VarChar(200)            /// 환불 사유
  reasonDetail         String?   @map("reason_detail") @db.Text /// 상세 사유
  returnTrackingNumber String?   @map("return_tracking_number") @db.VarChar(100) /// 반품 송장번호
  returnReceivedAt     DateTime? @map("return_received_at")  /// 반품 수령일시
  adminId              Int?      @map("admin_id")            /// 처리한 관리자 ID
  adminMemo            String?   @map("admin_memo") @db.Text /// 관리자 메모
  
  // 시간 정보
  requestedAt DateTime  @default(now()) @map("requested_at") /// 요청일시
  completedAt DateTime? @map("completed_at") /// 완료일시
  rejectedAt  DateTime? @map("rejected_at")  /// 거절일시
  
  createdAt   DateTime  @default(now()) @map("created_at") /// 생성일시

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@index([requestedAt])
  @@map("refunds")
}

/// 환불 정책 테이블
/// 환불 가능 기간 등 정책 관리
model RefundPolicy {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)            /// 정책명
  returnPeriodDays Int      @default(7) @map("return_period_days") /// 반품 가능 기간 (일)
  autoConfirmDays  Int      @default(7) @map("auto_confirm_days") /// 자동 구매확정 기간 (일)
  isActive         Boolean  @default(true) @map("is_active") /// 활성화 여부
  createdAt        DateTime @default(now()) @map("created_at") /// 생성일시

  @@map("refund_policies")
}

// ===== 배송 관련 =====

/// 배송 정보 테이블
/// 주문 배송 정보 관리
model Shipping {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique @map("order_id")  /// 주문 ID
  courierCode       String?   @map("courier_code") @db.VarChar(20) /// 택배사 코드
  courierName       String?   @map("courier_name") @db.VarChar(50) /// 택배사명
  trackingNumber    String?   @map("tracking_number") @db.VarChar(100) /// 송장번호
  status            String    @default("PREPARING") @db.VarChar(30) /// 배송 상태
  shippingFee       Decimal   @default(0) @map("shipping_fee") @db.Decimal(10, 0) /// 배송비
  shippingPolicyId  Int?      @map("shipping_policy_id") /// 적용된 배송 정책 ID
  deliveryMessage   String?   @map("delivery_message") @db.Text /// 배송 메시지
  adminMemo         String?   @map("admin_memo") @db.Text /// 관리자 메모
  
  // 시간 정보
  readyAt      DateTime? @map("ready_at")      /// 발송준비완료일시
  shippedAt    DateTime? @map("shipped_at")    /// 발송일시
  deliveredAt  DateTime? @map("delivered_at")  /// 배송완료일시
  
  createdAt    DateTime  @default(now()) @map("created_at") /// 생성일시
  updatedAt    DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  order          Order            @relation(fields: [orderId], references: [id])
  shippingPolicy ShippingPolicy?  @relation(fields: [shippingPolicyId], references: [id])
  tracks         ShippingTrack[]

  @@index([trackingNumber])
  @@index([status])
  @@map("shippings")
}

/// 배송 추적 테이블
/// 택배 배송 추적 정보
model ShippingTrack {
  id          Int      @id @default(autoincrement())
  shippingId  Int      @map("shipping_id")           /// 배송 ID
  location    String?  @db.VarChar(200)              /// 현재 위치
  status      String?  @db.VarChar(100)              /// 상태
  description String?  @db.Text                      /// 상세 설명
  trackedAt   DateTime @map("tracked_at")            /// 추적 시각
  rawData     Json?    @map("raw_data")              /// 택배사 API 원본 데이터
  createdAt   DateTime @default(now()) @map("created_at") /// 생성일시

  // Relations
  shipping Shipping @relation(fields: [shippingId], references: [id])

  @@index([shippingId, trackedAt])
  @@map("shipping_tracks")
}

/// 배송비 정책 테이블
/// 배송비 계산 정책 관리
model ShippingPolicy {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(100)         /// 정책명
  baseFee            Decimal   @default(3000) @map("base_fee") @db.Decimal(10, 0) /// 기본 배송비
  freeShippingAmount Decimal?  @map("free_shipping_amount") @db.Decimal(10, 0) /// 무료배송 기준 금액
  jejuExtraFee       Decimal   @default(3000) @map("jeju_extra_fee") @db.Decimal(10, 0) /// 제주 추가비
  islandExtraFee     Decimal   @default(5000) @map("island_extra_fee") @db.Decimal(10, 0) /// 도서산간 추가비
  priority           Int       @default(0)              /// 우선순위
  validFrom          DateTime  @map("valid_from") @db.Date /// 적용 시작일
  validUntil         DateTime? @map("valid_until") @db.Date /// 적용 종료일
  isActive           Boolean   @default(true) @map("is_active") /// 활성화 여부
  isDefault          Boolean   @default(false) @map("is_default") /// 기본 정책 여부
  createdAt          DateTime  @default(now()) @map("created_at") /// 생성일시

  // Relations
  shippings Shipping[]

  @@index([isActive, isDefault])
  @@index([validFrom, validUntil])
  @@map("shipping_policies")
}

// ===== 재고 관리 (외부 API) =====

/// 재고 캐시 테이블
/// 외부 재고 API 응답 캐싱
model InventoryCache {
  sku           String   @id @db.VarChar(100)        /// 재고 관리 코드
  availableQty  Int      @default(0) @map("available_qty") /// 가용 재고
  lastUpdated   DateTime @default(now()) @map("last_updated") /// 마지막 업데이트

  @@index([lastUpdated])
  @@map("inventory_cache")
}

/// 재고 API 로그 테이블
/// 재고 API 호출 이력
model InventoryApiLog {
  id             Int       @id @default(autoincrement())
  apiMethod      String    @map("api_method") @db.VarChar(30) /// API 메서드 (GET_STOCK, DEDUCT_STOCK, RESTORE_STOCK)
  sku            String    @db.VarChar(100)               /// 재고 관리 코드
  requestData    Json?     @map("request_data")           /// 요청 데이터
  responseData   Json?     @map("response_data")          /// 응답 데이터
  responseStatus Int?      @map("response_status")        /// 응답 상태 코드
  errorMessage   String?   @map("error_message") @db.Text /// 에러 메시지
  createdAt      DateTime  @default(now()) @map("created_at") /// 생성일시

  @@index([sku, createdAt])
  @@index([responseStatus])
  @@map("inventory_api_logs")
}

/// 재고 동기화 큐 테이블
/// API 장애 시 재고 동기화 대기열
model InventorySyncQueue {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")              /// 주문 ID
  sku          String    @db.VarChar(100)              /// 재고 관리 코드
  quantity     Int                                      /// 수량
  action       String    @db.VarChar(20)               /// 작업 (DEDUCT: 차감, RESTORE: 복구)
  status       String    @default("PENDING") @db.VarChar(20) /// 상태
  retryCount   Int       @default(0) @map("retry_count") /// 재시도 횟수
  errorMessage String?   @map("error_message") @db.Text /// 에러 메시지
  createdAt    DateTime  @default(now()) @map("created_at") /// 생성일시
  processedAt  DateTime? @map("processed_at")          /// 처리일시

  @@index([status])
  @@index([createdAt])
  @@map("inventory_sync_queue")
}

// ===== 리뷰/문의 =====

/// 상품 리뷰 테이블
/// 구매 상품에 대한 리뷰
model ProductReview {
  id              Int       @id @default(autoincrement())
  productId       Int       @map("product_id")         /// 상품 ID
  productOptionId Int?      @map("product_option_id")  /// 상품 옵션 ID
  userId          Int       @map("user_id")            /// 사용자 ID
  orderItemId     Int       @unique @map("order_item_id") /// 주문 상품 ID (구매 확인)
  rating          Int                                   /// 별점 (1~5)
  title           String?   @db.VarChar(200)           /// 리뷰 제목
  content         String    @db.Text                    /// 리뷰 내용
  reviewType      String    @default("TEXT") @map("review_type") @db.VarChar(20) /// 리뷰 타입 (TEXT, PHOTO, VIDEO)
  mediaUrls       Json?     @map("media_urls")          /// 미디어 URL 배열
  isBest          Boolean   @default(false) @map("is_best") /// 베스트 리뷰 여부
  bestSelectedAt  DateTime? @map("best_selected_at")   /// 베스트 선정일시
  helpfulCount    Int       @default(0) @map("helpful_count") /// 도움됨 수
  status          String    @default("ACTIVE") @db.VarChar(20) /// 상태 (ACTIVE, HIDDEN, DELETED)
  hiddenReason    String?   @map("hidden_reason") @db.VarChar(200) /// 숨김 사유
  createdAt       DateTime  @default(now()) @map("created_at") /// 생성일시
  updatedAt       DateTime? @updatedAt @map("updated_at") /// 수정일시

  // Relations
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productOption ProductOption? @relation(fields: [productOptionId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([productId, status])
  @@index([userId])
  @@index([rating])
  @@index([isBest])
  @@map("product_reviews")
}

/// 상품 문의 테이블
/// 상품에 대한 Q&A
model ProductQuestion {
  id           Int       @id @default(autoincrement())
  productId    Int       @map("product_id")            /// 상품 ID
  userId       Int       @map("user_id")               /// 사용자 ID
  parentId     Int?      @map("parent_id")             /// 원글 ID (답글인 경우)
  questionType String    @map("question_type") @db.VarChar(20) /// 문의 타입 (PRODUCT, DELIVERY, STOCK, SIZE, OTHER)
  title        String    @db.VarChar(200)              /// 문의 제목
  content      String    @db.Text                      /// 문의 내용
  isSecret     Boolean   @default(false) @map("is_secret") /// 비밀글 여부
  hasAnswer    Boolean   @default(false) @map("has_answer") /// 답변 여부
  answeredBy   Int?      @map("answered_by")           /// 답변한 관리자 ID
  answeredAt   DateTime? @map("answered_at")           /// 답변일시
  status       String    @default("ACTIVE") @db.VarChar(20) /// 상태 (ACTIVE, HIDDEN, DELETED)
  createdAt    DateTime  @default(now()) @map("created_at") /// 생성일시

  // Relations
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])
  parent   ProductQuestion?  @relation("QuestionReply", fields: [parentId], references: [id])
  replies  ProductQuestion[] @relation("QuestionReply")

  @@index([productId, status])
  @@index([parentId])
  @@index([hasAnswer])
  @@map("product_questions")
}

// ===== 부가 기능 =====

/// 찜하기 테이블
/// 사용자의 찜한 상품
model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")                  /// 사용자 ID
  productId Int      @map("product_id")               /// 상품 ID
  createdAt DateTime @default(now()) @map("created_at") /// 생성일시

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

/// 최근 본 상품 테이블
/// 사용자가 최근에 조회한 상품
model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")                  /// 사용자 ID
  productId Int      @map("product_id")               /// 상품 ID
  viewedAt  DateTime @default(now()) @map("viewed_at") /// 조회일시

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}