/// 사용자 챗봇 대화 히스토리 (JSONB message 구조)
/// message JSONB 구조:
/// - USER: {"role": "USER", "content": "메시지 내용"}
/// - AI: {"role": "AI", "content": "메시지 내용", "persona_type": "헤이즐", "gender": "F", "cached": false}
model UserChatHistory {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  chartId   String?    @map("chart_id") @db.VarChar(50)
  testType  String?    @map("test_type") @db.VarChar(20)
  message   Json       @map("message")
  createdAt DateTime   @default(now()) @map("created_at")
  userChart UserChart? @relation(fields: [chartId], references: [chartId], onUpdate: NoAction, map: "fk_user_chat_histories_chart_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_chat_histories_user_id")

  @@index([userId], map: "idx_user_chat_histories_user_id")
  @@index([chartId], map: "idx_user_chat_histories_chart_id")
  @@index([userId, createdAt], map: "idx_user_chat_histories_user_created")
  @@map("user_chat_histories")
}

/// 사용자 채팅 일별 요약 (하루 채팅을 1-2문장으로 요약)
