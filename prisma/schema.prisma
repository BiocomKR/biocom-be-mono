/// 문제 신고 테이블
model IssueReport {
  /// 신고 ID
  id         Int       @id @default(autoincrement())
  /// 사용자 ID (백오피스 피드백의 경우 null)
  userId     Int?      @map("user_id")
  /// 신고 내용
  content    String
  /// 관리자 답변
  answer     String?
  /// 답변 일시
  answeredAt DateTime? @map("answered_at")
  /// 앱 버전
  appVersion String?   @map("app_version") @db.VarChar(20)
  /// 디바이스 정보
  deviceInfo String?   @map("device_info") @db.VarChar(200)
  /// 생성일시
  createdAt  DateTime  @default(now()) @map("created_at")
  /// 첨부파일 ID 배열
  fileIds    Int[]     @default([]) @map("file_ids")
  /// 신고 유형 (ISSUE: 불편사항, ACCOUNT_DELETION: 계정삭제요청, BO_FEEDBACK: 백오피스피드백)
  type       String    @default("ISSUE") @db.VarChar(30)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_issue_reports_user_id")
  @@map("issue_reports")
}

/// 식단 라인업 테이블
/// 오리지널, 시그니처, 저속노화, 저포드맵
model ProductLineup {
  id          Int       @id @default(autoincrement())
  /// 라인업 키 (ORIGINAL, SIGNATURE, SLOW_AGING, LOW_FODMAP)
  key         String    @unique @db.VarChar(50)
  /// 라인업명
  name        String    @db.VarChar(100)
  /// 설명
  description String?
  /// 대표 이미지 URL
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  /// 정렬 순서
  sortOrder   Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("product_lineups")
}

/// 앱 설정 테이블
/// 시스템 전역 설정값 관리 (배너 설정, API 키 등)
/// 민감정보는 isEncrypted=true로 암호화 저장
model AppConfig {
  id          Int       @id @default(autoincrement())
  /// 설정 키 (고유)
  configKey   String    @unique @map("config_key") @db.VarChar(100)
  /// 설정 값 (암호화된 경우 암호문 저장)
  configValue String?   @map("config_value") @db.Text
  /// 값 타입 (STRING, NUMBER, JSON, BOOLEAN)
  valueType   String    @default("STRING") @map("value_type") @db.VarChar(20)
  /// 암호화 여부 (민감정보는 true)
  isEncrypted Boolean   @default(false) @map("is_encrypted")
  /// 설명
  description String?   @db.VarChar(255)
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt   DateTime? @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("app_configs")
}

