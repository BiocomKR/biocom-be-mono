generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 사용자 테이블
/// 애플리케이션의 모든 사용자 정보를 저장
model User {
  id                     Int                         @id @default(autoincrement())
  email                  String                      @unique
  password               String
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime?                   @updatedAt @map("updated_at")
  points                 Int                         @default(0)
  mobile                 String
  name                   String
  isActive               Boolean                     @default(true) @map("is_active")
  deletedAt              DateTime?                   @map("deleted_at")
  characterId            Int?                        @map("character_id")
  subscriptionStatus     String                      @default("NEWCOMER") @map("subscription_status") @db.VarChar(20)
  cart                   Cart?
  challengeTickets       ChallengeTicket[]
  contentViews           ContentView[]
  fileUploads            FileUpload[]
  missionAttempts        MissionAttempt[]
  orders                 Order[]
  pointHistories         PointHistory[]
  productFeedback        ProductFeedback[]
  recentlyViewed         RecentlyViewed[]
  refreshTokens          RefreshToken[]
  refundWarranties       RefundWarranty[]
  surveyAnswers          SurveyAnswer[]
  balanceGameHistories   UserBalanceGameHistory[]
  challengeSurveyResults UserChallengeSurveyResult[]
  userChallenges         UserChallenge[]
  userCoupons            UserCoupon[]
  customSupplements      UserCustomSupplement[]
  userRecords            UserRecord[]
  aiPersona              AiPersona?                  @relation(fields: [characterId], references: [id])
  wishlist               Wishlist[]

  @@map("users")
}

/// Refresh Token 테이블
/// 사용자 인증 토큰 갱신을 위한 장기 토큰 저장
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// 파일 업로드 테이블
/// 사용자가 업로드한 파일 정보를 저장
model FileUpload {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  originalName    String           @map("original_name")
  filename        String
  mimetype        String
  size            Int
  path            String
  uploadedAt      DateTime         @default(now()) @map("uploaded_at")
  fileType        String           @map("file_type")
  uploadCategory  String           @map("upload_category")
  user            User             @relation(fields: [userId], references: [id])
  missionAttempts MissionAttempt[]

  @@map("file_uploads")
}

model Content {
  id              Int                @id @default(autoincrement())
  title           String             @db.VarChar(255)
  content         String
  type            String?            @db.VarChar(50)
  weekNumber      Int?               @map("week_number")
  dayNumber       Int?               @map("day_number")
  sortOrder       Int                @default(0) @map("sort_order")
  points          Int                @default(50)
  viewCount       Int                @default(0) @map("view_count")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime?          @updatedAt @map("updated_at")
  accessLevel     ContentAccessLevel @default(ALL) @map("access_level")
  contentFiles    ContentFile[]
  contentViews    ContentView[]
  lectureProducts LectureProduct[]
  lectureQuizzes  LectureQuiz[]

  @@index([type, isActive])
  @@index([accessLevel, type, isActive])
  @@index([weekNumber, dayNumber])
  @@index([sortOrder])
  @@map("contents")
}

/// 컨텐츠 첨부파일 관계 테이블
model ContentFile {
  id        Int      @id @default(autoincrement())
  contentId Int      @map("content_id")
  fileUrl   String   @map("file_url")
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("content_files")
}

/// 아임웹 사이트 정보 테이블
/// 아임웹 API 연동을 위한 인증 정보 저장
model ImwebInfo {
  /// 고유 식별자
  id           Int       @id @default(autoincrement())
  /// 아임웹 사이트 이름 (관리용)
  name         String    @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 ID
  clientId     String    @map("client_id") @db.VarChar(255)
  /// 아임웹 OAuth 클라이언트 Secret
  clientSecret String    @map("client_secret") @db.VarChar(255)
  /// 아임웹 사이트 코드 (고유값, API 호출 시 사용)
  siteCode     String    @unique @map("site_code") @db.VarChar(255)
  /// OAuth 인가 코드 수신용 콜백 URI
  redirectUri  String    @map("redirect_uri") @db.VarChar(500)
  /// API 사용 권한 범위 (예: member-info:read site-info:write)
  scope        String    @db.VarChar(500)
  /// 아임웹 API 액세스 토큰 (2시간 유효)
  accessToken  String?   @map("access_token")
  /// 아임웹 API 리프레시 토큰 (90일 유효)
  refreshToken String?   @map("refresh_token")
  /// 생성 일시
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 수정 일시 (최초 생성 시 null)
  updatedAt    DateTime? @map("updated_at")

  @@map("imweb_info")
}

/// 설문 마스터 테이블
/// 설문 세트를 관리 (예: "기본 건강 설문", "다이어트 설문" 등)
model Survey {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  description      String?
  /// 설문 타입 ('before': 사전설문, 'after': 사후설문)
  type             String            @default("before") @db.VarChar(20)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  challengeSurveys ChallengeSurvey[]
  surveyQuestions  SurveyQuestion[]

  @@index([type, isActive])
  @@map("surveys")
}

/// 설문지 질문 테이블
/// 설문 조사에 사용되는 모든 질문들을 저장
model SurveyQuestion {
  id            Int            @id @default(autoincrement())
  category      String
  questionText  String         @map("question_text")
  sortOrder     Int            @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  categoryCode  String         @map("category_code")
  surveyId      Int?           @map("survey_id")
  surveyAnswers SurveyAnswer[]
  survey        Survey?        @relation(fields: [surveyId], references: [id])

  @@index([surveyId])
  @@map("survey_questions")
}

/// 옵션 마스터 테이블
/// 설문 응답에 사용되는 공통 옵션들
model SurveyOption {
  id            Int            @id @default(autoincrement())
  optionText    String         @map("option_text")
  score         Int
  createdAt     DateTime       @default(now()) @map("created_at")
  surveyAnswers SurveyAnswer[]

  @@map("survey_options")
}

/// 사용자 설문 참여 테이블
/// 사용자가 설문에 참여한 실제 답변 데이터를 저장
model SurveyAnswer {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  surveyOptionId   Int            @map("survey_option_id")
  surveyQuestionId Int            @map("survey_question_id")
  type             String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")
  userChallengeId  Int?           @map("user_challenge_id")
  surveyOption     SurveyOption   @relation(fields: [surveyOptionId], references: [id])
  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id], onDelete: Cascade)
  userChallenge    UserChallenge? @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyQuestionId, type])
  @@unique([userChallengeId, surveyQuestionId, type])
  @@index([userId])
  @@index([userChallengeId])
  @@index([createdAt])
  @@map("survey_answers")
}

/// 카테고리 상세 정보 테이블
/// 각 카테고리별 동물 캐릭터 및 상세 설명 정보를 저장
model CategoryDetail {
  id               Int       @id @default(autoincrement())
  categoryCode     String    @unique @map("category_code")
  categoryType     String    @map("category_type")
  animalCharacter  String    @map("animal_character")
  characterKeyword String    @map("character_keyword")
  detailedFeatures String    @map("detailed_features")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  @@map("category_details")
}

/// 포인트 내역 테이블
/// 사용자의 포인트 적립/사용 내역 관리
model PointHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String
  amount      Int
  balance     Int
  description String
  relatedType String?  @map("related_type")
  relatedId   Int?     @map("related_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("point_histories")
}

/// 미션 정의 테이블
/// 챌린지에서 수행할 모든 미션 타입 정의
model Mission {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  points            Int
  requireUpload     Boolean            @default(false) @map("require_upload")
  sortOrder         Int                @map("sort_order")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime?          @updatedAt @map("updated_at")
  category          String             @default("DAILY")
  type              String             @default("MISSION") @db.VarChar(20)
  recordType        String             @unique @map("record_type") @db.VarChar(50)
  dailyLimit        Int                @default(1) @map("daily_limit")
  specificDay       Int?               @map("specific_day")
  totalDays         Int                @default(21) @map("total_days")
  uploadType        String?            @map("upload_type")
  challengeMissions ChallengeMission[]
  dailyMissions     DailyMission[]
  quizzes           Quiz[]

  @@index([category, isActive])
  @@index([sortOrder])
  @@index([type, isActive])
  @@map("missions")
}

/// 데일리 미션 마스터 테이블
/// 일차별 미션 내용을 관리 (Mission과 연결)
model DailyMission {
  id          Int       @id @default(autoincrement())
  day         Int
  title       String
  description String?
  verifyType  String    @map("verify_type") @db.VarChar(20)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  points      Int       @default(100)
  reason      String?
  method      String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  missionId   Int       @map("mission_id")
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, day])
  @@index([missionId])
  @@index([day])
  @@index([isActive])
  @@map("daily_missions")
}

/// 챌린지-미션 연결 테이블
/// 각 상품(챌린지 이용권)에서 사용할 미션과 일차별 매핑
model ChallengeMission {
  id              Int              @id @default(autoincrement())
  productId       Int              @map("product_id")
  missionId       Int              @map("mission_id")
  day             Int
  points          Int              @default(100)
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  mission         Mission          @relation(fields: [missionId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  missionAttempts MissionAttempt[]

  @@unique([productId, missionId, day])
  @@index([productId, day])
  @@index([missionId])
  @@map("challenge_missions")
}

/// 챌린지-설문 연결 테이블
/// 각 상품(챌린지 이용권)에서 사용할 설문을 일차별로 관리
model ChallengeSurvey {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  surveyId  Int       @map("survey_id")
  day       Int
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  product   Product   @relation(fields: [productId], references: [id])
  survey    Survey    @relation(fields: [surveyId], references: [id])

  @@unique([productId, surveyId, day])
  @@index([productId, day])
  @@index([surveyId])
  @@map("challenge_surveys")
}

/// 퀴즈 마스터 테이블
/// 재사용 가능한 퀴즈 문제들을 관리 (Mission과 연결)
model Quiz {
  id               Int             @id @default(autoincrement())
  question         String
  options          Json
  correctAnswer    Int             @map("correct_answer")
  points           Int?            @default(50)
  isActive         Boolean?        @default(true) @map("is_active")
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?       @updatedAt @map("updated_at") @db.Timestamp(6)
  explanation      String?
  day              Int
  missionId        Int             @map("mission_id")
  challengeQuizzes ChallengeQuiz[]
  lectureQuizzes   LectureQuiz[]
  mission          Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, day])
  @@index([missionId])
  @@index([day])
  @@map("quizzes")
}

/// 챌린지-퀴즈 연결 테이블
/// 상품(챌린지 이용권)과 퀴즈를 일차별로 연결
model ChallengeQuiz {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  quizId    Int       @map("quiz_id")
  day       Int
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  product   Product   @relation(fields: [productId], references: [id])
  quiz      Quiz      @relation(fields: [quizId], references: [id])

  @@unique([productId, quizId, day])
  @@index([productId, day])
  @@index([quizId])
  @@map("challenge_quizzes")
}

/// 챌린지 구매권 테이블
/// 주문을 통해 획득한 챌린지 수행권 (상품 기반)
model ChallengeTicket {
  id             Int             @id @default(autoincrement())
  userId         Int             @map("user_id")
  productId      Int?            @map("product_id")
  orderItemId    Int?            @map("order_item_id")
  purchaseDate   DateTime        @default(now()) @map("purchase_date")
  status         String          @default("PURCHASED") @db.VarChar(20)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime?       @updatedAt @map("updated_at")
  ticketType     String          @default("CHALLENGE") @map("ticket_type") @db.VarChar(20)
  startDate      DateTime?       @map("start_date")
  endDate        DateTime?       @map("end_date")
  orderItem      OrderItem?      @relation(fields: [orderItemId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  userChallenges UserChallenge[]

  @@index([userId, status, ticketType])
  @@map("challenge_tickets")
}

/// 사용자별 활성 챌린지
/// 활성화된 챌린지 진행 상황 관리 (상품 기반)
model UserChallenge {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  productId       Int              @map("product_id")
  ticketId        Int              @map("ticket_id")
  activatedAt     DateTime         @map("activated_at")
  startDate       DateTime?        @map("start_date") @db.Date
  deliveryDate    DateTime?        @map("delivery_date") @db.Date
  endDate         DateTime?        @map("end_date") @db.Date
  expiresAt       DateTime         @map("expires_at")
  purchasedAt     DateTime         @map("purchased_at")
  currentDay      Int              @default(1) @map("current_day")
  totalPoints     Int              @default(0) @map("total_points")
  status          String           @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  contentViews    ContentView[]
  dailyProgress   DailyProgress[]
  missionAttempts MissionAttempt[]
  surveyAnswers   SurveyAnswer[]
  product         Product          @relation(fields: [productId], references: [id])
  ticket          ChallengeTicket  @relation(fields: [ticketId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  userRecords     UserRecord[]

  @@index([userId, status])
  @@map("user_challenges")
}


/// 일별 진행 상황
/// 사용자 챌린지의 일차별 진행 상황 관리
model DailyProgress {
  id                 Int           @id @default(autoincrement())
  userChallengeId    Int           @map("user_challenge_id")
  day                Int
  date               DateTime      @db.Date
  missionsTotal      Int           @default(0) @map("missions_total")
  missionsCompleted  Int           @default(0) @map("missions_completed")
  surveysTotal       Int           @default(0) @map("surveys_total")
  surveysCompleted   Int           @default(0) @map("surveys_completed")
  quizzesTotal       Int           @default(0) @map("quizzes_total")
  quizzesCorrect     Int           @default(0) @map("quizzes_correct")
  contentsTotal      Int           @default(0) @map("contents_total")
  contentsViewed     Int           @default(0) @map("contents_viewed")
  trackingsTotal     Int           @default(0) @map("trackings_total")
  trackingsCompleted Int           @default(0) @map("trackings_completed")
  pointsEarned       Int           @default(0) @map("points_earned")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime?     @updatedAt @map("updated_at")
  userChallenge      UserChallenge @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)

  @@unique([userChallengeId, day])
  @@index([userChallengeId])
  @@map("daily_progress")
}

/// 기록 항목 마스터
/// 기록 가능한 항목들의 메타데이터
model RecordItem {
  id            Int          @id @default(autoincrement())
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(100)
  unit          String?      @db.VarChar(20)
  defaultTarget Int?         @map("default_target")
  inputType     String       @db.VarChar(20)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime?    @updatedAt @map("updated_at")
  userRecords   UserRecord[]

  @@map("record_items")
}

/// 운동 종목 마스터 테이블
/// 활동 기록에서 사용할 운동 종목들
model ExerciseType {
  id          Int       @id @default(autoincrement())
  /// 운동 종목명
  name        String    @db.VarChar(50)
  /// 운동 종목 코드 (WALKING, RUNNING, WEIGHT_TRAINING 등)
  code        String    @unique @db.VarChar(50)
  /// 카테고리 (유산소, 무산소, 스트레칭 등)
  category    String    @db.VarChar(30)
  /// 칼로리 계수 (시간당 소모 칼로리 추정용)
  calorieRate Float?    @map("calorie_rate")
  /// 정렬 순서
  sortOrder   Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt   DateTime? @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@index([sortOrder])
  @@map("exercise_types")
}

/// 사용자 기록 데이터
/// 사용자의 실제 기록 데이터 (수면, 식단, 운동 등)
model UserRecord {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  userChallengeId Int?             @map("user_challenge_id")
  recordCode      String           @map("record_code") @db.VarChar(50)
  date            DateTime         @db.Date
  value           String?
  unit            String?          @db.VarChar(20)
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  missionAttempts MissionAttempt[]
  recordItem      RecordItem       @relation(fields: [recordCode], references: [code])
  userChallenge   UserChallenge?   @relation(fields: [userChallengeId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([userChallengeId])
  @@index([userId, recordCode, date])
  @@map("user_records")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

/// 상품 마스터 테이블
/// 판매 상품의 기본 정보 관리
model Product {
  id                         Int                         @id @default(autoincrement())
  /// 재고 관리 코드 (재고 API 연동용)
  sku                        String                      @unique @db.VarChar(100)
  /// 상품명
  name                       String                      @db.VarChar(255)
  /// 상품 설명
  description                String?
  /// 상품 타입 (SINGLE: 단품, SET: 세트)
  productType                String                      @default("SINGLE") @map("product_type") @db.VarChar(20)
  /// 세트 구성 정보 [{"sku": "P001", "name": "상품1", "qty": 2}]
  setItems                   Json?                       @map("set_items")
  /// 상품 상세 정보 (성분, 사용법, 주의사항 등)
  productInfo                Json?                       @map("product_info")
  /// 상태 (ACTIVE: 활성, INACTIVE: 비활성, SOLD_OUT: 품절)
  status                     String                      @default("ACTIVE") @db.VarChar(20)
  /// 추천 상품 여부
  isFeatured                 Boolean                     @default(false) @map("is_featured")
  /// 조회수
  viewCount                  Int                         @default(0) @map("view_count")
  /// 생성일시
  createdAt                  DateTime                    @default(now()) @map("created_at")
  /// 수정일시
  updatedAt                  DateTime?                   @updatedAt @map("updated_at")
  /// 카테고리 코드 (SUPPLEMENT, HEALTH_FOOD 등)
  categoryCode               String                      @map("category_code") @db.VarChar(50)
  /// 카테고리명 (영양제, 건강 보조 식품 등)
  categoryName               String                      @map("category_name") @db.VarChar(100)
  /// 할인율 (%)
  discountRate               Int?                        @default(0) @map("discount_rate")
  /// 무료배송 기준 금액
  freeShippingAmount         Decimal?                    @map("free_shipping_amount") @db.Decimal(10, 0)
  /// 1인당 최대 주문 수량
  maxOrderQty                Int                         @default(10) @map("max_order_qty")
  /// 정가 (할인 전 가격)
  originalPrice              Decimal?                    @map("original_price") @db.Decimal(10, 0)
  /// 적립 포인트율 (%)
  pointRate                  Int                         @default(1) @map("point_rate")
  /// 기본 판매 가격 (옵션 없는 경우)
  price                      Decimal?                    @db.Decimal(10, 0)
  /// 배송비
  shippingFee                Decimal                     @default(3000) @map("shipping_fee") @db.Decimal(10, 0)
  /// 배송비 정책 (FREE: 무료, PAID: 유료, CONDITIONAL: 조건부)
  shippingPolicy             String                      @default("CONDITIONAL") @map("shipping_policy") @db.VarChar(20)
  /// 상품 무게 (배송비 계산용, g)
  weight                     Int?                        @default(0)
  /// 상품 태그 (검색용, 쉼표 구분)
  tags                       String?
  /// 챌린지 메타데이터 (challengeType, totalDays, description 등)
  metadata                   Json?
  cartItems                  CartItem[]
  challengeMissions          ChallengeMission[]
  challengeQuizzes           ChallengeQuiz[]
  challengeSurveys           ChallengeSurvey[]
  challengeTickets           ChallengeTicket[]
  coupons                    Coupon[]
  lectureProducts            LectureProduct[]
  orderItems                 OrderItem[]
  feedback                   ProductFeedback[]
  images                     ProductImage[]
  nutrients                  ProductNutrient[]
  recentlyViewed             RecentlyViewed[]
  userChallengeSurveyResults UserChallengeSurveyResult[]
  userChallenges             UserChallenge[]
  wishlistItems              Wishlist[]

  @@index([sku])
  @@index([categoryCode, status])
  @@map("products")
}

/// 상품 이미지 테이블
/// 상품 이미지 관리
model ProductImage {
  id        Int      @id @default(autoincrement())
  /// 상품 ID
  productId Int      @map("product_id")
  /// 이미지 전체 URL
  imageUrl  String   @map("image_url") @db.VarChar(500)
  /// 이미지 타입 (MAIN: 대표, SUB: 추가, DETAIL: 상세)
  imageType String   @default("SUB") @map("image_type") @db.VarChar(20)
  /// 정렬 순서
  sortOrder Int      @default(0) @map("sort_order")
  /// 대체 텍스트
  altText   String?  @map("alt_text") @db.VarChar(200)
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// 상품 영양소 정보 테이블
/// 영양제 상품의 영양소별 함량 정보 관리 (통계 집계용)
model ProductNutrient {
  id        Int      @id @default(autoincrement())
  /// 상품 ID
  productId Int      @map("product_id")
  /// 영양소명 (비타민A, 엽산, 철분 등)
  name      String   @db.VarChar(100)
  /// 함량
  amount    Decimal  @db.Decimal(10, 2)
  /// 단위 (mg, mcg, g, IU 등)
  unit      String   @db.VarChar(20)
  /// RDA 비율 (%) - nullable
  rda       Int?
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([name])
  @@map("product_nutrients")
}

/// 장바구니 테이블
/// 사용자별 장바구니 관리
model Cart {
  id        Int        @id @default(autoincrement())
  /// 사용자 ID
  userId    Int        @unique @map("user_id")
  /// 생성일시
  createdAt DateTime   @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime?  @updatedAt @map("updated_at")
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

/// 장바구니 아이템 테이블
/// 장바구니에 담긴 상품 정보
model CartItem {
  id             Int       @id @default(autoincrement())
  /// 장바구니 ID
  cartId         Int       @map("cart_id")
  /// 상품 ID
  productId      Int       @map("product_id")
  /// 수량
  quantity       Int       @default(1)
  /// 재고 확인 시각
  stockCheckedAt DateTime? @map("stock_checked_at")
  /// 재고 가용 여부
  stockAvailable Boolean   @default(true) @map("stock_available")
  /// 추가일시
  addedAt        DateTime  @default(now()) @map("added_at")
  /// 수정일시
  updatedAt      DateTime? @updatedAt @map("updated_at")
  cart           Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

/// 주문 테이블
/// 주문 정보 관리
model Order {
  id                Int              @id @default(autoincrement())
  /// 주문번호 (O20250814115621567 형식)
  orderNumber       String           @unique @map("order_number") @db.VarChar(50)
  /// 사용자 ID
  userId            Int              @map("user_id")
  /// 주문 상태
  status            String           @default("PENDING_PAYMENT") @db.VarChar(30)
  /// 재고 처리 상태
  inventoryStatus   String           @default("NOT_PROCESSED") @map("inventory_status") @db.VarChar(30)
  /// 상품 총액
  totalProductPrice Decimal          @map("total_product_price") @db.Decimal(10, 0)
  /// 할인 총액
  totalDiscount     Decimal          @default(0) @map("total_discount") @db.Decimal(10, 0)
  /// 배송비
  shippingFee       Decimal          @default(0) @map("shipping_fee") @db.Decimal(10, 0)
  /// 사용 포인트
  pointUsed         Decimal          @default(0) @map("point_used") @db.Decimal(10, 0)
  /// 최종 결제액
  totalAmount       Decimal          @map("total_amount") @db.Decimal(10, 0)
  /// 수령인명 (암호화)
  recipientName     String           @map("recipient_name") @db.VarChar(255)
  /// 수령인 휴대폰번호 (암호화)
  recipientMobile   String           @map("recipient_mobile") @db.VarChar(255)
  /// 우편번호
  postalCode        String           @map("postal_code") @db.VarChar(10)
  /// 주소 (암호화)
  address           String           @db.VarChar(500)
  /// 상세주소 (암호화)
  addressDetail     String?          @map("address_detail") @db.VarChar(500)
  /// 배송 메시지
  deliveryMessage   String?          @map("delivery_message")
  /// 주문일시
  orderedAt         DateTime         @default(now()) @map("ordered_at")
  /// 결제일시
  paidAt            DateTime?        @map("paid_at")
  /// 발송일시
  shippedAt         DateTime?        @map("shipped_at")
  /// 배송완료일시
  deliveredAt       DateTime?        @map("delivered_at")
  /// 구매확정일시
  completedAt       DateTime?        @map("completed_at")
  /// 취소일시
  cancelledAt       DateTime?        @map("cancelled_at")
  /// 생성일시
  createdAt         DateTime         @default(now()) @map("created_at")
  /// 수정일시
  updatedAt         DateTime?        @updatedAt @map("updated_at")
  exchangeReturns   ExchangeReturn[]
  items             OrderItem[]
  stateLogs         OrderStateLog[]
  user              User             @relation(fields: [userId], references: [id])
  payment           Payment?
  refundWarranty    RefundWarranty?
  refund            Refund?
  shipping          Shipping?
  usedCoupons       UserCoupon[]

  @@index([userId, status])
  @@index([inventoryStatus])
  @@index([orderNumber])
  @@index([orderedAt])
  @@map("orders")
}

/// 주문 상품 테이블
/// 주문한 상품 상세 정보
model OrderItem {
  id               Int               @id @default(autoincrement())
  /// 주문 ID
  orderId          Int               @map("order_id")
  /// 상품 ID
  productId        Int               @map("product_id")
  /// 상품명 (주문 시점 스냅샷)
  productName      String            @map("product_name") @db.VarChar(255)
  /// 상품 단가
  productPrice     Decimal           @map("product_price") @db.Decimal(10, 0)
  /// 수량
  quantity         Int
  /// 소계 (단가 × 수량)
  subtotal         Decimal           @db.Decimal(10, 0)
  /// 생성일시
  createdAt        DateTime          @default(now()) @map("created_at")
  /// 수정일시
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  challengeTickets ChallengeTicket[]
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  feedback         ProductFeedback?

  @@index([orderId])
  @@map("order_items")
}

/// 주문 상태 변경 로그
/// 주문 상태 변경 이력 추적
model OrderStateLog {
  id           Int      @id @default(autoincrement())
  /// 주문 ID
  orderId      Int      @map("order_id")
  /// 이전 상태
  fromStatus   String?  @map("from_status") @db.VarChar(50)
  /// 변경된 상태
  toStatus     String   @map("to_status") @db.VarChar(50)
  /// 변경한 사용자 ID (NULL이면 시스템)
  changedBy    Int?     @map("changed_by")
  /// 변경 사유
  changeReason String?  @map("change_reason")
  /// 생성일시
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_state_logs")
}

/// 결제 정보 테이블
/// 주문 결제 정보 관리
model Payment {
  id              Int       @id @default(autoincrement())
  /// 주문 ID
  orderId         Int       @unique @map("order_id")
  /// PG사 (TOSS: 토스페이먼츠)
  pgProvider      String    @default("TOSS") @map("pg_provider") @db.VarChar(20)
  /// PG사 거래번호
  pgTransactionId String?   @unique @map("pg_transaction_id") @db.VarChar(100)
  /// 결제수단
  paymentMethod   String    @map("payment_method") @db.VarChar(30)
  /// 결제 상태
  status          String    @default("READY") @db.VarChar(30)
  /// PG사 결제 금액
  amount          Decimal   @db.Decimal(10, 0)
  /// 포인트 결제 금액
  pointAmount     Decimal   @default(0) @map("point_amount") @db.Decimal(10, 0)
  /// 결제 상세 정보 (암호화 필요)
  paymentDetails  Json?     @map("payment_details")
  /// 요청일시
  requestedAt     DateTime  @default(now()) @map("requested_at")
  /// 결제일시
  paidAt          DateTime? @map("paid_at")
  /// 취소일시
  cancelledAt     DateTime? @map("cancelled_at")
  /// 실패일시
  failedAt        DateTime? @map("failed_at")
  /// 실패 사유
  failReason      String?   @map("fail_reason") @db.VarChar(500)
  /// 생성일시
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt       DateTime? @updatedAt @map("updated_at")
  order           Order     @relation(fields: [orderId], references: [id])
  refunds         Refund[]

  @@index([status])
  @@index([pgTransactionId])
  @@map("payments")
}

/// 환불 정보 테이블
/// 주문 취소/반품 환불 관리
model Refund {
  id                   Int       @id @default(autoincrement())
  /// 주문 ID
  orderId              Int       @unique @map("order_id")
  /// 결제 ID
  paymentId            Int       @map("payment_id")
  /// 환불 타입 (CANCEL: 취소, RETURN: 반품)
  refundType           String    @map("refund_type") @db.VarChar(20)
  /// 환불 상태
  status               String    @default("REQUESTED") @db.VarChar(20)
  /// 환불 금액
  refundAmount         Decimal   @map("refund_amount") @db.Decimal(10, 0)
  /// 포인트 환불액
  pointRefund          Decimal   @default(0) @map("point_refund") @db.Decimal(10, 0)
  /// 토스페이먼츠 취소 ID
  tossCancelId         String?   @map("toss_cancel_id") @db.VarChar(100)
  /// 토스페이먼츠 응답
  tossResponse         Json?     @map("toss_response")
  /// 환불 사유
  reason               String    @db.VarChar(200)
  /// 상세 사유
  reasonDetail         String?   @map("reason_detail")
  /// 반품 송장번호
  returnTrackingNumber String?   @map("return_tracking_number") @db.VarChar(100)
  /// 반품 수령일시
  returnReceivedAt     DateTime? @map("return_received_at")
  /// 처리한 관리자 ID
  adminId              Int?      @map("admin_id")
  /// 관리자 메모
  adminMemo            String?   @map("admin_memo")
  /// 요청일시
  requestedAt          DateTime  @default(now()) @map("requested_at")
  /// 완료일시
  completedAt          DateTime? @map("completed_at")
  /// 거절일시
  rejectedAt           DateTime? @map("rejected_at")
  /// 생성일시
  createdAt            DateTime  @default(now()) @map("created_at")
  order                Order     @relation(fields: [orderId], references: [id])
  payment              Payment   @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@index([requestedAt])
  @@map("refunds")
}

/// 환불 정책 테이블
/// 환불 가능 기간 등 정책 관리
model RefundPolicy {
  id               Int      @id @default(autoincrement())
  /// 정책명
  name             String   @db.VarChar(100)
  /// 반품 가능 기간 (일)
  returnPeriodDays Int      @default(7) @map("return_period_days")
  /// 자동 구매확정 기간 (일)
  autoConfirmDays  Int      @default(7) @map("auto_confirm_days")
  /// 활성화 여부
  isActive         Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("refund_policies")
}

/// 상품 피드백 통합 테이블 (리뷰 + 문의)
/// 상품에 대한 고객 피드백을 통합 관리
model ProductFeedback {
  id             Int               @id @default(autoincrement())
  /// 상품 ID
  productId      Int               @map("product_id")
  /// 사용자 ID
  userId         Int               @map("user_id")
  /// 피드백 타입 (REVIEW: 리뷰, QUESTION: 문의)
  feedbackType   String            @map("feedback_type") @db.VarChar(20)
  /// 원글 ID (답글인 경우)
  parentId       Int?              @map("parent_id")
  /// 주문 상품 ID (리뷰인 경우 구매 확인용)
  orderItemId    Int?              @unique @map("order_item_id")
  /// 제목
  title          String?           @db.VarChar(200)
  /// 내용
  content        String
  /// 상태 (ACTIVE, HIDDEN, DELETED)
  status         String            @default("ACTIVE") @db.VarChar(20)
  /// 생성일시
  createdAt      DateTime          @default(now()) @map("created_at")
  /// 수정일시
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  /// 별점 (1~5, 리뷰인 경우만)
  rating         Int?
  /// 리뷰 타입 (TEXT, PHOTO, VIDEO)
  reviewType     String?           @map("review_type") @db.VarChar(20)
  /// 미디어 URL 배열
  mediaUrls      Json?             @map("media_urls")
  /// 베스트 리뷰 여부
  isBest         Boolean           @default(false) @map("is_best")
  /// 베스트 선정일시
  bestSelectedAt DateTime?         @map("best_selected_at")
  /// 도움됨 수
  helpfulCount   Int               @default(0) @map("helpful_count")
  /// 문의 타입 (PRODUCT, DELIVERY, STOCK, SIZE, OTHER)
  questionType   String?           @map("question_type") @db.VarChar(20)
  /// 비밀글 여부
  isSecret       Boolean           @default(false) @map("is_secret")
  /// 답변 여부
  hasAnswer      Boolean           @default(false) @map("has_answer")
  /// 답변한 관리자 ID
  answeredBy     Int?              @map("answered_by")
  /// 답변일시
  answeredAt     DateTime?         @map("answered_at")
  /// 숨김 사유
  hiddenReason   String?           @map("hidden_reason") @db.VarChar(200)
  /// 지급된 적립금 금액
  rewardAmount   Int?              @map("reward_amount")
  /// 적립금 지급 여부
  rewardGiven    Boolean           @default(false) @map("reward_given")
  /// 적립금 지급일시
  rewardedAt     DateTime?         @map("rewarded_at")
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id])
  parent         ProductFeedback?  @relation("FeedbackReply", fields: [parentId], references: [id])
  replies        ProductFeedback[] @relation("FeedbackReply")
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id])

  @@index([productId, feedbackType, status])
  @@index([userId])
  @@index([parentId])
  @@index([feedbackType, rating])
  @@index([feedbackType, hasAnswer])
  @@index([isBest])
  @@index([rewardGiven])
  @@map("product_feedback")
}

/// 찜하기 테이블
/// 사용자의 찜한 상품
model Wishlist {
  id        Int      @id @default(autoincrement())
  /// 사용자 ID
  userId    Int      @map("user_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 생성일시
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

/// 최근 본 상품 테이블
/// 사용자가 최근에 조회한 상품
model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  /// 사용자 ID
  userId    Int      @map("user_id")
  /// 상품 ID
  productId Int      @map("product_id")
  /// 조회일시
  viewedAt  DateTime @default(now()) @map("viewed_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

/// AI 페르소나 테이블
/// 챌린지를 도와주는 AI 페르소나들
model AiPersona {
  id               Int               @id(map: "ai_characters_pkey") @default(autoincrement())
  /// 페르소나 이름 (철민님, 유진님, 뽑이)
  name             String            @db.VarChar(50)
  /// 페르소나 설명
  description      String?
  /// 페르소나 성격/대화 스타일
  personality      String?
  /// 페르소나 이미지 URL
  personaUrl       String?           @map("persona_url") @db.VarChar(500)
  /// 활성화 여부
  isActive         Boolean           @default(true) @map("is_active")
  /// 정렬 순서
  sortOrder        Int               @default(0) @map("sort_order")
  /// 생성일시
  createdAt        DateTime          @default(now()) @map("created_at")
  /// 수정일시
  updatedAt        DateTime?         @updatedAt @map("updated_at")
  balanceGameSteps BalanceGameStep[]
  users            User[]

  @@index([isActive, sortOrder], map: "ai_characters_is_active_sort_order_idx")
  @@map("ai_personas")
}

/// 사용자별 챌린지별 설문 결과 테이블
/// 챌린지마다 다른 사전/사후 설문 결과 저장
model UserChallengeSurveyResult {
  id                    Int       @id @default(autoincrement())
  /// 사용자 ID
  userId                Int       @map("user_id")
  /// 상품 ID (챌린지 이용권)
  productId             Int       @map("product_id")
  /// 사전설문 최저점수 카테고리 (CategoryDetail.category 참조)
  beforeCategory        String?   @map("before_category") @db.VarChar(50)
  /// 사후설문 최저점수 카테고리 (CategoryDetail.category 참조)
  afterCategory         String?   @map("after_category") @db.VarChar(50)
  /// 사전설문 피부건강 점수
  beforeSkinHealthScore Int?      @map("before_skin_health_score")
  /// 사전설문 대사 점수
  beforeMetabolismScore Int?      @map("before_metabolism_score")
  /// 사전설문 면역 점수
  beforeImmuneScore     Int?      @map("before_immune_score")
  /// 사전설문 장건강 점수
  beforeGutHealthScore  Int?      @map("before_gut_health_score")
  /// 사전설문 총점
  beforeTotalScore      Int?      @map("before_total_score")
  /// 사후설문 피부건강 점수
  afterSkinHealthScore  Int?      @map("after_skin_health_score")
  /// 사후설문 대사 점수
  afterMetabolismScore  Int?      @map("after_metabolism_score")
  /// 사후설문 면역 점수
  afterImmuneScore      Int?      @map("after_immune_score")
  /// 사후설문 장건강 점수
  afterGutHealthScore   Int?      @map("after_gut_health_score")
  /// 사후설문 총점
  afterTotalScore       Int?      @map("after_total_score")
  /// 사전설문 완료일시
  beforeCompletedAt     DateTime? @map("before_completed_at")
  /// 사후설문 완료일시
  afterCompletedAt      DateTime? @map("after_completed_at")
  /// 생성일시
  createdAt             DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt             DateTime? @updatedAt @map("updated_at")
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("user_challenge_survey_results")
}

/// 미션 시도 기록 테이블
/// 사용자의 미션 수행 시도를 기록하고, dailyLimit 기반 진행도 추적
model MissionAttempt {
  id                 Int              @id @default(autoincrement())
  /// 사용자 ID
  userId             Int              @map("user_id")
  /// 챌린지 미션 ID
  challengeMissionId Int              @map("challenge_mission_id")
  /// 사용자 챌린지 ID
  userChallengeId    Int              @map("user_challenge_id")
  /// 챌린지 진행 일차
  day                Int
  /// 당일 시도 순서 (1, 2, 3...)
  attemptNumber      Int              @map("attempt_number")
  /// 최종 완료 여부 (dailyLimit 달성)
  isCompleted        Boolean          @default(false) @map("is_completed")
  /// 획득 포인트 (최종 완료시만)
  pointsEarned       Int              @default(0) @map("points_earned")
  /// 업로드된 파일 ID
  fileUploadId       Int?             @map("file_upload_id")
  /// 기록형 미션의 UserRecord ID
  trackingRecordId   Int?             @map("tracking_record_id")
  /// 추가 데이터
  metadata           Json?
  /// 시도 일시
  createdAt          DateTime         @default(now()) @map("created_at")
  /// 수정일시
  updatedAt          DateTime?        @updatedAt @map("updated_at")
  challengeMission   ChallengeMission @relation(fields: [challengeMissionId], references: [id], onDelete: Cascade)
  fileUpload         FileUpload?      @relation(fields: [fileUploadId], references: [id])
  trackingRecord     UserRecord?      @relation(fields: [trackingRecordId], references: [id])
  userChallenge      UserChallenge    @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeMissionId, day, attemptNumber])
  @@index([userId, day])
  @@index([challengeMissionId])
  @@index([userChallengeId, day])
  @@index([createdAt])
  @@map("mission_attempts")
}

/// 컨텐츠 시청 기록 테이블
/// 사용자의 컨텐츠 시청 기록 및 중복 방지
model ContentView {
  id              Int            @id @default(autoincrement())
  /// 사용자 ID
  userId          Int            @map("user_id")
  /// 컨텐츠 ID
  contentId       Int            @map("content_id")
  /// 사용자 챌린지 ID (챌린지 참여자인 경우)
  userChallengeId Int?           @map("user_challenge_id")
  /// 시청 일시
  viewedAt        DateTime       @default(now()) @map("viewed_at")
  content         Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userChallenge   UserChallenge? @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, viewedAt])
  @@index([contentId])
  @@index([userChallengeId])
  @@map("content_views")
}

/// 강의-퀴즈 연결 테이블
/// 각 강의에 연결된 퀴즈들
model LectureQuiz {
  id        Int     @id @default(autoincrement())
  /// 강의 컨텐츠 ID
  contentId Int     @map("content_id")
  /// 퀴즈 ID
  quizId    Int     @map("quiz_id")
  /// 정렬 순서
  sortOrder Int     @default(0) @map("sort_order")
  /// 활성화 여부
  isActive  Boolean @default(true) @map("is_active")
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([contentId, quizId])
  @@index([contentId])
  @@index([quizId])
  @@map("lecture_quizzes")
}

/// 강의-상품 연결 테이블
/// 각 강의에 연결된 추천 상품들
model LectureProduct {
  id        Int     @id @default(autoincrement())
  /// 강의 컨텐츠 ID
  contentId Int     @map("content_id")
  /// 상품 ID
  productId Int     @map("product_id")
  /// 정렬 순서
  sortOrder Int     @default(0) @map("sort_order")
  /// 활성화 여부
  isActive  Boolean @default(true) @map("is_active")
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([contentId, productId])
  @@index([contentId])
  @@index([productId])
  @@map("lecture_products")
}

/// 사용자 커스텀 영양제 테이블
/// 사용자가 직접 추가한 영양제 정보
model UserCustomSupplement {
  id        Int       @id @default(autoincrement())
  /// 사용자 ID
  userId    Int       @map("user_id")
  /// 영양제명
  name      String    @db.VarChar(100)
  /// 용량/함량
  dosage    String?   @db.VarChar(50)
  /// 메모
  memo      String?   @db.VarChar(255)
  /// 활성화 여부
  isActive  Boolean   @default(true) @map("is_active")
  /// 생성일시
  createdAt DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt DateTime? @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("user_custom_supplements")
}

/// 밸런스게임 마스터 테이블
/// 밸런스게임 기본 정보 관리
model BalanceGame {
  id            Int                      @id @default(autoincrement())
  /// 게임명
  title         String                   @db.VarChar(200)
  /// 게임 설명
  description   String?
  /// 대표 이미지 URL
  thumbnailUrl  String?                  @map("thumbnail_url") @db.VarChar(500)
  /// 배경 이미지 URL
  backgroundUrl String?                  @map("background_url") @db.VarChar(500)
  /// 활성화 여부
  isActive      Boolean                  @default(true) @map("is_active")
  /// 생성일시
  createdAt     DateTime                 @default(now()) @map("created_at")
  /// 수정일시
  updatedAt     DateTime?                @updatedAt @map("updated_at")
  /// 챌린지 일차 (1~21일차)
  challengeDay  Int                      @unique @map("challenge_day")
  steps         BalanceGameStep[]
  userHistories UserBalanceGameHistory[]

  @@index([isActive, challengeDay])
  @@map("balance_games")
}

/// 밸런스게임 단계별 대본 테이블
/// 각 게임의 단계별 질문과 선택지, 대화 내용 관리
model BalanceGameStep {
  id             Int               @id @default(autoincrement())
  /// 밸런스게임 ID
  gameId         Int               @map("game_id")
  /// 단계 번호 (1: 선택 단계, 2~N: 대화 단계)
  stepNumber     Int               @map("step_number")
  /// 부모 단계 ID (선택지별 분기용)
  parentStepId   Int?              @map("parent_step_id")
  /// 선택한 옵션 값 (부모 단계에서 선택한 값, 1 또는 2)
  selectedOption Int?              @map("selected_option")
  /// 단계 타입 (QUESTION: 질문, DIALOGUE: 대화, RESULT: 결과)
  stepType       String            @map("step_type") @db.VarChar(20)
  /// 제목
  title          String?           @db.VarChar(200)
  /// 내용/질문
  content        String
  /// 선택지 (JSON) [{"value": 1, "text": "장원영 얼굴"}, {"value": 2, "text": "권은비 몸매"}]
  options        Json?
  /// 획득할 쿠폰 ID (결과 단계인 경우)
  couponId       Int?              @map("coupon_id")
  /// 정렬 순서
  sortOrder      Int               @default(0) @map("sort_order")
  /// 활성화 여부
  isActive       Boolean           @default(true) @map("is_active")
  /// 생성일시
  createdAt      DateTime          @default(now()) @map("created_at")
  /// 수정일시
  updatedAt      DateTime?         @updatedAt @map("updated_at")
  /// AI 페르소나 ID (페르소나별 대사 구분용)
  characterId    Int               @map("character_id")
  character      AiPersona         @relation(fields: [characterId], references: [id])
  coupon         Coupon?           @relation(fields: [couponId], references: [id])
  game           BalanceGame       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  parentStep     BalanceGameStep?  @relation("StepHierarchy", fields: [parentStepId], references: [id])
  childSteps     BalanceGameStep[] @relation("StepHierarchy")

  @@index([gameId, characterId, stepType])
  @@index([parentStepId])
  @@map("balance_game_steps")
}

/// 사용자 밸런스게임 완료 이력 테이블
/// 사용자의 밸런스게임 완료 기록 관리
model UserBalanceGameHistory {
  id              Int         @id @default(autoincrement())
  /// 사용자 ID
  userId          Int         @map("user_id")
  /// 밸런스게임 ID
  gameId          Int         @map("game_id")
  /// 플레이 날짜 (YYYY-MM-DD)
  playDate        String      @map("play_date") @db.VarChar(10)
  /// 선택한 옵션들 JSON [{"step": 1, "option": 1}]
  selectedOptions Json        @map("selected_options")
  /// 획득 쿠폰 ID
  earnedCouponId  Int?        @map("earned_coupon_id")
  /// 완료일시
  completedAt     DateTime    @default(now()) @map("completed_at")
  earnedCoupon    Coupon?     @relation(fields: [earnedCouponId], references: [id])
  game            BalanceGame @relation(fields: [gameId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playDate])
  @@index([userId])
  @@index([gameId])
  @@map("user_balance_game_histories")
}

/// 쿠폰 마스터 테이블
/// 할인 쿠폰 정보 관리
model Coupon {
  id                Int                      @id @default(autoincrement())
  /// 쿠폰명
  name              String                   @db.VarChar(200)
  /// 쿠폰 설명
  description       String?
  /// 할인 타입 (PERCENTAGE: 퍼센트, AMOUNT: 고정금액)
  discountType      String                   @map("discount_type") @db.VarChar(20)
  /// 할인값 (퍼센트인 경우 %, 고정금액인 경우 원)
  discountValue     Int                      @map("discount_value")
  /// 최대 할인 금액 (퍼센트 할인인 경우)
  maxDiscountAmount Int?                     @map("max_discount_amount")
  /// 적용 상품 ID (특정 상품에만 적용)
  productId         Int                      @map("product_id")
  /// 유효시간 (시간 단위, 48시간 = 48)
  validHours        Int                      @default(48) @map("valid_hours")
  /// 활성화 여부
  isActive          Boolean                  @default(true) @map("is_active")
  /// 생성일시
  createdAt         DateTime                 @default(now()) @map("created_at")
  /// 수정일시
  updatedAt         DateTime?                @updatedAt @map("updated_at")
  gameSteps         BalanceGameStep[]
  product           Product                  @relation(fields: [productId], references: [id])
  earnedInGames     UserBalanceGameHistory[]
  userCoupons       UserCoupon[]

  @@index([productId, isActive])
  @@map("coupons")
}

/// 사용자 쿠폰 테이블
/// 사용자가 보유한 쿠폰 관리
model UserCoupon {
  id          Int       @id @default(autoincrement())
  /// 사용자 ID
  userId      Int       @map("user_id")
  /// 쿠폰 ID
  couponId    Int       @map("coupon_id")
  /// 쿠폰 상태 (ACTIVE: 사용가능, USED: 사용완료, EXPIRED: 만료)
  status      String    @default("ACTIVE") @db.VarChar(20)
  /// 발급일시
  issuedAt    DateTime  @default(now()) @map("issued_at")
  /// 만료일시
  expiresAt   DateTime  @map("expires_at")
  /// 사용일시
  usedAt      DateTime? @map("used_at")
  /// 사용한 주문 ID
  usedOrderId Int?      @map("used_order_id")
  coupon      Coupon    @relation(fields: [couponId], references: [id])
  usedOrder   Order?    @relation(fields: [usedOrderId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([couponId])
  @@index([expiresAt])
  @@map("user_coupons")
}

/// 배송 테이블
/// 주문의 배송 정보를 관리
model Shipping {
  id             Int       @id @default(autoincrement())
  /// 주문 ID
  orderId        Int       @unique @map("order_id")
  /// 택배사 코드 (한진택배: CJ, 우체국: EPOST 등)
  courierCode    String?   @map("courier_code") @db.VarChar(20)
  /// 택배사명
  courierName    String?   @map("courier_name") @db.VarChar(50)
  /// 운송장 번호
  trackingNumber String?   @map("tracking_number") @db.VarChar(50)
  /// 배송 상태 (PENDING: 대기, READY_FOR_SHIPMENT: 배송준비, IN_TRANSIT: 배송중, DELIVERED: 배송완료)
  status         String    @default("PENDING") @db.VarChar(30)
  /// 배송비
  shippingFee    Decimal   @default(3000) @map("shipping_fee") @db.Decimal(10, 2)
  /// 배송 준비 완료일시
  readyAt        DateTime? @map("ready_at")
  /// 배송 시작일시
  shippedAt      DateTime? @map("shipped_at")
  /// 배송 완료일시
  deliveredAt    DateTime? @map("delivered_at")
  /// 생성일시
  createdAt      DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt      DateTime  @updatedAt @map("updated_at")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([courierCode])
  @@index([trackingNumber])
  @@index([createdAt])
  @@map("shipping")
}

/// 배송 정책 테이블
/// 배송비 및 배송 관련 정책 설정
model ShippingPolicy {
  id                    Int      @id @default(autoincrement())
  /// 정책명
  name                  String   @db.VarChar(100)
  /// 기본 배송비
  baseShippingFee       Decimal  @default(3000) @map("base_shipping_fee") @db.Decimal(10, 2)
  /// 무료배송 최소 주문금액
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(10, 2)
  /// 도서산간 추가 배송비
  remoteAreaFee         Decimal  @default(3000) @map("remote_area_fee") @db.Decimal(10, 2)
  /// 제주도 추가 배송비
  jejuAreaFee           Decimal  @default(3000) @map("jeju_area_fee") @db.Decimal(10, 2)
  /// 기본 택배사 코드
  defaultCourierCode    String   @default("CJ") @map("default_courier_code") @db.VarChar(20)
  /// 기본 택배사명
  defaultCourierName    String   @default("한진택배") @map("default_courier_name") @db.VarChar(50)
  /// 활성화 여부
  isActive              Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt             DateTime @default(now()) @map("created_at")
  /// 수정일시
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shipping_policies")
}

/// 교환/반품 테이블
/// 주문 상품의 교환 및 반품 신청 관리
model ExchangeReturn {
  id             Int       @id @default(autoincrement())
  /// 주문 ID
  orderId        Int       @map("order_id")
  /// 교환/반품 타입 (EXCHANGE: 교환, RETURN: 반품)
  type           String    @db.VarChar(20)
  /// 신청 상태 (REQUESTED: 신청, APPROVED: 승인, REJECTED: 거절, COMPLETED: 완료)
  status         String    @default("REQUESTED") @db.VarChar(20)
  /// 신청 사유
  reason         String    @db.VarChar(500)
  /// 상세 사유
  reasonDetail   String?   @map("reason_detail")
  /// 수거 주소
  pickupAddress  String    @map("pickup_address")
  /// 배송비 (국내: 6000원, 해외직구: 19600원)
  shippingFee    Decimal   @default(6000) @map("shipping_fee") @db.Decimal(10, 2)
  /// 택배사 코드
  courierCode    String?   @map("courier_code") @db.VarChar(20)
  /// 택배사명
  courierName    String?   @map("courier_name") @db.VarChar(50)
  /// 운송장 번호
  trackingNumber String?   @map("tracking_number") @db.VarChar(50)
  /// 관리자 메모
  adminMemo      String?   @map("admin_memo")
  /// 신청일시
  requestedAt    DateTime  @default(now()) @map("requested_at")
  /// 승인일시
  approvedAt     DateTime? @map("approved_at")
  /// 거절일시
  rejectedAt     DateTime? @map("rejected_at")
  /// 완료일시
  completedAt    DateTime? @map("completed_at")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type, status])
  @@index([requestedAt])
  @@map("exchange_returns")
}

/// 교환/반품 정책 테이블
/// 교환/반품 관련 정책 설정
model ExchangeReturnPolicy {
  id                  Int      @id @default(autoincrement())
  /// 정책명
  name                String   @db.VarChar(100)
  /// 교환/반품 가능 기간 (일)
  exchangeReturnDays  Int      @default(7) @map("exchange_return_days")
  /// 기본 택배사 코드
  defaultCourierCode  String   @default("CJ") @map("default_courier_code") @db.VarChar(20)
  /// 기본 택배사명
  defaultCourierName  String   @default("한진택배") @map("default_courier_name") @db.VarChar(50)
  /// 국내 배송비
  domesticShippingFee Decimal  @default(6000) @map("domestic_shipping_fee") @db.Decimal(10, 2)
  /// 해외직구 배송비
  overseasShippingFee Decimal  @default(19600) @map("overseas_shipping_fee") @db.Decimal(10, 2)
  /// 교환/반품 주소
  returnAddress       String   @default("서울 강서구 마곡중앙로 59-17 (마곡동, 류마타워2) 3층 바이오컴 (07807)") @map("return_address")
  /// 활성화 여부
  isActive            Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt           DateTime @default(now()) @map("created_at")
  /// 수정일시
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("exchange_return_policies")
}

/// 30일 체험 후 환불 워런티 테이블
/// 건강기능식품 불만족시 100% 환불 워런티 정책
model RefundWarranty {
  id                     Int       @id @default(autoincrement())
  /// 주문 ID
  orderId                Int       @unique @map("order_id")
  /// 사용자 ID
  userId                 Int       @map("user_id")
  /// 워런티 상태 (ACTIVE: 활성, USED: 사용완료, EXPIRED: 만료)
  status                 String    @default("ACTIVE") @db.VarChar(20)
  /// 제품 개봉 여부
  isOpened               Boolean   @default(false) @map("is_opened")
  /// 섭취 시작일
  consumptionStartAt     DateTime? @map("consumption_start_at")
  /// 30일 섭취 완료일
  consumptionEndAt       DateTime? @map("consumption_end_at")
  /// 환불 신청일
  refundRequestedAt      DateTime? @map("refund_requested_at")
  /// 환불 완료일
  refundCompletedAt      DateTime? @map("refund_completed_at")
  /// 환불 금액
  refundAmount           Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  /// 배송비 입금 확인일
  shippingFeeConfirmedAt DateTime? @map("shipping_fee_confirmed_at")
  /// 제품 회수 완료일
  productReturnedAt      DateTime? @map("product_returned_at")
  /// 관리자 메모
  adminMemo              String?   @map("admin_memo")
  /// 생성일시 (상품 수령일)
  createdAt              DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt              DateTime  @updatedAt @map("updated_at")
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orderId])
  @@index([createdAt])
  @@map("refund_warranties")
}

/// 공통 배너 테이블
model Banner {
  id          Int       @id @default(autoincrement())
  /// 배너 제목
  title       String    @db.VarChar(100)
  /// 배너 이미지 URL
  imageUrl    String    @map("image_url") @db.VarChar(500)
  /// 클릭시 이동할 라우팅 URL
  linkUrl     String?   @map("link_url") @db.VarChar(500)
  /// 링크 타입 (INTERNAL: 앱 내부 라우팅, EXTERNAL: 외부 URL, PRODUCT: 상품 상세)
  linkType    String    @default("INTERNAL") @map("link_type") @db.VarChar(20)
  /// 배너 설명 (선택)
  description String?
  /// 정렬 순서 (낮을수록 우선)
  sortOrder   Int       @default(0) @map("sort_order")
  /// 활성화 여부
  isActive    Boolean   @default(true) @map("is_active")
  /// 노출 시작일
  startDate   DateTime? @map("start_date")
  /// 노출 종료일
  endDate     DateTime? @map("end_date")
  /// 생성일시
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 수정일시
  updatedAt   DateTime? @updatedAt @map("updated_at")
  /// 배너 타입 (SHOP: 쇼핑몰, HOME: 메인홈, EVENT: 이벤트)
  bannerType  String    @default("SHOP") @map("banner_type") @db.VarChar(20)

  @@index([bannerType, isActive, sortOrder])
  @@index([startDate, endDate])
  @@map("banners")
}

/// 컨텐츠 마스터 테이블
/// 재사용 가능한 컨텐츠들을 관리
/// 컨텐츠 접근 권한 Enum
enum ContentAccessLevel {
  ALL
  CHALLENGE_ONLY
  SUBSCRIPTION_ONLY
  CHALLENGE_OR_SUB
}
/// 날짜/시간 테스트용 테이블
/// DATE, TIMESTAMP 컬럼의 KST 저장/조회 테스트를 위한 테이블
model DateTimeTest {
  id          Int       @id @default(autoincrement())
  /// 테스트용 DATE 컬럼 (날짜만 저장)
  testDate    DateTime  @map("test_date") @db.Date
  /// 테스트용 TIMESTAMP 컬럼 (날짜 + 시간 저장)
  testTime    DateTime  @map("test_time")
  /// 메모
  memo        String?   @db.VarChar(200)
  /// 생성일시
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("datetime_tests")
}
