# EKS 클러스터 환경 설정
# 이 파일은 EKS 관련 스크립트에서 사용하는 환경 변수를 정의합니다

# AWS 계정 정보
AWS_ACCOUNT_ID=183631338083
AWS_REGION=ap-northeast-2

# EKS 클러스터 설정
CLUSTER_NAME=biocom-cluster
KUBERNETES_VERSION=1.30

# 노드그룹 설정
NODEGROUP_NAME=app-nodes
INSTANCE_TYPE=t3.medium
NODE_COUNT=2
NODE_MIN=1
NODE_MAX=4
NODE_VOLUME_SIZE=30
NODE_LABEL_KEY=role
NODE_LABEL_VALUE=apps
NODE_TAG_NAME=biocom-worker

# VPC 네트워크 설정
VPC_CIDR=172.16.0.0/16
NAT_GATEWAY_TYPE=Single

# ECR 설정
ECR_REPOSITORY=backend-v2

# 애플리케이션 설정
APP_NAME=backend-api
APP_LABEL=backend-api
APP_PORT=3000
SERVICE_NAME=backend-service
SERVICE_PORT=80
INGRESS_NAME=backend-ingress
SECRET_NAME=backend-secrets
PVC_NAME=uploads-pvc
STORAGE_CLASS_NAME=ebs-sc
STORAGE_SIZE=10Gi

# 헬스체크 설정
HEALTH_CHECK_PATH=/api/health
HEALTH_CHECK_INTERVAL=15
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_SUCCESS_THRESHOLD=2
HEALTH_CHECK_FAILURE_THRESHOLD=2

# 리소스 제한
MEMORY_REQUEST=512Mi
MEMORY_LIMIT=1Gi
CPU_REQUEST=250m
CPU_LIMIT=500m

# 오토스케일링
HPA_NAME=backend-hpa
HPA_MIN_REPLICAS=2
HPA_MAX_REPLICAS=10
HPA_CPU_THRESHOLD=70
HPA_MEMORY_THRESHOLD=80

# IAM 설정
LOAD_BALANCER_POLICY_NAME=AWSLoadBalancerControllerIAMPolicy
LOAD_BALANCER_SERVICE_ACCOUNT=aws-load-balancer-controller
LOAD_BALANCER_NAMESPACE=kube-system

# 외부 URL
LOAD_BALANCER_POLICY_URL=https://raw.githubusercontent.com/kubernetes-sigs/aws-load-balancer-controller/v2.7.0/docs/install/iam_policy.json
HELM_CHART_REPO=https://aws.github.io/eks-charts

# 기타 설정
ELASTIC_IP_LIMIT=10
EBS_TYPE=gp3
FILESYSTEM_TYPE=ext4

# 데이터베이스 설정 (실제 환경에서는 별도 보안 관리 필요)
DATABASE_URL=postgresql://username:password@host:5432/database_name
JWT_SECRET=your-jwt-secret-minimum-32-characters-required
SESSION_SECRET=your-session-secret-change-this-in-production