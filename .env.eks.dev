# 개발 환경 설정
ENV=development

# AWS 설정
AWS_ACCOUNT_ID=183631338083
AWS_REGION=ap-northeast-2

# EKS 클러스터 설정 (개발)
CLUSTER_NAME=biocom-cluster-dev
NODE_GROUP_NAME=backend-nodes-dev
NODE_INSTANCE_TYPE=t3.medium
NODE_MIN_SIZE=1
NODE_MAX_SIZE=2
NODE_DESIRED_SIZE=1

# ECR 설정
ECR_REPOSITORY=backend-v2

# Helm 설정
HELM_RELEASE_NAME=biocom-api

# 데이터베이스 URL (개발용)
DATABASE_URL=postgresql://biocom:bico0724%21%40%23@43.200.68.96:5432/biocom

# 보안 키 (개발용)
JWT_SECRET=dev-jwt-secret-change-in-production
SESSION_SECRET=dev-session-secret-change-in-production

# API 설정
API_PORT=3000
API_PREFIX=api

# 로깅
LOG_LEVEL=debug

# Rate Limiting
THROTTLE_SHORT_TTL=60
THROTTLE_SHORT_LIMIT=1000
THROTTLE_LONG_TTL=900
THROTTLE_LONG_LIMIT=10000

# Ingress 설정 (개발)
ACM_CERTIFICATE_ARN="arn:aws:acm:ap-northeast-2:183631338083:certificate/146ba478-2d2b-4525-ae3f-7ec62ea6fffe"
INGRESS_HOST="api-dev.biocom.ai.kr"