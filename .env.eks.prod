# 운영 환경 설정
ENV=production

# AWS 설정
AWS_ACCOUNT_ID=183631338083
AWS_REGION=ap-northeast-2

# EKS 클러스터 설정 (운영)
CLUSTER_NAME=biocom-cluster
NODE_GROUP_NAME=backend-nodes
NODE_INSTANCE_TYPE=t3.medium
NODE_MIN_SIZE=2
NODE_MAX_SIZE=4
NODE_DESIRED_SIZE=2

# ECR 설정
ECR_REPOSITORY=backend-v2

# Helm 설정
HELM_RELEASE_NAME=biocom-api

# 데이터베이스 URL (운영용)
DATABASE_URL=postgresql://biocom_be:Biocom123!@database-1.cfnvs5hvtmzm.ap-northeast-2.rds.amazonaws.com:5432/biocom

# 보안 키 (운영용 - 실제 운영시 변경 필요)
JWT_SECRET=prod-jwt-secret-must-be-changed
SESSION_SECRET=prod-session-secret-must-be-changed

# API 설정
API_PORT=3000
API_PREFIX=api

# 로깅
LOG_LEVEL=info

# Rate Limiting
THROTTLE_SHORT_TTL=60
THROTTLE_SHORT_LIMIT=100
THROTTLE_LONG_TTL=900
THROTTLE_LONG_LIMIT=1000