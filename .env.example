# 데이터베이스 연결 설정
# PostgreSQL 데이터베이스 연결 문자열
# 형식: postgresql://[사용자명]:[비밀번호]@[호스트]:[포트]/[데이터베이스명]
DATABASE_URL="postgresql://username:password@localhost:5432/your_database"

# 애플리케이션 설정
# 서버 포트 번호 (기본값: 3000)
PORT=3000

# 환경 구분 (development, production, test)
NODE_ENV=development

# JWT 설정
# JWT 서명에 사용할 시크릿 키 (반드시 변경하세요!)
JWT_SECRET=your-secret-key-change-this-in-production
# JWT 토큰 만료 시간 (예: 24h, 7d, 30d)
JWT_EXPIRES_IN=24h

# 로그 설정
# 로그 저장 경로 (프로젝트 외부 디렉토리 권장)
# 개발 환경 예시
LOG_PATH="/var/log/nestjs-app"
# 운영 환경 예시
# LOG_PATH="/data/logs/nestjs-app"

# 로그 레벨 (error, warn, info, debug, verbose)
LOG_LEVEL=info

# 로그 파일 보관 기간 (일)
LOG_MAX_DAYS=30

# Slack 에러 알림 설정
# Slack Webhook URL (https://api.slack.com/apps 에서 발급)
# 예시: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=""
# Slack 알림 활성화 여부 (true/false)
SLACK_NOTIFICATION_ENABLED=false

# Rate Limiting 설정
# 시간 창 (초)
RATE_LIMIT_TTL=60
# 시간 창 내 최대 요청 수
RATE_LIMIT_LIMIT=10
# 특정 엔드포인트별 설정은 코드에서 개별 설정

# 파일 업로드 설정
# 개발 환경: 프로젝트 내부 디렉토리 사용
# UPLOAD_PATH="./uploads"

# 운영 환경: 외부 디렉토리 사용 (예시)
# UPLOAD_PATH="/var/app/uploads"
# UPLOAD_PATH="/data/uploads"

# 기본값 (설정하지 않으면 프로젝트 내부 ./uploads 사용)
UPLOAD_PATH="./uploads"

# 파일 업로드 추가 설정
# 최대 파일 크기 (바이트, 기본값: 10MB)
MAX_FILE_SIZE=10485760
# 허용된 파일 확장자 (콤마 구분)
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"

# CORS 설정
# 개발 환경: localhost 허용
# CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000"
# 
# 운영 환경: 특정 도메인만 허용
# CORS_ORIGIN="https://example.com,https://www.example.com,https://admin.example.com"
#
# 서브도메인 와일드카드 (정규식 패턴)
# CORS_ORIGIN="/^https:\/\/.*\.example\.com$/"
#
# 모든 도메인 허용 (개발 환경에서만 사용, 운영 환경에서는 절대 사용 금지!)
CORS_ORIGIN="*"
# 자격 증명 포함 여부 (쿠키, 인증 헤더 등)
CORS_CREDENTIALS=true

# 보안 설정
# Bcrypt 해시 라운드 (10-20 권장)
BCRYPT_ROUNDS=10
# 세션 시크릿 (프로덕션 환경에서 필수)
SESSION_SECRET="your-session-secret-change-this-in-production"

# 타임아웃 설정 (밀리초)
# 일반 요청 타임아웃 (기본값: 30초)
REQUEST_TIMEOUT=30000
# 파일 업로드 타임아웃 (기본값: 5분)
UPLOAD_TIMEOUT=300000

# 토스페이먼츠 결제 설정
# 토스페이먼츠 시크릿 키 (상점 관리자 페이지에서 확인)
TOSS_PAYMENTS_SECRET_KEY="your-toss-payments-secret-key"
# 토스페이먼츠 클라이언트 키 (상점 관리자 페이지에서 확인)
TOSS_PAYMENTS_CLIENT_KEY="your-toss-payments-client-key"

# Gemma 3 AI 모델 설정
# Gemma 3 모델 파일 경로 (외부 볼륨 마운트)
# 개발 환경: 로컬 테스트용 경로
# GEMMA_MODEL_PATH="/Users/username/models/gemma-3-8b"
# 
# 운영 환경 (GKE): PersistentVolume 마운트 경로
# GEMMA_MODEL_PATH="/external/models/gemma-3-8b"
#
# 기본값: 외부 볼륨 경로
GEMMA_MODEL_PATH="/external/models/gemma-3"

# AI 분석 설정
# 모델 로딩 시 사용할 디바이스 (cpu, cuda)
GEMMA_DEVICE="cpu"
# 모델 로딩 시 데이터 타입 (fp32, fp16)
GEMMA_DTYPE="fp32"
# AI 분석 타임아웃 (밀리초, 기본값: 30초)
AI_ANALYSIS_TIMEOUT=30000

# NHN KCP 휴대폰 본인인증 설정
# KCP 사이트 코드
KCP_SITE_CODE="ALDXX"
# KCP 웹사이트 아이디
KCP_WEB_SITE_ID="biocom"
# KCP 서비스 인증서 파일 경로 (절대경로 또는 상대경로)
KCP_CERT_INFO="/config/kcp-cert/KCP_AUTH_ALDXX_CERT.pem"
# KCP 개인키 파일 경로 (PKCS#8 포맷)
KCP_PRIVATE_KEY_PATH="/config/kcp-cert/KCP_AUTH_ALDXX_PRIKEY.pem"
# KCP 개인키 비밀번호 (비밀번호가 없으면 생략 가능)
KCP_PRIVATE_KEY_PASSWORD=""
# KCP SMS 발신번호
KCP_CALLBACK_NUMBER="0220390295"

# 플레이오토 물류 API 설정
# 플레이오토 API 베이스 URL
PLAYAUTO_BASE_URL="https://api.plto.com"
# 플레이오토 API 키
PLAYAUTO_API_KEY="your-playauto-api-key"
# 플레이오토 로그인 이메일
PLAYAUTO_EMAIL="your-email@example.com"
# 플레이오토 로그인 비밀번호
PLAYAUTO_PASSWORD="your-password"
# 플레이오토 쇼핑몰 코드
PLAYAUTO_SHOP_CD="your-shop-code"
# 플레이오토 쇼핑몰 아이디
PLAYAUTO_SHOP_ID="your-shop-id"