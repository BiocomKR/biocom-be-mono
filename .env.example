# 데이터베이스 연결 설정
# GCP Cloud SQL 데이터베이스 연결 문자열 (개발 환경)
# AWS RDS는 이제 안씀!
# connection_limit=10 : 연결 풀 크기 제한 (API 5개 + DBeaver/외부툴 5개)
# pool_timeout=10 : 연결 대기 시간 제한
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?connection_limit=10&pool_timeout=30&connect_timeout=10&timezone=Asia/Seoul"

# 애플리케이션 설정
PORT=10805
NODE_ENV=local

# JWT 설정
JWT_SECRET="your-jwt-secret-key-minimum-32-characters"
JWT_ACCESS_TOKEN_EXPIRES_IN=3h
JWT_REFRESH_TOKEN_EXPIRES_IN=180d
JWT_REFRESH_TOKEN_SECRET="your-refresh-token-secret-key"

# 로그 설정
LOG_PATH="./logs"
LOG_LEVEL=info
LOG_MAX_DAYS=30

# Slack 에러 알림 설정
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
SLACK_NOTIFICATION_ENABLED=true

# Rate Limiting 설정
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=10

# 파일 업로드 설정
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"

# CORS 설정
CORS_ORIGIN="*"
CORS_CREDENTIALS=true

# 보안 설정
BCRYPT_ROUNDS=10
SESSION_SECRET="your-session-secret-key"

# 타임아웃 설정
REQUEST_TIMEOUT=30000
UPLOAD_TIMEOUT=300000

# 암호화 설정 (개인정보 보호)
ENCRYPTION_KEY="your-encryption-key-32-characters"

# Rate Limiting 화이트리스트 IP (선택사항)
# RATE_LIMIT_WHITELIST_IPS="127.0.0.1,::1"

# 토스페이먼츠 결제 설정 (테스트 키)
TOSS_PAYMENTS_SECRET_KEY="test_sk_xxxxxxxxxxxx"
TOSS_PAYMENTS_CLIENT_KEY="test_ck_xxxxxxxxxxxx"

# OpenAI GPT API 설정
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
OPENAI_MODEL="gpt-4o"
AI_ANALYSIS_TIMEOUT=30000

# Google Gemini AI 설정 (얼굴 슬리밍 기능)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL="gemini-2.5-flash-image-preview"
FACE_SLIMMING_TIMEOUT=60000

# Google Cloud Storage 설정
GOOGLE_CLOUD_STORAGE_BUCKET="your-gcs-bucket-name"
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
# Service Account Key 파일 경로 (영구적인 인증 방식)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./google-service-account-key.json"
# Service Account Key 인증 (최우선)
GOOGLE_APPLICATION_CREDENTIALS="./google-service-account-key.json"

# Redis 설정 (MQ용)
REDIS_HOST=localhost
REDIS_PORT=6379
